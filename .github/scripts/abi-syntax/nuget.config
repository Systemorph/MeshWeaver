<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The comparer restores ONE package from nuget.org, wherever its directory is fetched: a satellite checks core's
       .github/scripts out inside its own workspace, whose nuget.config (sources, mappings) must not decide this. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
