<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Core" Version="1.60.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.84.2" />
    <PackageVersion Include="System.ClientModel" Version="1.15.0" />
    <!-- 🚨 The ONE GUI package still pinned here, and not because the platform uses it: the
         module-library shelf (tools/MeshWeaver.ModuleLibraries) stages it for the Plugins module
         MeshWeaver.Blazor.Radzen. It leaves with the shelf list — see
         Doc/Architecture/CoreCarriesNoGuiTechnology, "Build tooling that still names a GUI". -->
    <PackageVersion Include="Radzen.Blazor" Version="10.3.2" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- ExcelDataReader (MIT, no dependencies on net8.0+) reads .xls (BIFF2-8), .xlsx and .xlsm row by
         row for the content-indexing text extractor (MeshWeaver.Plugins#3826). Pinned here because a
         satellite declares no PackageVersion of its own. -->
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <!-- MailKit: the typed IMAP/SMTP client behind the "Other email" connection (Plugins'
         Mail module, MeshWeaver.Plugins AI/GettingStartedAndConnections). The verify probe connects,
         authenticates and disconnects through MailKit's ImapClient/SmtpClient only — no hand-rolled
         protocol. Consumed by MeshWeaver.Plugins through $(MeshWeaverRoot); see that repo's AGENTS.md
         "Package versions live in ONE file". -->
    <PackageVersion Include="MailKit" Version="4.18.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <!-- Security overrides for TRANSITIVE packages — not dependencies this code uses. Inert on their
         own (CentralPackageTransitivePinningEnabled is unset); the versionless direct references in
         the root and test Directory.Build.props, PrivateAssets="all", are what lift the graph.
           - System.Security.Cryptography.Pkcs: 8.0.1 via NuGet.Packaging (MeshWeaver.NuGet) and
             10.0.10 via Microsoft.Identity.Web — GHSA-846f-f764-76mx (High),
             GHSA-2fmv-rv2c-59x7 (Moderate); first patched 10.0.13.
           - System.Security.Cryptography.Xml: 10.0.10 via Microsoft.Identity.Web.TokenCache and
             Microsoft.AspNetCore.DataProtection — GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj,
             GHSA-r955-8q5j-3h83 (all High); first patched 10.0.13.
         Remove each (here AND both Directory.Build.props references) once every upstream depends
         on a patched version — and MeshWeaver.Plugins references them versionless, so a removal
         needs a Satellite-pins: declaration. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <!-- The TOTP rung's enrolment QR code — a dependency-free QR encoder that writes SVG. -->
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageVersion Include="Microsoft.Orleans.Core.Abstractions" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Runtime" Version="10.4.0" />
    <!-- 1.17.0 is where the agent-store abstractions MeshWeaver.AI.Stores implements over mesh
         nodes (AgentFileStore, AgentSkillsSource) reached their current shape. Kept in lockstep —
         these three ship together and mixing versions breaks their shared abstractions. -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.10" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Orleans.Core" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
    <!-- Orleans test cluster — a src pin because MeshWeaver.Hosting.Orleans.TestBase ships it. -->
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.4.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="NuGet.Resolver" Version="7.9.0" />
    <PackageVersion Include="NuGet.DependencyResolver.Core" Version="7.9.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
    <!-- OpenTelemetry.Api pinned to override transitive 1.13.1 / 1.15.2 (CVE-2026-40894 / GHSA-g94r-2vxg-569j) -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- The memex test container package (src/MeshWeaver.Testcontainers): a real memex from the
         platform build as a test substrate, the way Testcontainers.PostgreSql gives a test a real
         Postgres. Same version as the test tree pins. -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" /> <!-- High GHSA-q939-rpr3-3284; transitive via Testcontainers, direct-ref override in test/Directory.Build.props -->
    <!-- 🚨 THESE TWO ARE ONE FAMILY AND MUST MOVE TOGETHER — they were SPLIT, and the split was
         invisible because both halves were green.

         `Microsoft.Reactive.Testing` 7.0.0 depends on `System.Reactive >= 7.0.0`, and with
         CentralPackageTransitivePinningEnabled unset the highest wins. So while this line read
         6.1.0, every `src/` project resolved System.Reactive 6.1.0 while the eight test projects
         that reference the testing package resolved 7.0.0 — measured, not inferred. The suite that
         gates the platform was exercising a DIFFERENT Rx major from the one the portals shipped,
         which is the one skew a test suite must never have. Moving this line to 7.0.0 closes it.

         Rx 7 is a PACKAGING release, not a semantic one. A MetadataLoadContext diff of the shipped
         assemblies removes ZERO public API and adds 16 `ObservableEx.CombineLatest`/`Zip` overloads
         for 9..16 sources on a type nothing here references. `System.Reactive.Linq.Observable` is
         byte-identical at 656 members, as are every Subject, every Disposable and every scheduler.
         Upstream enables package validation with a 6.1.0 baseline, and not one of its 57
         suppressions is a behavioural or core-API break — they are all `ref`-vs-`lib` UI omissions.
         The single compile-surface change is a nullability annotation: `OfType<T>(this
         IObservable<object>)` became `IObservable<object?>`, which widens what is accepted.

         What DID move is the Windows UI surface: `DispatcherScheduler`, `ControlScheduler`,
         `CoreDispatcherScheduler` and friends are gone from the REFERENCE assemblies (still in
         `lib`, so this is source-breaking, not binary-breaking) and now live in the separate
         `System.Reactive.Wpf`, `System.Reactive.Windows.Forms`, `System.Reactive.WindowsRuntime`
         and `System.Reactive.Uwp` packages.

         🚨 The package also ships a new Roslyn analyzer (analyzers/dotnet/System.Reactive.Analyzers.dll)
         emitting RXNET0001-RXNET0004 at Warning, which `-warnaserror` would promote to errors — but
         it is INERT here, and that is NOT the same as passing. csc never loads it: the assembly
         appears only in project.assets.json's `libraries` file manifest, never in a `targets` entry,
         and `dotnet build <proj> -getItem:Analyzer` returns ZERO Rx analyzer entries while still
         returning the .NET analyzers (so the instrument discriminates). It sits directly under
         `analyzers/dotnet/` with no language subfolder, which is not where NuGet selects a C#
         analyzer from. So a clean -warnaserror build is NOT evidence about these four rules. The
         evidence is a source sweep instead: this repo declares no *-windows* target framework at
         all and references none of the Windows UI types the rules fire on (0 hits against a
         positive control of 581 `.cs` files under src/ and test/ that DO contain `IObservable`),
         and no pre-6.x Rx facade package. If upstream ever fixes the analyzer's path, these rules
         go live for every consumer at once.

         Assembly identity: the public key token is unchanged (94bc3704cddfc263); only
         AssemblyVersion moves, 6.1.0.0 -> 7.0.0.0.

         🚨 This entry is also MeshWeaver.Plugins' version source (its own pin file carries only
         the GUI packages the platform does not use): MeshWeaver.Blazor, Blazor.Views, InstanceSync and
         LogWatcher all reference System.Reactive versionless. Details and the crossing ledger:
         Doc/Architecture/DependencyMajorUpgrades. -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Reactive.Testing" Version="7.0.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Roslynator.CodeFixes" Version="4.15.0" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Roslynator.Refactorings" Version="4.15.0" />
    <!-- 🚨 ONE Orleans family, one version. These four are referenced only by MeshWeaver.Plugins'
         hosts (this file is its version source), so no core project shows them to Dependabot and a
         grouped Orleans bump leaves them behind. A split family ships Microsoft.Orleans.Reminders at
         the OLD version in the portal image; the image-derived central list then pins it there, and
         every Plugins test project on Microsoft.Orleans.TestingHost fails restore with NU1109
         (TestingHost needs Reminders at the family version). Move them with the rest of the family. -->
    <PackageVersion Include="Microsoft.Orleans.Clustering.AzureStorage" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.AdoNet" Version="10.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.runner.console" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 🚨 PINS THE SATELLITE REPOS CONSUME. This file is the ONE source of package versions for
         the plugin repos too — MeshWeaver.Plugins et al. declare NO PackageVersion of their own and
         resolve every version from here through $(MeshWeaverRoot). So "no project in THIS repo
         references it" does not mean a pin is dead: these fourteen belong to modules that LEFT the
         platform (the AI providers, Mail/Graph, the agent SDKs) and are referenced from the plugin
         repos alone. Pruning them as orphans (2026-08-21) turned nine module-bundle jobs red on the
         plugins trunk with a build failure that named only the package. Audit across the satellites
         before removing anything here. -->
    <PackageVersion Include="Azure.AI.Agents.Persistent" Version="1.2.0-beta.10" />
    <PackageVersion Include="Azure.AI.Inference" Version="1.0.0-beta.5" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="ClaudeAgentSdk" Version="0.2.1" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.8" />
    <PackageVersion Include="Microsoft.Agents.AI.AzureAI" Version="1.0.0-rc5" />
    <PackageVersion Include="Microsoft.Agents.AI.AzureAI.Persistent" Version="1.4.0-preview.260505.1" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.17.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.AzureAIInference" Version="10.0.0-preview.1.25559.3" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Graph" Version="6.2.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
  </ItemGroup>
</Project>
