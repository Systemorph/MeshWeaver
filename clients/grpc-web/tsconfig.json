{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // See clients/react/tsconfig.json — TypeScript 7 stopped auto-including @types, so the Node
    // globals restContract/wireContract read had to be named explicitly.
    "types": ["node"]
  },
  "include": ["src"]
}
