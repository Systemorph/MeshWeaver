{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // No `baseUrl`: TypeScript 7 removed the option. The aliases below are already written
    // relative to this file, which is exactly how TS resolves `paths` without a baseUrl, so
    // dropping it changes nothing about what they point at.
    "paths": {
      "@meshweaver/react/core": ["../react/src/core.ts"],
      "@meshweaver/react": ["../react/src/index.tsx"],
      "@meshweaver/client-web": ["../grpc-web/src/index.ts"]
    }
  },
  "include": ["src"]
}
