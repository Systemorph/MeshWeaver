{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // TypeScript 7 no longer pulls every @types package in automatically, so the Node globals the
    // cross-tree guard tests read (`node:fs`, `node:path`, `process` in ciTrigger / localize /
    // parity) stopped resolving and `tsc --noEmit` failed with TS2591. Naming `node` restores them.
    "types": ["node"]
  },
  "include": ["src"]
}
