#!/usr/bin/env bash
# hosting-artifact-store-bind --namespace <ns> --claim <pvc> --source-namespace <owner ns> --source-claim <owner pvc>
#
# Bind the environment's SHARED ARTIFACT STORE into one consumer namespace, READ-ONLY
# (Doc/Architecture/SharedArtifactStore). The store is ONE Azure Files share the control instance's
# record declares and its chart creates (the owner's claim, <owner ns>/<owner pvc>). A PVC is
# namespaced, so every portal namespace that reads the store needs its own claim on that same share:
# a STATIC PersistentVolume pointing at the owner's share, and a claim in <ns> bound to it — the shape
# the CI platform volume has run since 2026-09-12 (Systemorph/Memex
# deployments/aks/ci-runners/ci-platform-runner-volumes.yaml).
#
# Output contract (the ::hosting:: lines the mesh reads):
#   artifact_store_share=<account>/<share>   the share the binding reads, read off the owner's PV
#   artifact_store_bound=<ns>/<pvc>          the consumer claim, Bound, read back
#   artifact_store_created=0|1               whether this run created the PV/PVC (0 = already bound, verified)
#
# 🚨 THE SHARE IS READ OFF THE OWNER'S BOUND VOLUME, NEVER TYPED INTO A RECORD. A record that named an
# account and share could point a portal at any share in the subscription; this command derives both
# from the volume the owner's claim is bound to, and refuses an owner claim that is not Bound, not on
# the Azure Files CSI driver, or whose handle it cannot read.
#
# 🚨 READ-ONLY END TO END: accessMode ReadOnlyMany, csi.readOnly, the claim ReadOnlyMany (and the record
# mounts the volume readOnly: true — DeploymentPortalConfig.ArtifactStoreProblems refuses a writable
# consumer). The store has one owner and one producer; a portal that could write it is a second writer
# nobody sweeps.
#
# 🚨 IT NEVER DELETES AND NEVER REBINDS. The PV's reclaim policy is Retain, so removing a consumer's
# binding can never delete the share. A PV or claim of the binding's name that already exists is
# VERIFIED — same share, read-only — and a mismatch is a refusal naming both, never an overwrite: a
# claim pointing elsewhere is a human's question.
#
# Every volumeHandle is distinct on purpose (its 5th segment is the PV name): the kubelet stages a CSI
# volume under a hash of the handle, and two PVs with one handle on one node collide.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-artifact-store-bind"

namespace="" claim="" source_namespace="" source_claim=""
attempts="${HOSTING_BIND_ATTEMPTS:-30}" interval="${HOSTING_BIND_INTERVAL:-5}"
# A value flag with no value would make `shift 2` fail without shifting — an endless loop.
needs_value() { [ $# -ge 2 ] || hosting::die "$1 needs a value"; }
while [ $# -gt 0 ]; do
  case "$1" in
    --namespace)        needs_value "$@"; namespace="$2";        shift 2 ;;
    --claim)            needs_value "$@"; claim="$2";            shift 2 ;;
    --source-namespace) needs_value "$@"; source_namespace="$2"; shift 2 ;;
    --source-claim)     needs_value "$@"; source_claim="$2";     shift 2 ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done

hosting::need_flag namespace "$namespace"
hosting::need_flag claim "$claim"
hosting::need_flag source-namespace "$source_namespace"
hosting::need_flag source-claim "$source_claim"
hosting::safe_name namespace "$namespace"
hosting::safe_name claim "$claim"
hosting::safe_name source-namespace "$source_namespace"
hosting::safe_name source-claim "$source_claim"
[[ "$attempts" =~ ^[0-9]+$ && "$interval" =~ ^[0-9]+$ ]] || hosting::die "a numeric setting is not a whole number — refusing"
[ "$namespace" != "$source_namespace" ] \
  || hosting::die "the consumer namespace IS the owner's namespace (${namespace}) — the owner mounts its own claim ${source_claim} writable; it needs no read-only binding"
command -v jq >/dev/null 2>&1 || hosting::die "jq is not installed in this image — the volumes are JSON and cannot be read without it"

pv_name="artifact-store-${namespace}"

hosting::step "Bind the shared artifact store"

# ── the owner's claim and the share behind it ───────────────────────────────────────────────────
hosting::probe output kubectl -n "$source_namespace" get pvc "$source_claim" -o json
case $? in
  2) hosting::die_refused "PersistentVolumeClaim ${source_claim} in ${source_namespace}, the owner's artifact store" ;;
  1) hosting::die "the owner's artifact store ${source_namespace}/${source_claim} does not exist (${HOSTING_PROBE_ERR:-nothing listed}). It is created by the OWNER's record (the control instance's volumes[], create: true) on its next roll or Reconcile — bind consumers only after it is Bound." ;;
esac
src_phase="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.status.phase // ""')"
src_volume="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.spec.volumeName // ""')"
[ "$src_phase" = "Bound" ] && [ -n "$src_volume" ] \
  || hosting::die "the owner's artifact store ${source_namespace}/${source_claim} is '${src_phase:-<no phase>}', not Bound — there is no share behind it to bind yet"
hosting::safe_name source-volume "$src_volume"

hosting::probe output kubectl get pv "$src_volume" -o json
case $? in
  2) hosting::die_refused "PersistentVolume ${src_volume}, behind the owner's artifact store" ;;
  1) hosting::die "cannot read PersistentVolume ${src_volume} behind ${source_namespace}/${source_claim} (${HOSTING_PROBE_ERR:-nothing listed})" ;;
esac
src_pv="$HOSTING_PROBE_OUT"
driver="$(printf '%s' "$src_pv" | jq -r '.spec.csi.driver // ""')"
handle="$(printf '%s' "$src_pv" | jq -r '.spec.csi.volumeHandle // ""')"
capacity="$(printf '%s' "$src_pv" | jq -r '.spec.capacity.storage // ""')"
[ "$driver" = "file.csi.azure.com" ] \
  || hosting::die "the owner's store ${src_volume} is on driver '${driver:-<none>}', not the Azure Files CSI driver — a read-only static binding of it is not something this command knows how to make"
# rg#account#share#…#…#secretnamespace — what the azurefile provisioner writes.
IFS='#' read -r h_rg h_account h_share _ _ h_secretns <<< "$handle"
[[ "$h_rg" =~ ^[A-Za-z0-9._()-]+$ && "$h_account" =~ ^[a-z0-9]{3,24}$ && "$h_share" =~ ^[a-z0-9][a-z0-9-]{1,62}$ ]] \
  || hosting::die "cannot read the owner's share from volumeHandle '${handle}' (expected <resource group>#<account>#<share>#…) — refusing to bind a share it could not name"
attr_secretns="$(printf '%s' "$src_pv" | jq -r '.spec.csi.volumeAttributes.secretnamespace // ""')"
secretns="${h_secretns:-${attr_secretns:-$source_namespace}}"
hosting::safe_name secret-namespace "$secretns"
[ -n "$capacity" ] || hosting::die "the owner's store ${src_volume} states no capacity — refusing to bind a volume the API did not size"
share="${h_account}/${h_share}"
hosting::log "owner     ${source_namespace}/${source_claim} → ${src_volume} (share ${share}, ${capacity})"
hosting::log "consumer  ${namespace}/${claim} via PersistentVolume ${pv_name}, READ-ONLY"

# The key Secret the node stages the share with: the OWNER's PV's own nodeStageSecretRef when it names
# one (a share provisioned with a custom Secret), else the provisioner's convention in its namespace.
src_secret_name="$(printf '%s' "$src_pv" | jq -r '.spec.csi.nodeStageSecretRef.name // ""')"
src_secret_ns="$(printf '%s' "$src_pv" | jq -r '.spec.csi.nodeStageSecretRef.namespace // ""')"
secret_name="${src_secret_name:-azure-storage-account-${h_account}-secret}"
secretns="${src_secret_ns:-$secretns}"
hosting::safe_name secret "$secret_name"
hosting::safe_name secret-namespace "$secretns"
new_handle="${h_rg}#${h_account}#${h_share}##${pv_name}#${secretns}"

# ── an existing binding is VERIFIED, never overwritten ──────────────────────────────────────────
created=0
hosting::probe output kubectl get pv "$pv_name" -o json
case $? in
  2) hosting::die_refused "PersistentVolume ${pv_name}" ;;
  0)
    have_share="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '"\(.spec.csi.volumeAttributes.storageAccount // "")/\(.spec.csi.volumeAttributes.shareName // "")"')"
    have_ro="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.spec.csi.readOnly // false')"
    have_ref="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '"\(.spec.claimRef.namespace // "")/\(.spec.claimRef.name // "")"')"
    have_policy="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.spec.persistentVolumeReclaimPolicy // ""')"
    have_label="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.metadata.labels["meshweaver.io/purpose"] // ""')"
    [ "$have_share" = "$share" ] \
      || hosting::die "PersistentVolume ${pv_name} already exists and points at ${have_share}, not the owner's ${share} — refusing to rebind it. Whether the old binding is still read is a human's question; remove it deliberately, then re-run."
    [ "$have_ro" = "true" ] \
      || hosting::die "PersistentVolume ${pv_name} already exists and is NOT read-only — a consumer binding that can write the store is a second writer; remove it deliberately, then re-run"
    [ "$have_ref" = "${namespace}/${claim}" ] \
      || hosting::die "PersistentVolume ${pv_name} already exists for claim ${have_ref}, not ${namespace}/${claim} — refusing to rebind it"
    # 🚨 A binding whose reclaim policy is not Retain would hand the SHARED share to the provisioner's
    # delete the moment its claim goes, and one without the binding label is invisible to the teardown
    # guard in hosting-pv-purge. Neither is accepted as "already bound".
    [ "$have_policy" = "Retain" ] \
      || hosting::die "PersistentVolume ${pv_name} already exists with reclaim policy '${have_policy:-unset}', not Retain — removing its claim could delete the shared store; remove it deliberately, then re-run"
    [ "$have_label" = "artifact-store" ] \
      || hosting::die "PersistentVolume ${pv_name} already exists without the label meshweaver.io/purpose=artifact-store — the teardown guard would not recognise it as a binding; remove it deliberately, then re-run"
    hosting::log "PersistentVolume ${pv_name} exists — same share, read-only, for ${namespace}/${claim}"
    ;;
  1)
    pv_manifest="$(jq -n --arg name "$pv_name" --arg capacity "$capacity" --arg ns "$namespace" --arg claim "$claim" \
      --arg handle "$new_handle" --arg rg "$h_rg" --arg account "$h_account" --arg share "$h_share" \
      --arg secretns "$secretns" --arg secret "$secret_name" --arg ons "$source_namespace" --arg oclaim "$source_claim" '
      { apiVersion: "v1", kind: "PersistentVolume",
        metadata: { name: $name,
          labels: { "app.kubernetes.io/managed-by": "hosting-operator", "meshweaver.io/purpose": "artifact-store" },
          annotations: { "meshweaver.io/artifact-store-owner": "\($ons)/\($oclaim)" } },
        spec: { capacity: { storage: $capacity }, accessModes: ["ReadOnlyMany"],
          persistentVolumeReclaimPolicy: "Retain", storageClassName: "",
          claimRef: { namespace: $ns, name: $claim },
          mountOptions: ["dir_mode=0755", "file_mode=0644", "uid=1654", "gid=1654", "mfsymlinks", "cache=strict", "actimeo=30", "nobrl", "nosharesock"],
          csi: { driver: "file.csi.azure.com", readOnly: true, volumeHandle: $handle,
            volumeAttributes: { resourceGroup: $rg, storageAccount: $account, shareName: $share, secretnamespace: $secretns },
            nodeStageSecretRef: { name: $secret, namespace: $secretns } } } }')"
    hosting::do kubectl apply -f - <<< "$pv_manifest" >&2 \
      || hosting::die "could not create PersistentVolume ${pv_name}"
    created=1
    ;;
esac

hosting::probe output kubectl -n "$namespace" get pvc "$claim" -o json
case $? in
  2) hosting::die_refused "PersistentVolumeClaim ${claim} in ${namespace}" ;;
  0)
    have_volume="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.spec.volumeName // ""')"
    [ "$have_volume" = "$pv_name" ] \
      || hosting::die "PersistentVolumeClaim ${namespace}/${claim} already exists and is bound to '${have_volume:-nothing}', not ${pv_name} — refusing to replace a claim a portal may be mounting. Choose another claim name on the record, or remove it deliberately."
    ;;
  1)
    pvc_manifest="$(jq -n --arg ns "$namespace" --arg claim "$claim" --arg pv "$pv_name" --arg capacity "$capacity" '
      { apiVersion: "v1", kind: "PersistentVolumeClaim",
        metadata: { name: $claim, namespace: $ns,
          labels: { "app.kubernetes.io/managed-by": "hosting-operator", "meshweaver.io/purpose": "artifact-store" } },
        spec: { accessModes: ["ReadOnlyMany"], storageClassName: "", volumeName: $pv,
          resources: { requests: { storage: $capacity } } } }')"
    hosting::do kubectl apply -f - <<< "$pvc_manifest" >&2 \
      || hosting::die "could not create PersistentVolumeClaim ${namespace}/${claim}"
    created=1
    ;;
esac

if hosting::dry; then
  hosting::say artifact_store_share "$share"
  hosting::say artifact_store_created 0
  hosting::say artifact_store_bound dry-run
  exit 0
fi

# ── read back: the claim must be Bound to THIS volume ──────────────────────────────────────────
n=0
while :; do
  hosting::probe output kubectl -n "$namespace" get pvc "$claim" -o json
  case $? in
    2) hosting::die_refused "PersistentVolumeClaim ${claim} in ${namespace}" ;;
    0)
      phase="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.status.phase // ""')"
      bound_to="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '.spec.volumeName // ""')"
      if [ "$phase" = "Bound" ] && [ "$bound_to" = "$pv_name" ]; then break; fi
      ;;
  esac
  n=$((n + 1))
  [ "$n" -lt "$attempts" ] \
    || hosting::die "PersistentVolumeClaim ${namespace}/${claim} is '${phase:-unread}' after ${n} reads — it did not bind to ${pv_name}"
  sleep "$interval"
done

hosting::log "bound     ${namespace}/${claim} → ${pv_name} → ${share} (read-only)"
hosting::say artifact_store_share "$share"
hosting::say artifact_store_created "$created"
hosting::say artifact_store_bound "${namespace}/${claim}"
