#!/usr/bin/env bash
# hosting-db-release --namespace <ns> --release <name> --database <db>
#                    [--owner <role>] [--instances <n>] [--size <NNGi>] [--storage-class <name>]
#
# Install (or upgrade) ONE instance's database as its OWN Helm release — the memex-db chart shipped
# beside the portal chart in this image (/opt/hosting/chart-db): a CloudNativePG Cluster, primary +
# standby across zones on the `db` node pool. Then WAIT until the Cluster reports Ready and its
# credentials Secret `<release>-app` exists, because the portal release's pods read that Secret at
# start and a missing one keeps them in CreateContainerConfigError.
#
# 🚨 The PLATFORM LAYER is checked first and never installed here: the CloudNativePG CRD, the
# StorageClass and a node labelled workload=db. Each is cluster-wide and belongs to no instance
# (deploy/aks/manifests/db-platform/README.md). A missing one refuses the step BY NAME with nothing
# created, rather than leaving a Cluster Pending forever on a pool that does not exist.
#
# Idempotent: an existing release is upgraded in place (helm), an existing Cluster keeps its data.
# Never prints a credential: the password is generated by CloudNativePG inside the cluster and only
# its PRESENCE is checked here.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-db-release"

namespace="" release="" database="" owner="memex" instances="2" size="32Gi"
storage_class="memex-db-premiumv2" timeout="${HOSTING_DB_TIMEOUT:-900}"
chart="${HOSTING_DB_CHART:-/opt/hosting/chart-db}"
while [ $# -gt 0 ]; do
  case "$1" in
    --namespace)     namespace="${2:-}";     shift 2 ;;
    --release)       release="${2:-}";       shift 2 ;;
    --database)      database="${2:-}";      shift 2 ;;
    --owner)         owner="${2:-}";         shift 2 ;;
    --instances)     instances="${2:-}";     shift 2 ;;
    --size)          size="${2:-}";          shift 2 ;;
    --storage-class) storage_class="${2:-}"; shift 2 ;;
    --timeout)       timeout="${2:-}";       shift 2 ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done

hosting::need_flag namespace "$namespace"
hosting::need_flag release "$release"
hosting::need_flag database "$database"
hosting::safe_name namespace "$namespace"
hosting::safe_name release "$release"
hosting::safe_name storage-class "$storage_class"
[[ "$database" =~ ^[a-z_][a-z0-9_]{0,62}$ ]] \
  || hosting::die "database '${database}' is not a plain lower-case PostgreSQL identifier — refusing to bootstrap it"
[[ "$owner" =~ ^[a-z_][a-z0-9_]{0,62}$ ]] \
  || hosting::die "owner '${owner}' is not a plain lower-case PostgreSQL role name"
[[ "$instances" =~ ^[1-9]$ ]] || hosting::die "instances '${instances}' is not a number from 1 to 9"
[[ "$size" =~ ^[1-9][0-9]*(Gi|Ti)$ ]] || hosting::die "size '${size}' is not a quantity like 32Gi"
[[ "$timeout" =~ ^[1-9][0-9]*$ ]] || hosting::die "timeout '${timeout}' is not a number of seconds"
[ -d "$chart" ] || hosting::die "the database chart is not at ${chart} — this operator image predates deploy/helm-db; move the record's operator.image to one that ships it"

# ── the platform layer: present, or refuse by name ───────────────────────────────────────────────
missing=()
kubectl get crd clusters.postgresql.cnpg.io >/dev/null 2>&1 \
  || missing+=("the CloudNativePG operator (CRD clusters.postgresql.cnpg.io)")
kubectl get storageclass "$storage_class" >/dev/null 2>&1 \
  || missing+=("the StorageClass ${storage_class}")
[ -n "$(kubectl get nodes -l workload=db -o name 2>/dev/null)" ] \
  || missing+=("a node pool labelled workload=db (the db pool)")
if [ "${#missing[@]}" -gt 0 ]; then
  hosting::die "this cluster lacks the database platform layer: $(IFS=';'; echo "${missing[*]}"). Nothing was created. Install it once (MeshWeaver deploy/aks/manifests/db-platform/README.md — on the Systemorph estate through the approved lane) and re-request the action; the plan is idempotent from the top."
fi

zones="$(kubectl get nodes -l workload=db -o jsonpath='{range .items[*]}{.metadata.labels.topology\.kubernetes\.io/zone}{"\n"}{end}' 2>/dev/null | sort -u | grep -c . || true)"
if [ "${zones:-0}" -lt "$instances" ]; then
  hosting::die "the db pool spans ${zones:-0} zone(s) but the database asks for ${instances} instances, each in its own zone — they could never all schedule. Add a zone to the pool or lower the record's instances."
fi

args=(upgrade "$release" "$chart" --install --namespace "$namespace" --create-namespace
      --set-string "database=${database}" --set-string "owner=${owner}"
      --set "instances=${instances}" --set-string "storage.size=${size}"
      --set-string "storage.storageClass=${storage_class}")
hosting::log "database  ${database} (owner ${owner}) as release ${release} in ${namespace}: ${instances} instance(s), ${size} on ${storage_class}"
if hosting::dry; then
  echo "  DRY-RUN would run: helm ${args[*]}"
  echo "  DRY-RUN would wait up to ${timeout}s for cluster.postgresql.cnpg.io/${release} Ready and Secret ${release}-app"
  hosting::say db_release dry-run
  exit 0
fi

echo "  + helm ${args[*]}"
helm "${args[@]}" || hosting::die "helm could not install the database release ${release} — read the error above; nothing else in the plan has run past this step"

hosting::log "waiting up to ${timeout}s for the Cluster ${release} to report Ready"
kubectl -n "$namespace" wait "cluster.postgresql.cnpg.io/${release}" --for=condition=Ready --timeout="${timeout}s" \
  || hosting::die "the Cluster ${release} did not become Ready within ${timeout}s. Read 'kubectl -n ${namespace} describe cluster ${release}' and its pods' events (a Pending pod usually means the db pool, its taint or the StorageClass). The release is installed; re-requesting the action resumes the wait."

pw_len="$(kubectl -n "$namespace" get secret "${release}-app" -o jsonpath='{.data.password}' 2>/dev/null | wc -c | tr -d ' ')"
[ "${pw_len:-0}" -gt 0 ] \
  || hosting::die "the Cluster ${release} is Ready but its credentials Secret ${release}-app carries no password — the portal would start with none. Read the operator's log in cnpg-system."

hosting::log "ready     ${release}-rw.${namespace}.svc:5432, credentials in Secret ${release}-app (password present, not shown)"
hosting::say db_release "$release"
hosting::say db_service "${release}-rw"
