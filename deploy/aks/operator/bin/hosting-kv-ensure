#!/usr/bin/env bash
# hosting-kv-ensure --vault <name> --prefix <prefix> --namespace <ns>
#                   [--db-connection <vault object> --db-host <fqdn> --db-port <n> --db-user <user>
#                    --db-name <database> --db-password-secret <vault object>]
#                   [--skip-registry-key | --registry-key-vault <name> --registry-key-object <object>]
#                   [--values-half <release> [--vault-keys K1,K2,…]]
#
# Make sure the per-instance Key Vault secrets EXIST, and mint the ones only this step can mint.
#
# The DATABASE CONNECTION STRING (MeshWeaver.Plugins#1721). The Provision creates the database one
# step earlier, but the string the portal reads — the object the record maps
# `ConnectionStrings__memex` from — used to be written by hand (runbook step 3), and a declared
# vault object the vault does not hold fails the WHOLE CSI mount: every pod in ContainerCreating
# (Memex#202). With --db-connection the object is COMPOSED here from the record's typed fields and
# the server's admin password, which this identity reads from the vault (--db-password-secret) and
# never prints: the string goes into a mode-600 temporary and reaches az through --file, never an
# argument. An existing object is KEPT, exactly like the master key — a hand-written string with a
# different user or a rotated password is not this step's to replace.
#
# 🚨 IT NEVER OVERWRITES AN EXISTING SECRET, and the master key is why. `Ai-KeyProtection-MasterKey`
# is the at-rest envelope key: every `enc:` provider key in that instance's database is sealed with
# it. Regenerating it does not "reset" anything — it makes every stored credential permanently
# unreadable, with no error at the time and a broken AI stack later. So an existing secret is left
# exactly as it is, and only an ABSENT one is created. That also makes a re-provision safe, which
# is what lets the mesh treat provisioning as idempotent.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-kv-ensure"

vault="" prefix="" namespace=""
db_connection="" db_host="" db_port="" db_user="" db_name="" db_password_secret=""
skip_registry_key=false registry_key_vault="" registry_key_object=""
values_half="" vault_keys=""
while [ $# -gt 0 ]; do
  case "$1" in
    --vault)              vault="${2:-}";              shift 2 ;;
    --prefix)             prefix="${2:-}";             shift 2 ;;
    --namespace)          namespace="${2:-}";          shift 2 ;;
    --db-connection)      db_connection="${2:-}";      shift 2 ;;
    --db-host)            db_host="${2:-}";            shift 2 ;;
    --db-port)            db_port="${2:-}";            shift 2 ;;
    --db-user)            db_user="${2:-}";            shift 2 ;;
    --db-name)            db_name="${2:-}";            shift 2 ;;
    --db-password-secret) db_password_secret="${2:-}"; shift 2 ;;
    --skip-registry-key)   skip_registry_key=true;       shift ;;
    --registry-key-vault)  registry_key_vault="${2:-}"; shift 2 ;;
    --registry-key-object) registry_key_object="${2:-}"; shift 2 ;;
    --values-half)         values_half="${2:-}";         shift 2 ;;
    --vault-keys)          vault_keys="${2:-}";          shift 2 ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done

hosting::need_flag vault "$vault"
hosting::need_flag namespace "$namespace"
hosting::safe_name vault "$vault"
hosting::safe_name namespace "$namespace"
[ -z "$prefix" ] || hosting::safe_name prefix "$prefix"
# The connection-string inputs are validated up front, whether or not the object turns out to
# exist: every one of them is interpolated — into a vault object name, a host, a connection string
# the portal parses — and a value that is not a plain token refuses BEFORE the vault is read.
[ -z "$db_connection" ] || hosting::safe_name db-connection "$db_connection"
[ -z "$db_host" ] || hosting::safe_host db-host "$db_host"
[ -z "$db_user" ] || hosting::safe_name db-user "$db_user"
[ -z "$db_name" ] || hosting::safe_name db-name "$db_name"
[ -z "$db_password_secret" ] || hosting::safe_name db-password-secret "$db_password_secret"
[ -z "$registry_key_vault" ] || hosting::safe_name registry-key-vault "$registry_key_vault"
[ -z "$registry_key_object" ] || hosting::safe_name registry-key-object "$registry_key_object"
[ -z "$values_half" ] || hosting::safe_name values-half "$values_half"
if [ -n "$vault_keys" ]; then
  [ -n "$values_half" ] || hosting::die "--vault-keys declares the keys of a values half, but no --values-half <release> was given"
  [[ "$vault_keys" =~ ^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$ ]] \
    || hosting::die "--vault-keys '${vault_keys}' is not a comma-separated list of env-key names"
fi
if [ "$skip_registry_key" = true ] && { [ -n "$registry_key_vault" ] || [ -n "$registry_key_object" ]; }; then
  hosting::die "--skip-registry-key cannot be combined with --registry-key-vault or --registry-key-object"
fi
if { [ -n "$registry_key_vault" ] && [ -z "$registry_key_object" ]; } \
    || { [ -z "$registry_key_vault" ] && [ -n "$registry_key_object" ]; }; then
  hosting::die "--registry-key-vault and --registry-key-object must be supplied together"
fi
if [ -n "$db_port" ] && ! [[ "$db_port" =~ ^[0-9]{1,5}$ ]]; then
  hosting::die "db-port '${db_port}' is not a port number — refusing to compose a connection string from it"
fi

# The per-instance secrets an instance cannot boot without. Names are the vault's, dash-separated;
# the SecretProviderClass maps each onto its config key (see secretproviderclass.reference.yaml in
# the config repo). `generate` secrets are minted here because nothing else can; `require` secrets
# must be supplied out-of-band and their absence is a REFUSAL, not a silent gap. The registry key is
# required by default for direct callers; a deployment plan names the exact mapped object when used,
# or explicitly skips it when the record has no registry-token consumer.
#
#   name                          how
GENERATED="Ai-KeyProtection-MasterKey"

created=0 kept=0 missing=()

kv_exists_in_vault() {
  local target_vault="$1" name="$2"
  hosting::kv_exists "$target_vault" "$name"; local rc=$?
  [ "$rc" -eq 2 ] && hosting::die "could not LIST vault ${target_vault} to see whether ${name} exists — refusing to read a refused listing as 'absent'. The identity needs \`list\` on ${target_vault}."
  return "$rc"
}
kv_exists() { kv_exists_in_vault "$vault" "$1"; }

for suffix in $GENERATED; do
  name="${prefix}${suffix}"
  if kv_exists "$name"; then
    hosting::log "keep    ${name} (exists — NEVER regenerated: it seals this instance's stored enc: values)"
    kept=$((kept + 1))
    continue
  fi
  hosting::log "create  ${name} (256-bit, base64)"
  if hosting::dry; then created=$((created + 1)); continue; fi
  # /dev/urandom, not az's generator: the value never leaves this process except into the vault.
  value="$(head -c 32 /dev/urandom | base64 | tr -d '\n')"
  az keyvault secret set --vault-name "$vault" --name "$name" --value "$value" --output none \
    || hosting::die "could not create ${name} in vault ${vault}"
  unset value
  created=$((created + 1))
done

if [ "$skip_registry_key" != true ]; then
  required_registry_vault="${registry_key_vault:-$vault}"
  required_registry_object="${registry_key_object:-${prefix}PluginCatalog-RegistryToken}"
  if kv_exists_in_vault "$required_registry_vault" "$required_registry_object"; then
    hosting::log "found   ${required_registry_object} in ${required_registry_vault}"
    kept=$((kept + 1))
  else
    if [ "$required_registry_vault" = "$vault" ]; then
      missing+=("$required_registry_object")
    else
      missing+=("${required_registry_vault}/${required_registry_object}")
    fi
  fi
fi

if [ ${#missing[@]} -gt 0 ]; then
  hosting::die "required Key Vault object(s) are missing: $(IFS=,; echo "${missing[*]}"). These are ISSUED, not generated — a registry consumer key comes from the registry installation (see the plugin registry docs), and minting a random value here would produce an instance that boots, registers nothing, and shows an empty Store with no error. Create the named object in its vault, then re-request the action."
fi

# ── the database connection string ────────────────────────────────────────────────────────────
# Only when the plan names the object (--db-connection). KEPT when it exists — never rewritten, not
# even when the record's fields would compose a different string: an operator who changed the
# user or rotated the password by hand did so on purpose, and the master-key rule applies. Composed
# only when ABSENT, from the record's fields and the server password read out of the vault.
if [ -n "$db_connection" ]; then
  if kv_exists "$db_connection"; then
    hosting::log "keep    ${db_connection} (exists — never rewritten: it is the string the portal reads)"
    kept=$((kept + 1))
    hosting::say kv_db_connection kept
  else
    # Every input, or a refusal naming the flag and the one manual path that still works: the
    # write-only GUI (policy secrets-write-only-entry), never a hand-run vault command.
    manual="paste it on the control instance's record page for this instance (Set Key Vault secrets…) as ${db_connection} — never a hand-run vault command (policy secrets-write-only-entry) (Host=…;Port=…;Username=…;Password=…;Database=…;SslMode=Require;Trust Server Certificate=true)"
    for pair in "db-host:$db_host" "db-port:$db_port" "db-user:$db_user" "db-name:$db_name" "db-password-secret:$db_password_secret"; do
      [ -n "${pair#*:}" ] \
        || hosting::die "${db_connection} is absent from vault ${vault} and cannot be composed: missing --${pair%%:*}. The plan passes --db-password-secret from AZ_POSTGRES_PASSWORD_SECRET on the control record's operator.environment (the vault object holding the server's admin password, e.g. memex-postgres-password) — set it and re-request the action, or write the object by hand: ${manual}"
    done
    hosting::log "create  ${db_connection} (Host=${db_host};Port=${db_port};Username=${db_user};Database=${db_name}; the password is read from ${db_password_secret} and never shown)"
    if hosting::dry; then
      created=$((created + 1))
      hosting::say kv_db_connection would-create
    else
      # The password lives in one shell variable, goes into a mode-600 temporary and reaches az
      # through --file: never an argument (argv is readable by every process in the pod, and
      # hosting::do would echo it), never a ::hosting:: fact, never a log line.
      db_password="$(az keyvault secret show --vault-name "$vault" --name "$db_password_secret" --query value -o tsv 2>/dev/null)" \
        || hosting::die "could not read ${db_password_secret} from vault ${vault} — the server's admin password this identity composes the connection string from. Nothing was written. Grant the operator identity secret GET on it, or write the object by hand: ${manual}"
      [ -n "$db_password" ] \
        || hosting::die "vault ${vault} object ${db_password_secret} is EMPTY — a connection string with no password fails at NpgsqlConnector.RawOpen with nothing naming this step. Nothing was written."
      umask 077
      db_file="$(mktemp)"
      trap 'rm -f "$db_file"' EXIT
      printf 'Host=%s;Port=%s;Username=%s;Password=%s;Database=%s;SslMode=Require;Trust Server Certificate=true' \
        "$db_host" "$db_port" "$db_user" "$db_password" "$db_name" > "$db_file"
      unset db_password
      az keyvault secret set --vault-name "$vault" --name "$db_connection" --file "$db_file" --output none \
        || hosting::die "could not create ${db_connection} in vault ${vault}. Nothing was written; the manual path is: ${manual}"
      rm -f "$db_file"
      kv_exists "$db_connection" \
        || hosting::die "${db_connection} was written to vault ${vault} but cannot be read back — refusing to report a secret the CSI driver will not find"
      hosting::log "created ${db_connection} in vault ${vault} (read back by id)"
      created=$((created + 1))
      hosting::say kv_db_connection created
    fi
  fi
fi

# ── the helm VALUES HALF (Memex#648) ──────────────────────────────────────────────────────────
# Only when the plan names a release (--values-half <release>): the record declares
# `vaultValuesKeys`, so hosting-deploy --vault REQUIRES helm-values-<release> and refuses without
# it — and on an external database with AdoNet clustering (every multi-replica instance) the chart
# itself refuses to render without secrets.memex_portal.ConnectionStrings__memex
# (deploy/helm/templates/_database.tpl, memex.orleansConnectionString). Nothing composed that
# object: on 2026-09-26 the control instance's Provision stopped at 'Deploy release' and a PERSON
# built helm-values-control with az from control-db-connection and the server password.
#
# Composed here only when ABSENT — never rewritten, the master-key rule again: a captured half may
# carry keys this step knows nothing about (AI provider keys, OAuth secrets), and replacing it would
# drop them. The content is the minimal half the chart needs for an external database, families
# only (hosting-deploy refuses structure, Memex#295):
#   secrets.memex_portal.{ConnectionStrings__memex, memex_postgres_password}
#   secrets.memex_migration.{ConnectionStrings__memex, memex_postgres_password}
# ConnectionStrings__orleans is deliberately NOT written: the chart derives it from the mesh string
# (`;Search Path=orleans`) by its ONE rule in memex.orleansConnectionString, and a second copy here
# would be a second rule that can drift. The connection string is the db-connection object's own
# value (just composed above, or the existing one — a hand-written string stays authoritative); the
# password is the server's admin password object. Both are read into files and reach the JSON
# through jq --rawfile: no value is ever on an argv, printed or reported. JSON, not YAML, because jq
# quotes every byte a password can hold; helm reads JSON values and hosting-deploy's key reader
# accepts a JSON object.
if [ -n "$values_half" ]; then
  half_name="helm-values-${values_half}"
  if kv_exists "$half_name" && [ -n "$vault_keys" ]; then
    # 🚨 EXACTLY THE DECLARED KEYS (policy `one-values-half-per-release`, MeshWeaver#4685). With the
    # record's vaultValuesKeys this step no longer keeps a half blind: it reads the KEY NAMES and
    #   * exact                → kept, untouched;
    #   * over-supplies only   → re-stored FILTERED to the declared keys. Only keys are REMOVED — a
    #                            kept key's value is the same bytes — and the previous version stays in
    #                            the vault as the rollback. This is "what Provision writes";
    #   * a declared key absent → refused: a value cannot be invented, and the master-key rule above
    #                            (never mint over what may seal data) applies to it as to every secret.
    umask 077
    half_cur="$(mktemp)"; half_new="$(mktemp)"
    trap 'rm -f "${half_cur:-}" "${half_new:-}"' EXIT
    az keyvault secret download --vault-name "$vault" --name "$half_name" --file "$half_cur" --overwrite --output none 2>/dev/null \
      || hosting::die "could not read ${half_name} from vault ${vault} to check its keys against the record's vaultValuesKeys. Nothing was written."
    half_diff="$(hosting::values_half check "$half_cur" --keys "$vault_keys")"; half_rc=$?
    case "$half_rc" in
      0) hosting::log "keep    ${half_name} (holds exactly the record's declared keys)"
         kept=$((kept + 1))
         hosting::say kv_values_half kept ;;
      3) if printf '%s\n' "$half_diff" | grep -q '^missing: '; then
           hosting::die "${half_name} in vault ${vault} lacks declared key(s) — $(grep '^missing: ' <<< "$half_diff") — and a value cannot be invented. Put the key in the half, or drop it from the record's vaultValuesKeys. Nothing was written."
         fi
         hosting::log "filter  ${half_name} to the record's declared keys — $(tr '\n' ' ' <<< "$half_diff")(names only; values of kept keys unchanged; the previous version stays as the rollback)"
         if hosting::dry; then
           hosting::say kv_values_half would-filter
         else
           hosting::values_half filter "$half_cur" "$half_new" --keys "$vault_keys" >/dev/null \
             || hosting::die "could not filter ${half_name} to the declared keys. Nothing was written."
           hosting::values_half check "$half_new" --keys "$vault_keys" >/dev/null \
             || hosting::die "the filtered ${half_name} still does not hold exactly the declared keys — refusing to store it. Nothing was written."
           az keyvault secret set --vault-name "$vault" --name "$half_name" --file "$half_new" --output none \
             || hosting::die "could not store the filtered ${half_name} in vault ${vault}. Nothing was written."
           hosting::say kv_values_half filtered
         fi
         rm -f "$half_cur" "$half_new"
         created=$((created + 1)) ;;
      *) hosting::die "${half_name} in vault ${vault} could not be checked against the record's vaultValuesKeys (rc ${half_rc}). Nothing was written." ;;
    esac
  elif kv_exists "$half_name"; then
    hosting::log "keep    ${half_name} (exists — never rewritten: a captured half may carry keys this step does not know)"
    kept=$((kept + 1))
    hosting::say kv_values_half kept
  else
    [ -n "$db_connection" ] && [ -n "$db_password_secret" ] \
      || hosting::die "${half_name} is absent from vault ${vault} and cannot be composed: --values-half needs --db-connection and --db-password-secret (the mesh connection string and the server's admin password it is composed from). Nothing was written."
    hosting::log "create  ${half_name} (secrets.memex_portal / secrets.memex_migration: ConnectionStrings__memex from ${db_connection}, memex_postgres_password from ${db_password_secret}; orleans derived by the chart)"
    if hosting::dry; then
      created=$((created + 1))
      hosting::say kv_values_half would-create
    else
      umask 077
      half_dir="$(mktemp -d)"
      trap 'rm -rf "$half_dir" "${db_file:-}"' EXIT
      az keyvault secret show --vault-name "$vault" --name "$db_connection" --query value -o tsv > "$half_dir/cs" 2>/dev/null \
        || hosting::die "could not read ${db_connection} from vault ${vault} — the connection string ${half_name} is composed from. Nothing was written."
      az keyvault secret show --vault-name "$vault" --name "$db_password_secret" --query value -o tsv > "$half_dir/pw" 2>/dev/null \
        || hosting::die "could not read ${db_password_secret} from vault ${vault} — the server password ${half_name} carries. Nothing was written."
      # az -o tsv ends the value with a newline; the value itself never does.
      for f in cs pw; do
        printf '%s' "$(cat "$half_dir/$f")" > "$half_dir/$f.v"
        [ -s "$half_dir/$f.v" ] || hosting::die "a value ${half_name} is composed from is EMPTY (${f}) — a half with a blank connection string fails at silo start with nothing naming this step. Nothing was written."
      done
      jq -n --rawfile cs "$half_dir/cs.v" --rawfile pw "$half_dir/pw.v" \
        '{secrets: {memex_portal: {ConnectionStrings__memex: $cs, memex_postgres_password: $pw},
                    memex_migration: {ConnectionStrings__memex: $cs, memex_postgres_password: $pw}}}' \
        > "$half_dir/half.json" \
        || hosting::die "could not compose ${half_name} (jq). Nothing was written."
      # Exactly the declared keys, before anything is written (policy `one-values-half-per-release`):
      # this step composes the database keys only, so a record declaring more cannot be provisioned
      # here — named, not half-written.
      if [ -n "$vault_keys" ]; then
        compose_diff="$(hosting::values_half check "$half_dir/half.json" --keys "$vault_keys")" \
          || hosting::die "the ${half_name} this step can compose (ConnectionStrings__memex, ConnectionStrings__orleans via the chart, MEMEX_PASSWORD) is not the record's declared key set — $(tr '\n' ';' <<< "$compose_diff"). Nothing was written."
      fi
      rm -f "$half_dir/cs" "$half_dir/pw" "$half_dir/cs.v" "$half_dir/pw.v"
      az keyvault secret set --vault-name "$vault" --name "$half_name" --file "$half_dir/half.json" --output none \
        || hosting::die "could not create ${half_name} in vault ${vault}. Nothing was written."
      rm -rf "$half_dir"
      kv_exists "$half_name" \
        || hosting::die "${half_name} was written to vault ${vault} but cannot be found back — refusing to report a values half hosting-deploy will not find"
      hosting::log "created ${half_name} in vault ${vault} (read back by name)"
      created=$((created + 1))
      hosting::say kv_values_half created
    fi
  fi
fi

hosting::log "vault ${vault}: ${created} created, ${kept} already present"
hosting::say kv_created "$created"
hosting::say kv_kept "$kept"
