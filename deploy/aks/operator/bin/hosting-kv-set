#!/usr/bin/env bash
# hosting-kv-set --vault <name> --object <name> [--object <name> …]
#                [--namespace <ns> --wait <object>=<syncedSecret>/<configKey> …]
#
# Write HUMAN-SUPPLIED secret values into Key Vault (MeshWeaver.Plugins — the onboarding secret
# step). A person pastes a value into a write-only field on the control instance — the sign-in
# app's client secret, a mail app's secret, an AI provider key, a connection string — the mesh
# stores it ENCRYPTED on the request node, decrypts it for exactly this Job, and this step is what
# puts it into the vault the instance's Deployment record names. Nobody needs a vault permission of
# their own: the operator identity writes, as it already does for every other object.
#
#   THE VALUES ARRIVE IN THE ENVIRONMENT, NEVER AS ARGUMENTS. `HOSTING_SECRETS` is base64 of a JSON
#   object {"<vault object>": "<value>", …}. Every process in the pod can read another process's
#   argv; an environment value is the process's own. Each value goes from that JSON straight into a
#   mode-600 temporary file and reaches az through --file — never --value, never a log line.
#
# 🚨 IT DOES OVERWRITE. `hosting-kv-ensure` refuses to touch an existing object because the master
# key seals stored credentials and regenerating it destroys them. A value a PERSON pasted is
# different in kind: they hold the new credential and mean to replace the old one (a rotated
# client secret, a corrected connection string), and Key Vault keeps the previous version for a
# rollback. That is why this is a separate verb, and why kv-ensure must never grow a --force.
#
# 🚨 EVERY named object must have a value, or NOTHING is written. A plan that names three objects
# and finds two values is a bug in the caller, and writing two of three would leave an instance
# half-configured with a green step above it.
#
# 🚨 NEVER PRINTS A VALUE. Not on success, not on failure, not in a `set -x` (deliberately not
# enabled), not in a `::hosting::` fact. What crosses back to the mesh is the object NAME and a
# SHA-256 prefix of what was written, so a reader can tell "the vault holds what was pasted" from
# "something else is in there" without either being shown.
#
# --wait <object>=<syncedSecret>/<configKey>: after the write, wait until every pod in --namespace
# that mounts the object reports the NEW VERSION in its SecretProviderClassPodStatus (a metadata
# read; no Secret is read). A
# pod restarted before the sync would read the OLD synced Secret (DeploymentAKS → "KeyVault CSI env
# timing"); the plan restarts only after this step returns.
#
# --generate <name>: mint the value HERE (32 random bytes, base64) instead of taking a pasted one.
# Nobody ever sees it: it goes from /dev/urandom into a 0600 file and into the vault. That is the
# right shape for every secret no third party has to paste anywhere (a master key, a bootstrap
# secret, an in-fleet pairing whose two ends both read the vault). --generate and --object may
# be mixed in one step; a generated object needs no HOSTING_SECRETS entry.
#
# --set-by <principal>: who asked for the write, recorded as the object's `mw-set-by` tag.
#
# WRITE-ONLY BY CONSTRUCTION (policy `secrets-write-only-entry`, Doc/Architecture/
# SecretsWriteOnlyEntry): this step runs as the WRITER identity, which may list, read metadata, set,
# delete and recover, and may NEVER read a value (no `get`). So it never calls `secret show`. The
# write is confirmed by the version id the `set` itself returns, looked up again in `list-versions`
# (a metadata read). The status travels as TAGS written in the same call:
#   mw-fp      hosting::fingerprint — `sha256:<12 hex>`, or `withheld:low-entropy`
#   mw-set-by  --set-by, or `hosting-operator` when the caller named nobody
#   mw-set-at  the UTC instant of the write
#   mw-source  paste | generate
# shellcheck source=_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-kv-set"

vault="" namespace="" set_by="hosting-operator" objects=() generated=() waits=()
while [ $# -gt 0 ]; do
  case "$1" in
    --vault)     vault="${2:-}";        shift 2 ;;
    --namespace) namespace="${2:-}";    shift 2 ;;
    --object)    objects+=("${2:-}");   shift 2 ;;
    --generate)  generated+=("${2:-}"); objects+=("${2:-}"); shift 2 ;;
    --wait)      waits+=("${2:-}");     shift 2 ;;
    --set-by)    set_by="${2:-}";       shift 2 ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done
hosting::safe_actor set-by "$set_by"
is_generated() { local g; for g in "${generated[@]}"; do [ "$g" = "$1" ] && return 0; done; return 1; }
hosting::need_flag vault "$vault"
hosting::safe_name vault "$vault"
[ ${#objects[@]} -gt 0 ] || hosting::die "missing required flag --object — a secret write that names nothing is a bug in the caller, not a no-op"
for object in "${objects[@]}"; do
  [ -n "$object" ] || hosting::die "missing required flag --object — an empty object name names nothing"
  hosting::safe_name object "$object"
done
[ -z "$namespace" ] || hosting::safe_name namespace "$namespace"
# Every --wait is validated up front, whether or not the write turns out to succeed: its three
# parts are interpolated into kubectl arguments, and a malformed one refuses BEFORE the vault is
# touched.
for entry in "${waits[@]}"; do
  [[ "$entry" == *=*/* ]] || hosting::die "wait '${entry}' is not <object>=<syncedSecret>/<configKey>"
  w_object="${entry%%=*}"; w_rest="${entry#*=}"; w_secret="${w_rest%%/*}"; w_key="${w_rest#*/}"
  hosting::safe_name wait-object "$w_object"
  hosting::safe_name wait-secret "$w_secret"
  hosting::safe_name wait-key "$w_key"
  [ -n "$namespace" ] || hosting::die "--wait needs --namespace — the synced Secret lives in the instance's namespace"
  found=0
  for object in "${objects[@]}"; do [ "$object" = "$w_object" ] && found=1; done
  [ "$found" = "1" ] || hosting::die "wait names '${w_object}', which no --object writes — refusing to wait for a value this step does not set"
done

pasted_count=$(( ${#objects[@]} - ${#generated[@]} ))

if hosting::dry; then
  for object in "${objects[@]}"; do
    if is_generated "$object"; then
      hosting::log "(dry run) would GENERATE ${object} in vault ${vault} (never shown), tagged mw-set-by=${set_by}"
    else
      hosting::log "(dry run) would set ${object} in vault ${vault} from the pasted value (through --file, never shown), tagged mw-set-by=${set_by}"
    fi
  done
  for entry in "${waits[@]}"; do
    hosting::log "(dry run) would wait for ${entry#*=} in ${namespace} to carry the new ${entry%%=*}"
  done
  hosting::say kv_set_count "${#objects[@]}"
  exit 0
fi

command -v jq >/dev/null 2>&1 \
  || hosting::die "jq is not installed in this image — the pasted values arrive as JSON"
if [ "$pasted_count" -gt 0 ]; then
  [ -n "${HOSTING_SECRETS:-}" ] \
    || hosting::die "HOSTING_SECRETS is empty — the control plane hands the pasted values to this Job in the environment, and an empty one means the action reached the cluster with nothing to write. Nothing was written."
fi

# Everything below touches the values. umask first: every temporary this step creates is 0600.
umask 077
work="$(mktemp -d)" || hosting::die "could not create a private working directory"
cleanup() { rm -rf "$work"; unset HOSTING_SECRETS; }
trap 'hosting::on_exit; cleanup' EXIT

if [ -n "${HOSTING_SECRETS:-}" ]; then
  if ! printf '%s' "$HOSTING_SECRETS" | base64 -d > "$work/secrets.json" 2>/dev/null; then
    hosting::die "HOSTING_SECRETS is not valid base64. Nothing was written."
  fi
else
  echo '{}' > "$work/secrets.json"
fi
unset HOSTING_SECRETS
jq -e 'type == "object"' "$work/secrets.json" >/dev/null 2>&1 \
  || hosting::die "HOSTING_SECRETS did not decode to a JSON object of {object: value}. Nothing was written."

# ── every PASTED object has a non-empty value, or nothing is written ───────────────────────────
missing=()
for object in "${objects[@]}"; do
  is_generated "$object" && continue
  if ! jq -e --arg k "$object" 'has($k) and (.[$k] | type == "string" and length > 0)' "$work/secrets.json" >/dev/null 2>&1; then
    missing+=("$object")
  fi
done
if [ ${#missing[@]} -gt 0 ]; then
  hosting::die "no value was handed over for $(IFS=,; echo "${missing[*]}") — the plan names an object the request carries no value for. Nothing was written; re-enter the secret and re-request the action."
fi

# ── the writes, through --file, tagged, confirmed by metadata ──────────────────────────────────
written=0
for object in "${objects[@]}"; do
  hosting::step "Set ${object}"
  if is_generated "$object"; then
    source_tag="generate"
    # 32 random bytes, base64, no newline: 256 bits, never printed, never on a command line.
    head -c 32 /dev/urandom | base64 | tr -d '\n' > "$work/value" \
      || hosting::die "could not generate a value for ${object}. ${written} of ${#objects[@]} object(s) were written before this one."
  else
    source_tag="paste"
    # -j: raw and WITHOUT a trailing newline — a client secret with a newline appended fails every
    # token exchange, and az stores the file byte-for-byte.
    jq -rj --arg k "$object" '.[$k]' "$work/secrets.json" > "$work/value" \
      || hosting::die "could not extract the value for ${object}. ${written} of ${#objects[@]} object(s) were written before this one."
  fi
  fp="$(hosting::fingerprint "$work/value")"
  set_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if ! version_id="$(az keyvault secret set --vault-name "$vault" --name "$object" --file "$work/value" \
        --tags "mw-fp=${fp}" "mw-set-by=${set_by}" "mw-set-at=${set_at}" "mw-source=${source_tag}" \
        --query id -o tsv 2>"$work/az.err")"; then
    rm -f "$work/value"
    hosting::die "could not set ${object} in vault ${vault}: $(tr -d '\n' < "$work/az.err" | cut -c1-300). ${written} of ${#objects[@]} object(s) were written before this one; the writer identity needs the secret-writer grant (list, set, delete, recover — Doc/Architecture/SecretsWriteOnlyEntry) on ${vault}."
  fi
  rm -f "$work/value"
  [ -n "$version_id" ] \
    || hosting::die "set ${object} in vault ${vault}, but the vault returned no version id — refusing to report a write the vault does not confirm"
  # Confirm BY VERSION through a METADATA read (list-versions), never a value read: a write az
  # reported and the vault did not keep is a failure here, not a pod that cannot start later.
  if ! az keyvault secret list-versions --vault-name "$vault" --name "$object" --query "[?id=='${version_id}'].id" -o tsv 2>/dev/null | grep -qx "$version_id"; then
    hosting::die "set ${object} in vault ${vault} (${version_id##*/}), but that version is not listed — refusing to report a write the vault does not confirm"
  fi
  hosting::log "set       ${object} in vault ${vault} (${version_id##*/}; ${fp}; ${source_tag} by ${set_by})"
  hosting::say kv_set "${object}:${fp}"
  written=$((written + 1))
  echo "${version_id##*/}" > "$work/version.$object"
done
hosting::say kv_set_count "$written"

# ── the CSI sync, by VERSION ───────────────────────────────────────────────────────────────────
# Every pod that mounts the object has a SecretProviderClassPodStatus recording the object VERSION it
# mounted (metadata, never a value). The wait is over when every such record carries the version this
# step just wrote. It reads no Secret at all, so the writer's ServiceAccount needs no `get` on any
# Kubernetes Secret (Doc/Architecture/SecretsWriteOnlyEntry).
attempts="${HOSTING_KV_SYNC_ATTEMPTS:-40}" interval="${HOSTING_KV_SYNC_INTERVAL:-15}"
for entry in "${waits[@]}"; do
  w_object="${entry%%=*}"; w_rest="${entry#*=}"; w_secret="${w_rest%%/*}"; w_key="${w_rest#*/}"
  hosting::step "Wait for the pods mounting ${w_object} (${w_secret}/${w_key}) to carry its new version"
  expected="$(cat "$work/version.$w_object")"
  verdict=""
  for i in $(seq 1 "$attempts"); do
    hosting::probe any kubectl -n "$namespace" get secretproviderclasspodstatuses -o json; rc=$?
    if [ "$rc" -eq 2 ]; then
      hosting::die "could not read the CSI driver's pod statuses in ${namespace}: ${HOSTING_PROBE_ERR}. The writer's ServiceAccount needs get/list on secretproviderclasspodstatuses (deploy/aks/manifests/hosting-operator/secret-writer.yaml). The vault HOLDS the new value; nothing here says whether the pods have it."
    fi
    if [ "$rc" -eq 0 ]; then
      verdict="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r --arg id "secret/${w_object}" --arg v "$expected" '
        [.items[]?.status.objects[]? | select(.id == $id) | .version] as $vs
        | if ($vs | length) == 0 then "unmounted"
          elif all($vs[]; . == $v) then "current \($vs | length)"
          else "stale \([$vs[] | select(. != $v)] | length)/\($vs | length)" end' 2>/dev/null)"
      case "$verdict" in current*)
        hosting::log "synced    ${w_object}: ${verdict#current } pod mount(s) carry version ${expected} (attempt ${i})"
        break ;;
      esac
    fi
    [ "$i" -lt "$attempts" ] && sleep "$interval"
  done
  case "$verdict" in
    current*) ;;
    unmounted)
      hosting::die "no pod in ${namespace} mounts ${w_object}: no SecretProviderClassPodStatus lists it. The vault HOLDS the new value, but the SecretProviderClass must list ${w_object} under ${w_key} before any pod can read it. Declare it on the record, Reconcile, then re-request the action (idempotent: the same value is written again)." ;;
    *)
      hosting::die "the pods in ${namespace} did not pick up version ${expected} of ${w_object} within $((attempts * interval))s (${verdict:-no reading}). The vault HOLDS the new value; the pods still read the old one until the Key Vault CSI driver rotates it. The driver's rotation must be enabled — then re-request the action (idempotent: the same value is written again)." ;;
  esac
  hosting::say kv_synced "$w_object"
done
