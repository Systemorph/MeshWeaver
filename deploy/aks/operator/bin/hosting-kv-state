#!/usr/bin/env bash
# hosting-kv-state --vault <name> --object <name> [--object <name> …] --op enable|disable|delete|recover|purge
#                  [--set-by <principal>]
#
# Change the LIFECYCLE of vault objects without touching (or ever seeing) a value — the write-only
# secret GUI's Disable / Enable / Delete / Recover / Purge (policy `secrets-write-only-entry`,
# Doc/Architecture/SecretsWriteOnlyEntry). Runs as the WRITER identity: `set` covers attribute
# updates, `delete`/`recover`/`purge` the rest, and there is no `get` in any of them.
#
#   enable / disable   `secret set-attributes --enabled`. A disabled object stays in the vault with
#                      every version; the CSI driver can no longer fetch it, so a pod that
#                      (re)mounts it FAILS rather than running on a value someone meant to retire.
#   delete             soft-delete. Recoverable until the vault's retention runs out (the status
#                      reports `recoverableUntil`).
#   recover            undo a soft-delete.
#   purge              permanent. Refused unless the object is ALREADY soft-deleted, so one click
#                      can never destroy a live secret: delete, look at the status, then purge.
#
# 🚨 THE DESTRUCTIVE OPS (delete, purge) are filed as governed actions that need a second person's
# approval on the control instance; this step trusts that gate and does not re-implement it.
# 🚨 Every object must pass, or the step is RED naming how many went through before the one that
# failed — never a partial success under a green step.
# shellcheck source=_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-kv-state"

vault="" op="" set_by="hosting-operator" objects=()
while [ $# -gt 0 ]; do
  case "$1" in
    --vault)  vault="${2:-}";      shift 2 ;;
    --object) objects+=("${2:-}"); shift 2 ;;
    --op)     op="${2:-}";         shift 2 ;;
    --set-by) set_by="${2:-}";     shift 2 ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done
hosting::need_flag vault "$vault"
hosting::safe_name vault "$vault"
hosting::need_flag op "$op"
case "$op" in enable|disable|delete|recover|purge) ;; *) hosting::die "--op '${op}' is not one of enable, disable, delete, recover, purge" ;; esac
[ ${#objects[@]} -gt 0 ] || hosting::die "missing required flag --object — a lifecycle change that names nothing is a bug in the caller, not a no-op"
for object in "${objects[@]}"; do hosting::safe_name object "$object"; done
hosting::safe_actor set-by "$set_by"

if hosting::dry; then
  for object in "${objects[@]}"; do
    hosting::log "(dry run) would ${op} ${object} in vault ${vault} (requested by ${set_by})"
  done
  hosting::say kv_state_count "${#objects[@]}"
  exit 0
fi

work="$(mktemp -d)" || hosting::die "could not create a working directory"
trap 'hosting::on_exit; rm -rf "$work"' EXIT

done_count=0
for object in "${objects[@]}"; do
  hosting::step "${op} ${object}"
  case "$op" in
    enable|disable)
      enabled=true; [ "$op" = "disable" ] && enabled=false
      # 🚨 No --tags here: set-attributes REPLACES the whole tag set, and would wipe the mw-fp /
      # mw-set-by the write stamped. Who toggled it is on the governed action node instead.
      az keyvault secret set-attributes --vault-name "$vault" --name "$object" --enabled "$enabled" \
        --output none 2>"$work/az.err" ;;
    delete)
      az keyvault secret delete --vault-name "$vault" --name "$object" --output none 2>"$work/az.err" ;;
    recover)
      az keyvault secret recover --vault-name "$vault" --name "$object" --output none 2>"$work/az.err" ;;
    purge)
      if ! az keyvault secret list-deleted --vault-name "$vault" --query "[].name" -o tsv 2>"$work/az.err" | grep -qx "$object"; then
        hosting::die "refusing to purge ${object}: it is not soft-deleted in vault ${vault}. Delete it first and read its status — a purge is permanent, and must never be one click away from a live secret. ${done_count} of ${#objects[@]} object(s) were changed before this one."
      fi
      az keyvault secret purge --vault-name "$vault" --name "$object" 2>"$work/az.err" ;;
  esac
  rc=$?
  [ "$rc" -eq 0 ] \
    || hosting::die "could not ${op} ${object} in vault ${vault}: $(tr -d '\n' < "$work/az.err" | cut -c1-300). ${done_count} of ${#objects[@]} object(s) were changed before this one."
  hosting::log "done: ${op} ${object} in vault ${vault} (requested by ${set_by})"
  hosting::say kv_state "${object}:${op}"
  done_count=$((done_count + 1))
done
hosting::say kv_state_count "$done_count"
