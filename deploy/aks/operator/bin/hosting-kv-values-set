#!/usr/bin/env bash
# hosting-kv-values-set --vault <name> --release <release> --declared K1,K2,… --key <K> [--key <K> …]
#                       [--set-by <principal>]
#
# CHANGE NAMED KEYS INSIDE THE VALUES HALF — `helm-values-<release>`, the vault object hosting-deploy
# layers under the record's render (Doc/Architecture/DeploymentEnvLayers → "Changing a key in the
# half"). Before this verb, the half had exactly one writer: hosting-kv-ensure --values-half, which
# COMPOSES an absent half and FILTERS an existing one to the declared keys, never changing a value. So
# a value that also lives in the half — the mesh connection string, rotated through the record page's
# "Set Key Vault secrets…" dialog into `<instance>-db-connection` — kept its stale copy in the half,
# and the next Reconcile layered the stale copy straight back into `memex-portal-secrets`.
#
#   THE VALUES ARRIVE IN THE ENVIRONMENT, NEVER AS ARGUMENTS — exactly hosting-kv-set's contract.
#   `HOSTING_SECRETS` is base64 of a JSON object; this verb reads the entries keyed
#   `values-half:<K>` (the prefix keeps them apart from the vault-object entries hosting-kv-set reads
#   from the same object in the same Job). Each value goes from that JSON into a mode-600 file.
#
# 🚨 ONLY DECLARED KEYS. Every --key must be in --declared (the record's `vaultValuesKeys`, which the
# plan passes verbatim), or NOTHING is written: the half is held to the record's key set in both
# directions (policy `one-values-half-per-release`), and a writer that could add an undeclared key
# would re-open the hole that policy closed.
#
# 🚨 EVERYTHING ELSE IS KEPT. The half is downloaded, the named leaves changed, and the WHOLE document
# re-stored as a new version: every other leaf, every other half, every other family (`parameters`,
# `pgbackrest`) and every multi-line value (a PEM block scalar) is carried over unchanged
# (_values_half.py set). The previous version stays in the vault as the rollback.
#
# 🚨 IT READS THE HALF, SO IT RUNS AS THE OPERATOR IDENTITY. A read-modify-write cannot be done by an
# identity that may never read a value, so this verb is listed TRANSITIONAL in
# .github/manual-keyvault.allow beside hosting-kv-ensure and hosting-deploy, the half's other two
# readers; it retires with the half. It refuses an ABSENT half — composing one is the Provision's job
# (hosting-kv-ensure --values-half), which knows how to build all of it, not one key.
#
# 🚨 LOST-UPDATE GUARD. The version id is read before the download and again before the write; if
# another writer stored a version in between, the run refuses and writes nothing rather than store a
# document that silently drops that writer's change.
#
# 🚨 IT DOES NOT REACH THE PODS. The half is read by hosting-deploy, i.e. at the next Reconcile or
# Roll — a restart alone re-reads the SAME rendered `memex-portal-secrets`. The closing line says so.
#
# 🔒 NEVER PRINTS A VALUE. What crosses back is the key NAME, the half path each landed in, a
# fingerprint (hosting::fingerprint — `sha256:<12 hex>` or `withheld:low-entropy`) and the version.
# The write is read back (a download) and compared leaf by leaf by EQUALITY, names only.
#
# shellcheck source=_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-kv-values-set"

# The entry prefix in HOSTING_SECRETS — the mesh's plan composes the same string
# (InstanceActionPlan.ValuesHalfEntryPrefix in the Hosting plugin).
VALUES_PREFIX="values-half:"

vault="" release="" declared="" set_by="hosting-operator" keys=()
while [ $# -gt 0 ]; do
  case "$1" in
    --vault)    vault="${2:-}";    shift 2 ;;
    --release)  release="${2:-}";  shift 2 ;;
    --declared) declared="${2:-}"; shift 2 ;;
    --key)      keys+=("${2:-}");  shift 2 ;;
    --set-by)   set_by="${2:-}";   shift 2 ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done
hosting::need_flag vault "$vault"
hosting::need_flag release "$release"
hosting::safe_name vault "$vault"
hosting::safe_name release "$release"
hosting::safe_actor set-by "$set_by"
[ -n "$declared" ] \
  || hosting::die "missing required flag --declared — the record's vaultValuesKeys; a half with no declared keys has no key this verb may change"
[ ${#keys[@]} -gt 0 ] \
  || hosting::die "missing required flag --key — a values-half write that names nothing is a bug in the caller, not a no-op"

is_env_key() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }
declared_list=()
IFS=',' read -r -a declared_raw <<< "$declared"
for k in "${declared_raw[@]}"; do
  k="${k// /}"
  [ -n "$k" ] || continue
  is_env_key "$k" || hosting::die "--declared names '${k}', which is not an env-key name ([A-Za-z_][A-Za-z0-9_]*)"
  declared_list+=("$k")
done
[ ${#declared_list[@]} -gt 0 ] || hosting::die "--declared names no key"
is_declared() { local d; for d in "${declared_list[@]}"; do [ "$d" = "$1" ] && return 0; done; return 1; }
undeclared=()
for k in "${keys[@]}"; do
  [ -n "$k" ] || hosting::die "missing required flag --key — an empty key names nothing"
  is_env_key "$k" || hosting::die "--key '${k}' is not an env-key name ([A-Za-z_][A-Za-z0-9_]*)"
  is_declared "$k" || undeclared+=("$k")
done
[ ${#undeclared[@]} -eq 0 ] \
  || hosting::die "$(IFS=,; echo "${undeclared[*]}") is not declared in the record's vaultValuesKeys ($(IFS=,; echo "${declared_list[*]}")) — only a declared key may be written into the half (policy one-values-half-per-release). Declare it on the record first. Nothing was written."

half="helm-values-${release}"
key_csv="$(IFS=,; echo "${keys[*]}")"
declared_csv="$(IFS=,; echo "${declared_list[*]}")"

if hosting::dry; then
  hosting::log "(dry run) would change ${key_csv} in ${half} (vault ${vault}) from the handed-over values, keeping every other key; no value is read in a dry run"
  hosting::say kv_values_set_count "${#keys[@]}"
  exit 0
fi

command -v jq >/dev/null 2>&1 || hosting::die "jq is not installed in this image — the values arrive as JSON"
[ -n "${HOSTING_SECRETS:-}" ] \
  || hosting::die "HOSTING_SECRETS is empty — the control plane hands the values to this Job in the environment, and an empty one means the action reached the cluster with nothing to write. Nothing was written."

umask 077
work="$(mktemp -d)" || hosting::die "could not create a private working directory"
cleanup() { rm -rf "$work"; unset HOSTING_SECRETS; }
trap 'hosting::on_exit; cleanup' EXIT

printf '%s' "$HOSTING_SECRETS" | base64 -d > "$work/secrets.json" 2>/dev/null \
  || hosting::die "HOSTING_SECRETS is not valid base64. Nothing was written."
unset HOSTING_SECRETS
jq -e 'type == "object"' "$work/secrets.json" >/dev/null 2>&1 \
  || hosting::die "HOSTING_SECRETS did not decode to a JSON object. Nothing was written."

# ── every named key has a non-empty value, or nothing is written ───────────────────────────────
missing=()
for k in "${keys[@]}"; do
  jq -e --arg e "${VALUES_PREFIX}${k}" 'has($e) and (.[$e] | type == "string" and length > 0)' "$work/secrets.json" >/dev/null 2>&1 \
    || missing+=("$k")
done
[ ${#missing[@]} -eq 0 ] \
  || hosting::die "no value was handed over for $(IFS=,; echo "${missing[*]}") — the plan names a key the request carries no value for. Nothing was written; re-enter the value and re-request the action."
# {K: value} for exactly the named keys — the helper's input. Never on a command line.
jq --arg p "$VALUES_PREFIX" 'with_entries(select(.key | startswith($p)) | .key |= ltrimstr($p))' \
  "$work/secrets.json" > "$work/values.json" \
  || hosting::die "could not extract the handed-over values. Nothing was written."
rm -f "$work/secrets.json"

# ── the half must exist; its version is pinned before the read ─────────────────────────────────
hosting::kv_exists "$vault" "$half"; exists_rc=$?
case "$exists_rc" in
  0) ;;
  1) hosting::die "${half} is absent from vault ${vault} — this verb changes keys in an EXISTING half; composing one is the Provision's vault step (hosting-kv-ensure --values-half). Nothing was written." ;;
  *) hosting::die "could not list vault ${vault} to find ${half}. Nothing was written." ;;
esac
version_of() { az keyvault secret show --vault-name "$vault" --name "$half" --query id -o tsv 2>"$work/az.err"; }
before="$(version_of)" && [ -n "$before" ] \
  || hosting::die "could not read the current version of ${half}: $(tr -d '\n' < "$work/az.err" | cut -c1-300). Nothing was written."
az keyvault secret download --vault-name "$vault" --name "$half" --file "$work/current" --overwrite --output none 2>"$work/az.err" \
  || hosting::die "could not read ${half} from vault ${vault}: $(tr -d '\n' < "$work/az.err" | cut -c1-300). Nothing was written."
downloaded="$(version_of)" || downloaded=""
[ "$downloaded" = "$before" ] \
  || hosting::die "${half} changed while it was being read (${before##*/} → ${downloaded##*/}) — another writer stored a version. Nothing was written; re-request the action."

# ── change exactly the named keys, keep everything else ─────────────────────────────────────────
hosting::step "Change ${key_csv} in ${half}"
set_out="$(hosting::values_half set "$work/current" "$work/values.json" "$work/next.json" --keys "$declared_csv" --set "$key_csv")"; set_rc=$?
case "$set_rc" in
  0) ;;
  3) case "$set_out" in
       *"derived: "*) hosting::die "$(grep '^derived: ' <<< "$set_out" | sed 's/^derived: //; s/<-/ is derived by the chart from /') — no half carries it yet, and writing a first copy would freeze the chart's derivation. Change the key it is derived from instead. Nothing was written." ;;
       *) hosting::die "the half refused the write — $(tr '\n' ';' <<< "$set_out"). Nothing was written." ;;
     esac ;;
  *) hosting::die "could not change ${key_csv} in ${half} (rc ${set_rc}). Nothing was written." ;;
esac
while IFS= read -r line; do
  case "$line" in
    "set: "*) hosting::log "set     ${line#set: } (value not shown)" ;;
    "still-undeclared: "*|"still-missing: "*) hosting::log "note    ${half} ${line} — names only; this write neither caused nor fixes it (a Repair filters the half to the record's keys)" ;;
  esac
done <<< "$set_out"

# The lost-update guard, once more, immediately before the write.
current="$(version_of)" || current=""
[ "$current" = "$before" ] \
  || hosting::die "${half} changed while this write was being prepared (${before##*/} → ${current##*/}) — another writer stored a version. Nothing was written; re-request the action."

fp="$(hosting::fingerprint "$work/next.json")"
set_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if ! version_id="$(az keyvault secret set --vault-name "$vault" --name "$half" --file "$work/next.json" \
      --tags "mw-fp=${fp}" "mw-set-by=${set_by}" "mw-set-at=${set_at}" "mw-source=values-set" \
      --query id -o tsv 2>"$work/az.err")"; then
  hosting::die "could not store ${half} in vault ${vault}: $(tr -d '\n' < "$work/az.err" | cut -c1-300). Nothing was written."
fi
[ -n "$version_id" ] \
  || hosting::die "stored ${half} in vault ${vault}, but the vault returned no version id — refusing to report a write the vault does not confirm"

# ── read back and compare by equality, names only ───────────────────────────────────────────────
az keyvault secret download --vault-name "$vault" --name "$half" --file "$work/readback" --overwrite --output none 2>"$work/az.err" \
  || hosting::die "stored ${half} (${version_id##*/}) but could not read it back: $(tr -d '\n' < "$work/az.err" | cut -c1-300). The vault holds the new version; whether it carries the values is unverified."
verify_out="$(hosting::values_half verify "$work/readback" "$work/values.json" --set "$key_csv")" \
  || hosting::die "stored ${half} (${version_id##*/}) but the read-back does not carry the handed-over value for: ${verify_out#differs: }. The previous version is the rollback."

for k in "${keys[@]}"; do
  jq -rj --arg k "$k" '.[$k]' "$work/values.json" > "$work/one"
  hosting::say kv_values_set "${k}:$(hosting::fingerprint "$work/one")"
  rm -f "$work/one"
done
hosting::log "stored  ${half} in vault ${vault} (${version_id##*/}; ${fp}; by ${set_by}); the previous version is the rollback"
hosting::log "the pods read the half at the next Reconcile or Roll (hosting-deploy layers it into memex-portal-secrets) — a restart alone keeps the old value"
hosting::say kv_values_half updated
hosting::say kv_values_set_count "${#keys[@]}"
