{
  "name": "memex",
  "namespace": "memex",
  "version": 42,
  "info": {
    "status": "deployed"
  },
  "chart": {
    "metadata": {
      "name": "memex",
      "version": "1.4.0"
    }
  },
  "config": {
    "secrets": {
      "note": "the user-supplied values \u2014 the audit must never print these: value-that-must-never-print"
    },
    "persistence": {
      "data": {
        "claimName": "memex-data",
        "create": true,
        "mountPath": "/data",
        "size": "16Gi",
        "storageClass": "azurefile-memex"
      }
    }
  }
}
