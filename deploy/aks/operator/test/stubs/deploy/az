#!/usr/bin/env bash
# A stand-in `az` for hosting-deploy's values-half tests (MeshWeaver#3780). Only ONE call is
# answered — `keyvault secret download --vault-name V --name N --file F` — and it is answered from
# a fixture, not from anything az does: the bytes of $HOSTING_DEPLOY_FIXTURE/vault/<N> are copied to
# F when that file exists, else the real CLI's SecretNotFound shape goes to stderr with exit 1.
# Every invocation is recorded in $HOSTING_DEPLOY_STUB_LOG so the tests can assert WHICH vault and
# WHICH secret name were asked for. It asserts nothing about Key Vault itself.
set -uo pipefail
log="${HOSTING_DEPLOY_STUB_LOG:?the az stub needs HOSTING_DEPLOY_STUB_LOG}"
fixture="${HOSTING_DEPLOY_FIXTURE:?the az stub needs HOSTING_DEPLOY_FIXTURE}"
printf 'az %s\n' "$*" >> "$log"
if [ "${1:-} ${2:-} ${3:-}" != "keyvault secret download" ]; then
  echo "az stub: unexpected invocation: $*" >&2; exit 1
fi
shift 3
name="" file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --name) name="${2:-}"; shift 2 ;;
    --file) file="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done
src="$fixture/vault/$name"
if [ ! -f "$src" ]; then
  echo "ERROR: (SecretNotFound) A secret with (name/id) ${name} was not found in this key vault. If you recently deleted this secret you may be able to recover it using the correct recovery command." >&2
  exit 1
fi
cp "$src" "$file"
