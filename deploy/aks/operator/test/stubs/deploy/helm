#!/usr/bin/env bash
# A stand-in `helm` for hosting-deploy's adoption tests. `template` prints the fixture manifest
# ($HOSTING_DEPLOY_FIXTURE/rendered.yaml — what the RECORD renders); `upgrade` records that it was
# reached, in order, in $HOSTING_DEPLOY_STUB_LOG. It asserts nothing about helm itself.
set -uo pipefail
log="${HOSTING_DEPLOY_STUB_LOG:?the helm stub needs HOSTING_DEPLOY_STUB_LOG}"
fixture="${HOSTING_DEPLOY_FIXTURE:?the helm stub needs HOSTING_DEPLOY_FIXTURE}"
printf 'helm %s\n' "$*" >> "$log"
case "${1:-}" in
  template)
    # hosting-deploy's VALUES PROBE (Memex#376): a one-template chart that prints the merged values.
    # Answered from $FIXTURE/supplied-values.json — what the upgrade supplies — else `{}`.
    if [ "${2:-}" = "values-probe" ]; then
      [ -f "$fixture/supplied-values.json" ] && cat "$fixture/supplied-values.json" || echo '{}'
      exit 0
    fi
    cat "$fixture/rendered.yaml"
    # A render that FAILS after writing the manifest to stdout, on demand (Memex#626): the error path
    # must name helm's stderr line and never fold the manifest it already printed into the log.
    if [ "${HOSTING_DEPLOY_STUB_TEMPLATE_FAILS:-false}" = "true" ]; then
      echo "Error: stubbed render failure" >&2; exit 1
    fi ;;
  get)      # `helm get values <rel> --namespace <ns> -o json` → $FIXTURE/live-values.json, else `{}`
    [ -f "$fixture/live-values.json" ] && cat "$fixture/live-values.json" || echo '{}' ;;
  status)   # `helm status <rel> --namespace <ns> -o json` → $FIXTURE/status.json, else "not found"
    [ -f "$fixture/status.json" ] && cat "$fixture/status.json" || { echo "Error: release: not found" >&2; exit 1; } ;;
  upgrade)
    # A failing upgrade, on demand: the refusal text must name the roll-forward path and must NOT
    # claim a rollback, because there is no longer an --atomic to perform one (#3782).
    if [ "${HOSTING_DEPLOY_STUB_UPGRADE_FAILS:-false}" = "true" ]; then
      echo "Error: UPGRADE FAILED: stubbed failure" >&2; exit 1
    fi
    echo "Release \"${2:-}\" has been upgraded." ;;
  *) echo "helm stub: unexpected invocation: $*" >&2; exit 1 ;;
esac
