#!/usr/bin/env bash
# A stand-in `dotnet` for the IN-POD half of hosting-dump-analyze (bin/_dump_analyze_pod.sh). Its one
# verb, `dotnet tool install --tool-path <dir> dotnet-dump --version <v>`, writes a stub `dotnet-dump`
# into <dir> that answers `analyze <file> -c … -c <command> -c exit` with canned text per command and
# records the file it was asked to read. So the test runs the REAL pod script — listing, selection,
# the symlink and outside-the-volume refusals, the sentinels — with no .NET and no dump.
#
#   HOSTING_DA_STATE           directory: dotnet.log (the install argv), analyze.log (file + command per call)
#   HOSTING_DA_INSTALL_FAIL=1  the install fails the way an unreachable nuget.org does
set -uo pipefail
state="${HOSTING_DA_STATE:?the dotnet stub needs HOSTING_DA_STATE}"
printf '%s\n' "$*" >> "$state/dotnet.log"
[ "${1:-}" = tool ] && [ "${2:-}" = install ] || { echo "dotnet stub: unexpected call: $*" >&2; exit 9; }
if [ "${HOSTING_DA_INSTALL_FAIL:-0}" = 1 ]; then
  echo "error NU1301: Unable to load the service index for source https://api.nuget.org/v3/index.json." >&2
  exit 1
fi
dir="" version=""
while [ $# -gt 0 ]; do
  case "$1" in --tool-path) dir="$2"; shift 2 ;; --version) version="$2"; shift 2 ;; *) shift ;; esac
done
mkdir -p "$dir"
cat > "$dir/dotnet-dump" <<'STUB'
#!/usr/bin/env bash
state="${HOSTING_DA_STATE:?}"
file="$2"; cmd=""
shift 2
while [ $# -gt 0 ]; do
  case "$1" in -c) [ "$2" = exit ] || [ "$2" = "setsymbolserver -ms" ] || cmd="$2"; shift 2 ;; *) shift ;; esac
done
printf '%s\t%s\n' "$file" "$cmd" >> "$state/analyze.log"
echo "Loading core dump: $file ..."
case "$cmd" in
  eeversion) echo "10.0.1 @Commit: abc" ;;
  threadpool) echo "Worker Thread: Total: 55 Running: 55 Idle: 0 MaxLimit: 32767 MinLimit: 4" ;;
  syncblk) echo "    7 0000A1 1 1 0000B2 2c 12 0000C3 System.Object" ;;
  clrthreads) echo "ThreadCount: 2" ;;
  "clrstack -all")
    printf 'OS Thread Id: 0x2c (12)\n        Child SP               IP Call Site\n00007F0000000001 00007F0000000002 System.Threading.Monitor.Wait(System.Object)\n'
    printf 'OS Thread Id: 0x2d (13)\n        Child SP               IP Call Site\n00007F0000000003 00007F0000000004 System.Threading.Monitor.Wait(System.Object)\n' ;;
  "dumpasync --coalesce") echo "1 MeshWeaver.Messaging.MessageHub+<Deliver>d__1" ;;
  *) echo "unknown command $cmd"; exit 2 ;;
esac
STUB
chmod +x "$dir/dotnet-dump"
echo "Tool 'dotnet-dump' (version '$version') was successfully installed."
