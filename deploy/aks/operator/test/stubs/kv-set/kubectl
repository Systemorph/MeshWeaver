#!/usr/bin/env bash
# A stand-in `kubectl` for hosting-kv-set's sync-wait tests. It answers ONLY
# `get secretproviderclasspodstatuses -o json`: two pod mounts of the object named in
# HOSTING_KVS_SPC_OBJECT, each at version HOSTING_KVS_SPC_VERSION. It REFUSES `get secret`, because
# the writer's ServiceAccount holds no Secret read (deploy/aks/manifests/hosting-operator/secret-writer.yaml).
#
#   HOSTING_KVS_STATE        directory: kubectl.log (every argv)
#   HOSTING_KVS_SPC_OBJECT   the vault object the pods mount; empty = no pod mounts anything
#   HOSTING_KVS_SPC_VERSION  the version every mount reports (default: old)
set -uo pipefail
state="${HOSTING_KVS_STATE:?the kubectl stub needs HOSTING_KVS_STATE}"
printf 'kubectl %s\n' "$*" >> "$state/kubectl.log"
case "$*" in
  *"get secretproviderclasspodstatuses"*)
    object="${HOSTING_KVS_SPC_OBJECT-}" version="${HOSTING_KVS_SPC_VERSION:-old}"
    if [ -z "$object" ]; then echo '{"items":[]}'; exit 0; fi
    printf '{"items":[{"status":{"objects":[{"id":"secret/%s","version":"%s"}]}},{"status":{"objects":[{"id":"secret/other","version":"x"},{"id":"secret/%s","version":"%s"}]}}]}\n' \
      "$object" "$version" "$object" "$version"
    exit 0 ;;
  *"get secret"*)
    echo 'Error from server (Forbidden): secrets is forbidden: the writer never reads a Secret' >&2; exit 1 ;;
esac
echo "kubectl stub: unexpected invocation: $*" >&2
exit 1
