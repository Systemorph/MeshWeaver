#!/usr/bin/env bash
# A stand-in `az` for hosting-kv-values-set's behaviour tests. It records every invocation VERBATIM
# (argv is how the test proves no value ever travels on a command line) and answers ONE vault object,
# the values half `helm-values-acme`, from a small state directory:
#
#   HOSTING_KVV_STATE      directory: az.log (every argv); half (the stored bytes); version (a counter);
#                          tags.<n> (the argv of the `set` that stored version n); sets (how many landed)
#   HOSTING_KVV_ABSENT=1   the vault lists no half at all
#   HOSTING_KVV_RACE=N     after the N-th `show --query id`, another writer stores a version
#   HOSTING_KVV_SET_FAIL=1 every `set` refuses
#   HOSTING_KVV_LOSE=1     a `set` is acknowledged but the stored bytes stay the old ones (read-back control)
#
# Not a mock of az: nothing here asserts az's own behaviour. What is under test is what the script
# reads, what it writes, with what content, and what it never prints.
set -uo pipefail
state="${HOSTING_KVV_STATE:?the az stub needs HOSTING_KVV_STATE}"
printf 'az %s\n' "$*" >> "$state/az.log"
version="$(cat "$state/version" 2>/dev/null || echo 1)"
name="" file=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in --name) name="${args[$((i + 1))]:-}" ;; --file) file="${args[$((i + 1))]:-}" ;; esac
done
case "${1:-} ${2:-} ${3:-}" in
  "keyvault secret list")
    [ "${HOSTING_KVV_ABSENT:-0}" = "1" ] || printf 'helm-values-acme\n'
    printf 'acme-db-connection\n'
    exit 0 ;;
  "keyvault secret show")
    shows=$(( $(cat "$state/shows" 2>/dev/null || echo 0) + 1 )); echo "$shows" > "$state/shows"
    printf 'https://vault.test/secrets/%s/v%s\n' "$name" "$version"
    if [ -n "${HOSTING_KVV_RACE:-}" ] && [ "$shows" -eq "${HOSTING_KVV_RACE}" ]; then
      echo $((version + 1)) > "$state/version"
    fi
    exit 0 ;;
  "keyvault secret download")
    [ "$name" = "helm-values-acme" ] || { echo "ERROR: (SecretNotFound) ${name}" >&2; exit 3; }
    cp "$state/half" "$file"; exit 0 ;;
  "keyvault secret set")
    [ "${HOSTING_KVV_SET_FAIL:-0}" = "1" ] && { echo "ERROR: (Forbidden) secrets set permission" >&2; exit 1; }
    [ -f "$file" ] || { echo "az stub: --file ${file} does not exist" >&2; exit 1; }
    [ "${HOSTING_KVV_LOSE:-0}" = "1" ] || cp "$file" "$state/half"
    version=$((version + 1)); echo "$version" > "$state/version"
    printf '%s\n' "$*" > "$state/tags.$version"
    echo $(( $(cat "$state/sets" 2>/dev/null || echo 0) + 1 )) > "$state/sets"
    printf 'https://vault.test/secrets/%s/v%s\n' "$name" "$version"
    exit 0 ;;
esac
echo "az stub: unexpected invocation: $*" >&2
exit 1
