#!/usr/bin/env bash
# A stand-in plugin REGISTRY for hosting-registry-coupon's tests: answers POST /api/instances/coupons
# the way RegistrationCouponEndpoints (core) does, from a state directory, so a test can assert the
# operator's DECISIONS — what it presented, what it stored, and that nothing is printed.
#
#   $HOSTING_COUPON_STATE/mode     normal | absent (no mint: 404) | noowner (503)
#   $HOSTING_COUPON_STATE/secret   the mint credential the registry accepts
#   $HOSTING_COUPON_STATE/ladder   space-separated plan ids the registry's tier ladder knows
#   $HOSTING_COUPON_STATE/log      one line per call: MINT tier=<t> uses=<n> days=<n> cred=<ok|bad|none>
#
# 🚨 The credential arrives the way curl reads it — the `-K -` config on STDIN — and only its VERDICT
# is logged. PURE BASH plus sed (the operator image ships no awk).
set -uo pipefail
state="${HOSTING_COUPON_STATE:?the coupon stub needs HOSTING_COUPON_STATE}"
out="" body="" url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="${2:-}"; shift 2 ;;
    --data) body="${2:-}"; shift 2 ;;
    -X|-K|-w|-H|--max-time) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
presented="$(sed -n 's/^header = "X-MeshWeaver-Coupon-Secret: \(.*\)"$/\1/p')"
answer() { printf '%s' "$2" > "${out:-/dev/null}"; printf '%s' "$1"; exit 0; }
mode="$(cat "$state/mode" 2>/dev/null || echo normal)"
tier="$(printf '%s' "$body" | sed -n 's/.*"tier":"\([^"]*\)".*/\1/p')"
uses="$(printf '%s' "$body" | sed -n 's/.*"maxUsages":\([0-9]*\).*/\1/p')"
days="$(printf '%s' "$body" | sed -n 's/.*"expiresDays":\([0-9]*\).*/\1/p')"
verdict=none; [ -n "$presented" ] && { [ "$presented" = "$(cat "$state/secret" 2>/dev/null)" ] && verdict=ok || verdict=bad; }
printf 'MINT tier=%s uses=%s days=%s cred=%s url=%s\n' "$tier" "$uses" "$days" "$verdict" "$url" >> "$state/log"
[ "$mode" = "absent" ] && answer 404 ''
[ "$verdict" = "ok" ] || answer 401 '{"error":"invalid or missing mint credential"}'
[ "$mode" = "noowner" ] && answer 503 '{"error":"this registry configures no PluginCatalog:Coupons:Owner"}'
known=false; for t in $(cat "$state/ladder" 2>/dev/null); do [ "$t" = "$tier" ] && known=true; done
[ "$known" = true ] || answer 400 "$(printf '{"error":"plan '"'"'%s'"'"' is not on this registry'"'"'s tier ladder (Admin/Tiers: %s). Nothing was minted."}' "$tier" "$(cat "$state/ladder" 2>/dev/null)")"
answer 200 "$(printf '{"coupon":"mwr_fake-coupon-NEVER-PRINTED-%s","id":"c0ffee123456","tier":"%s","expiresAt":"2026-11-30T00:00:00+00:00","maxUsages":%s}' "$tier" "$tier" "${uses:-1}")"
