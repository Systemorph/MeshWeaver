#!/usr/bin/env bash
# A stand-in `kubectl` for hosting-storage-prune's behaviour tests. Not a mock of kubectl: what is
# tested is what the SCRIPT does with the answers — which claim it decides is the data share, which Job
# it creates (read-only unless --execute, no secret, no token), whether it waits for the Job's verdict,
# reads its log, deletes it, and what it classifies and reports.
#
#   HOSTING_SP_STATE         directory: kubectl.log (one argv per call), manifest.json (what `create -f -` got)
#   HOSTING_SP_DEPLOYMENTS   the file `get deployments -o json` answers with
#   HOSTING_SP_LOG           the file `logs job/<name>` answers with (the walker's output)
#   HOSTING_SP_JOB           succeeded (default) | failed — the Job's verdict
#   HOSTING_SP_FORBID=1      `get deployments` answers Forbidden (REFUSED is not ABSENT, #4722)
#   HOSTING_SP_NO_PVC=1      `get pvc` answers NotFound
set -uo pipefail
state="${HOSTING_SP_STATE:?the kubectl stub needs HOSTING_SP_STATE}"
printf '%s\n' "$*" >> "$state/kubectl.log"
case "$*" in
  *"get deployments -o json"*)
    if [ "${HOSTING_SP_FORBID:-0}" = 1 ]; then
      echo 'Error from server (Forbidden): deployments.apps is forbidden: User "system:serviceaccount:memex-ops:hosting-operator" cannot list resource "deployments" in API group "apps" in the namespace "memex-cloud"' >&2
      exit 1
    fi
    cat "${HOSTING_SP_DEPLOYMENTS:?}" ;;
  *" get pvc "*)
    if [ "${HOSTING_SP_NO_PVC:-0}" = 1 ]; then
      echo 'Error from server (NotFound): persistentvolumeclaims "artifact-store" not found' >&2
      exit 1
    fi
    echo "persistentvolumeclaim/artifact-store" ;;
  *" create -f -"*)
    cat > "$state/manifest.json"
    echo "job.batch/stub created" ;;
  *" get job "*)
    case "${HOSTING_SP_JOB:-succeeded}" in
      failed) echo '{"status":{"failed":1,"conditions":[{"type":"Failed","status":"True","reason":"DeadlineExceeded"}]}}' ;;
      *) echo '{"status":{"succeeded":1,"conditions":[{"type":"Complete","status":"True"}]}}' ;;
    esac ;;
  *" logs job/"*)
    cat "${HOSTING_SP_LOG:?}" ;;
  *" delete job "*)
    echo "job.batch deleted" ;;
  *)
    echo "kubectl stub: unexpected call: $*" >&2
    exit 9 ;;
esac
