<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The in-process (monolith) mesh + SQLite persistence — the same local-first stack the MAUI client
         runs in-process, here as a headless host so a JS client (React Native / web) can reach it over gRPC. -->
    <ProjectReference Include="..\..\src\MeshWeaver.Mesh.Operations\MeshWeaver.Mesh.Operations.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Hosting.Monolith\MeshWeaver.Hosting.Monolith.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Hosting.Sqlite\MeshWeaver.Hosting.Sqlite.csproj" />
    <!-- The gRPC bridge (bidi Open + gRPC-web Connect/Deliver split) the foreign-language clients use. -->
    <ProjectReference Include="..\..\src\MeshWeaver.Hosting.Grpc\MeshWeaver.Hosting.Grpc.csproj" />
    <!-- Node types + content to render: Graph (sample data + node types) and the embedded Documentation. -->
    <ProjectReference Include="..\..\src\MeshWeaver.Graph\MeshWeaver.Graph.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Documentation\MeshWeaver.Documentation.csproj" />
    <!-- Speech-to-text is the CONTRACT only. POST /api/speech/transcribe resolves
         ISpeechTranscriber optionally and answers 503 when nothing provides it, exactly as the
         portal's endpoint does — so the sidecar compiles and runs whether or not voice is
         installed. The Whisper client itself arrives as a MODULE (below). -->
    <ProjectReference Include="..\..\src\MeshWeaver.Speech.Contract\MeshWeaver.Speech.Contract.csproj" />
    <!-- 🚨 The AI engine is NOT referenced here — deliberately, and this comment is the reason.
         It arrives the same way every other module does: MeshWeaver.AI is on the CLOSURE lane
         (memex/MeshModulesPublish.targets), so its bits land in modules/MeshWeaver.AI/ and
         Modules:Assemblies in appsettings.json is what activates it. A ProjectReference would put
         the engine back in this app's own closure — the double-ship that makes the switch control
         nothing, exactly as the Speech note below describes — and it would trip
         MeshModulesGuardPublishAppRoot, which refuses a closure module found in the app root.
         MeshWeaver.AI.csproj is also the ONE reference standing between this repo and #2276. -->
  </ItemGroup>

  <!-- ═════════ The RN web client is BAKED at publish — never hand-copied ═════════
       The GUI this host serves (Program.cs: UseStaticFiles + MapFallbackToFile) is the React
       Native app exported to web (clients/react-native, `npm run web:export`). Until this
       target existed the only lane was a MANUAL `cp -R dist/. wwwroot/` (docs/shell.md), so every
       shipped sidecar served whatever bundle happened to be lying around — stale UI that "shows
       the old user view" while the mesh underneath is current, and main-cd's image-relevance
       filter even classes clients/react-native/ as entering no image because nothing consumed it.

       So a RELEASE PUBLISH bakes the client, the same way the modules/ closure lane rides
       Publish (MeshModulesPublish.targets): export fresh (an existing dist/ is exactly the
       staleness this target exists to kill, so it is never trusted), then lay dist/ into
       $(PublishDir)wwwroot/. Debug builds and `dotnet run` are untouched (dev serves the app from
       Metro, or the last manual copy). The export shells to npm, which every environment that
       Release-publishes this host already has (the CI runners build the JS clients; the image
       publish runs on the runner, not inside the container). Opt out per-invocation with
       BakeRnWebClient=false (an msbuild property), noting the export fails RED when it breaks:
       a bake that silently ships without its GUI would be the skip-trapdoor CI forbids. -->
  <Target Name="BakeRnWebClient" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' AND '$(BakeRnWebClient)' != 'false'">
    <PropertyGroup>
      <!-- The RN app lives in MeshWeaver.Plugins now (app/react-native — #2169 Phase A). The bake
           probes: explicit -p:RnClientDir / MEMEX_RN_APP_DIR > the app's old in-repo home (kept
           first so a transition-era checkout still wins) > the sibling MeshWeaver.Plugins
           checkout. No workflow in THIS repo publishes the sidecar Release, so CI carries no
           cross-repo dependency; when none of the probes hit, the Error below still fails the
           publish RED — a GUI-less sidecar must never ship silently. -->
      <RnClientDir Condition="'$(RnClientDir)' == ''">$(MEMEX_RN_APP_DIR)</RnClientDir>
      <RnClientDir Condition="'$(RnClientDir)' == '' AND Exists('$(MSBuildThisFileDirectory)../../clients/react-native/package.json')">$(MSBuildThisFileDirectory)../../clients/react-native/</RnClientDir>
      <RnClientDir Condition="'$(RnClientDir)' == '' AND Exists('$(MSBuildThisFileDirectory)../../../MeshWeaver.Plugins/app/react-native/package.json')">$(MSBuildThisFileDirectory)../../../MeshWeaver.Plugins/app/react-native/</RnClientDir>
      <RnDeployment Condition="'$(RnDeployment)' == ''">$(MEMEX_DEPLOYMENT)</RnDeployment>
    </PropertyGroup>
    <!-- Speak BEFORE any Exec can fail confusingly: no probe hit means there is no app checkout
         to bake — name the probes and the opt-out instead of dying inside npm. -->
    <Error Condition="'$(RnClientDir)' == ''"
           Text="BakeRnWebClient: no RN app checkout found. The app lives in MeshWeaver.Plugins (app/react-native — MeshWeaver#2169 Phase A); probes: -p:RnClientDir / MEMEX_RN_APP_DIR, the old clients/react-native/ tree, the sibling MeshWeaver.Plugins checkout. Clone Systemorph/MeshWeaver.Plugins beside this repo, or pass -p:BakeRnWebClient=false to publish a GUI-less sidecar deliberately." />
    <ItemGroup>
      <RnDeploymentEnv Include="MEMEX_DEPLOYMENT=$(RnDeployment)" Condition="'$(RnDeployment)' != ''" />
    </ItemGroup>
    <!-- npm ci only when node_modules is absent (a dev tree already has it; CI does not). -->
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(RnClientDir)"
          Condition="!Exists('$(RnClientDir)node_modules')" />
    <!-- The DEPLOYMENT the baked app is composed from (deployment/*.json: portal, branding, the
         client modules in the bundle). MSBuild property or MEMEX_DEPLOYMENT env; unset = default.
         web:export regenerates src/deployment.generated.ts from it (npm pre-script), so the baked
         GUI is exactly the declared variant. -->
    <Exec Command="npm run web:export" WorkingDirectory="$(RnClientDir)"
          EnvironmentVariables="@(RnDeploymentEnv)" />
    <ItemGroup>
      <RnWebFiles Include="$(RnClientDir)dist/**/*" />
    </ItemGroup>
    <Error Text="BakeRnWebClient: the web export produced no dist/index.html — refusing to publish a GUI-less sidecar (pass -p:BakeRnWebClient=false to opt out deliberately)."
           Condition="!Exists('$(RnClientDir)dist/index.html')" />
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="@(RnWebFiles)" DestinationFiles="@(RnWebFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="BakeRnWebClient: baked @(RnWebFiles->Count()) files into $(PublishDir)wwwroot/" />
  </Target>

  <!-- ═════════ Modules ship as MODULES here, not as references ═════════
       The principle this host was already documented as following, now actually wired: a module's
       bits arrive under modules/<Name>/ and Modules:Assemblies decides whether it RUNS. A
       ProjectReference instead puts the module in this app's own closure — the double-ship that
       kept it from being a module in the sense that matters: the bits shipped either way and the
       switch controlled nothing.

       🚨 The import is the half that was missing. It lived in Memex.Portal.Distributed and
       Memex.Portal.Monolith, and left with them when the portal GUI moved to MeshWeaver.Plugins
       (83356b3d5) — this host never had it. So the lane's Build hook never ran here and modules/
       was never created, which is why the AI engine was wired the only way that then worked: a
       ProjectReference riding the app closure (8dd8eeecf). With the import in place that
       workaround is gone and the engine arrives the same way it does on the portals.

       MeshModulesClosureSubset names what THIS host lays out. Without it the sidecar would also
       carry the Cosmos and Snowflake drivers, which ship in the portal IMAGE on purpose (a
       Store-installed module needs storage to already work) and are dead weight in a local
       sidecar that never selects either backend. See the 🚨 in MeshModulesPublish.targets: the
       prohibition is on a GLOBAL subset (-p: narrows every project in the build, including an
       image's own layout), not on a project-scoped one — this is a PropertyGroup, so it cannot
       leak past this project. -->
  <PropertyGroup>
    <MeshModulesClosureSubset>MeshWeaver.AI</MeshModulesClosureSubset>
  </PropertyGroup>
  <Import Project="..\MeshModulesPublish.targets" />

</Project>
