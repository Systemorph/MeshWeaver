{
  "Grpc": {
    "Port": 5250
  },
  "Modules": {
    // Nothing here is a ProjectReference — every entry arrives as a MODULE, and this list is the
    // only thing that turns one on. Voice is the shape to copy: MeshWeaver.Speech now ships from
    // the registry (it left for MeshWeaver.Plugins), so it is simply absent below and POST
    // /api/speech/transcribe answers 503 — exactly as a portal without the module does.
    "Assemblies": [
      // The AI engine — Thread/Agent/Skill node types + the chat runtime. The RN shells' composer
      // submits threads; without this every send is refused with "NodeType 'Thread' is not
      // registered". The DLL is laid into modules/MeshWeaver.AI/ by the CLOSURE lane
      // (memex/MeshModulesPublish.targets) and found there by MeshBuilder.ResolveModulePath —
      // NOT by riding this app's closure, which is what the removed ProjectReference used to do.
      "MeshWeaver.AI.dll"
    ]
  },
  "Speech": {
    "Enabled": true,
    "Endpoint": "http://127.0.0.1:8093",
    "Language": "de"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MeshWeaver": "Information"
    }
  }
}
