{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MeshWeaver": "Warning"
    }
  },
  "Styles": {
    "StylesheetName": "Memex.Portal.Monolith"
  },
  "Graph": {
    "Storage": {
      "Type": "FileSystem",
      "BasePath": "../../samples/Graph/Data"
    }
  },
  // The DevLogin identities that get platform admin locally. This is the ONLY way platform
  // admin is provisioned (GlobalAdminSeed writes the Admin/_Access grant at startup) — the
  // sample tree must not ship a privileged _Access file, because it is GitSynced elsewhere
  // and every such grant is refused on a system-owned partition (#1245).
  "Auth": {
    "GlobalAdmins": [ "Roland", "TestUser", "Samuel" ]
  },
  "Storage": {
    "Name": "storage",
    "SourceType": "FileSystem",
    "BasePath": "../../samples/Graph"
  },
  "ClaudeCode": {
    "CliDirectory": "%USERPROFILE%/.local/bin",
    "WorkingDirectory": "../../../../..",
    "Models": [ "opus", "sonnet", "haiku" ],
    "Order": 5
  }
}
