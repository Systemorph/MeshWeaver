{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Styles": {
    "StylesheetName": "Memex.Portal.Monolith"
  },
  "Graph": {
    "Storage": {
      "Type": "FileSystem",
      "BasePath": "../../samples/Graph/Data"
    }
  },
  "Authentication": {
    "EnableDevLogin": true,
    "Providers": []
  },
  "AllowedHosts": "*",
  "Modules": {
    // 🚨 REQUIRED, not merely listed. These four shipped in the image until they moved to
    // the registry (Plugins #570). If an instance has not installed their packages the
    // features are simply gone — charts, analysis views, maps, voice — and the old
    // skip-and-continue rule would let that roll out green. Declaring them here makes the
    // required_modules health check Unhealthy instead, so readiness fails, the rollout
    // STALLS, and the pods that still have them keep serving. Fix forward by installing
    // the package; delist here only if a deployment genuinely does not want the feature.
    "Required": [
      "MeshWeaver.Blazor.Radzen.dll",
      "MeshWeaver.Blazor.Analysis.dll",
      "MeshWeaver.Blazor.EntityViews.dll",
      "MeshWeaver.Blazor.GoogleMaps.dll",
      "MeshWeaver.Speech.dll"
    ],
    "Assemblies": [
      // 🚨 FIRST: the in-mesh compile reference set is composed from the installed modules in
      // list order, so a module whose content compiles against MeshWeaver.Import must follow it.
      "MeshWeaver.Social.dll",
      "MeshWeaver.Hosting.Grpc.dll",
      // The default Blazor control views — factored out of the base MeshWeaver.Blazor pack
      // (which keeps only base classes, area-hosting machinery and the escaped-HTML fallback).
      // In the app closure via Blazor.Graph/Blazor.Portal; this line is what ACTIVATES its
      // view map (ViewsViewPackModuleAttribute -> AddDefaultViews).
      "MeshWeaver.Blazor.Views.dll"
    ]
  }
}