@page "/welcome"
@using Microsoft.AspNetCore.Components.Authorization
@using MeshWeaver.Blazor.Layouts
@inject NavigationManager Navigation
@layout EmptyLayout
@inject AccessService Access

<PageTitle>Welcome - Memex Portal</PageTitle>

<div class="mw-landing">
    <!-- Hero -->
    <div class="mw-hero">
        <h1>@Access.Localize("welcome.headline")</h1>
        <p class="mw-subtitle">
            MeshWeaver brings together documents, collaboration, and AI-powered assistance into one unified platform for your team.
        </p>
        <div class="mw-hero-actions">
            <a class="mw-btn mw-btn-primary" href="@LoginHref">@Access.Localize("common.signIn")</a>
            <a class="mw-btn mw-btn-secondary" href="#features">@Access.Localize("welcome.learnMore")</a>
        </div>
    </div>

    <!-- Features -->
    <h2 class="mw-section-title" id="features">@Access.Localize("welcome.everythingYouNeed")</h2>
    <p class="mw-section-subtitle">@Access.Localize("welcome.everythingSub")</p>

    <div class="mw-features">
        <div class="mw-feature-card">
            <FluentIcon Value="@(new Icons.Regular.Size28.FolderOpen())" Color="Color.Accent" />
            <h3>@Access.Localize("welcome.organize")</h3>
            <p>Structure documents, code, and data in a flexible graph hierarchy. Find anything instantly with powerful search.</p>
        </div>
        <div class="mw-feature-card">
            <FluentIcon Value="@(new Icons.Regular.Size28.PeopleTeam())" Color="Color.Accent" />
            <h3>@Access.Localize("welcome.collaborate")</h3>
            <p>Comment on documents, request approvals, and track changes in real time. Keep everyone aligned.</p>
        </div>
        <div class="mw-feature-card">
            <FluentIcon Value="@(new Icons.Regular.Size28.Chat())" Color="Color.Accent" />
            <h3>@Access.Localize("welcome.aiChat")</h3>
            <p>Get instant answers, generate content, and automate workflows with built-in AI assistants.</p>
        </div>
        <div class="mw-feature-card">
            <FluentIcon Value="@(new Icons.Regular.Size28.Alert())" Color="Color.Accent" />
            <h3>Notifications</h3>
            <p>Stay informed with real-time alerts for approval requests, decisions, mentions, and updates.</p>
        </div>
    </div>

    <!-- How It Works -->
    <h2 class="mw-section-title">@Access.Localize("welcome.getStarted3")</h2>
    <p class="mw-section-subtitle">@Access.Localize("welcome.getStarted3Sub")</p>

    <div class="mw-steps">
        <div class="mw-step">
            <div class="mw-step-number">1</div>
            <h3>@Access.Localize("common.signIn")</h3>
            <p>Use your Microsoft, Google, LinkedIn, or Apple account to get started — no new passwords to remember.</p>
        </div>
        <div class="mw-step">
            <div class="mw-step-number">2</div>
            <h3>@Access.Localize("welcome.setUpProfile")</h3>
            <p>Tell us a bit about yourself so your team can find and collaborate with you easily.</p>
        </div>
        <div class="mw-step">
            <div class="mw-step-number">3</div>
            <h3>@Access.Localize("welcome.startExploring")</h3>
            <p>Access your dashboard with recent activity, notifications, and AI-powered tools at your fingertips.</p>
        </div>
    </div>

    <!-- Final CTA -->
    <div class="mw-cta">
        <h2>@Access.Localize("welcome.readyTitle")</h2>
        <p>@Access.Localize("welcome.readySub")</p>
        <a class="mw-btn mw-btn-cta" href="@LoginHref">@Access.Localize("welcome.signInNow")</a>
    </div>
</div>

@code {
    // Preserve the page the visitor was heading for (if any) so the whole
    // sign-in → onboarding chain can carry it through to the final redirect.
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isAuthenticated;

    // Same-site relative returnUrl only — never an absolute/protocol-relative URL,
    // so the sign-in links and the onboarding redirect can't be turned into open
    // redirects via a crafted ?returnUrl.
    private string? SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl)
        && ReturnUrl.StartsWith('/')
        && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
        && !ReturnUrl.StartsWith("/\\", StringComparison.Ordinal)
            ? ReturnUrl
            : null;

    private string LoginHref =>
        SafeReturnUrl is { } r ? $"/login?returnUrl={Uri.EscapeDataString(r)}" : "/login";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isAuthenticated)
        {
            // Client-side navigation to /onboarding (no forceLoad) avoids
            // re-triggering the HTTP middleware pipeline which can cause redirect loops.
            // Onboarding.razor handles already-onboarded users by redirecting to the
            // returnUrl (or /). Carry the returnUrl through so the chain isn't lost here.
            var target = SafeReturnUrl is { } r
                ? $"/onboarding?returnUrl={Uri.EscapeDataString(r)}"
                : "/onboarding";
            Navigation.NavigateTo(target);
        }
        return Task.CompletedTask;
    }

    private static class Icons
    {
        public static class Regular
        {
            public static class Size28
            {
                public class FolderOpen : Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size28.FolderOpen { }
                public class PeopleTeam : Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size28.PeopleTeam { }
                public class Chat : Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size28.Chat { }
                public class Alert : Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size28.Alert { }
            }
        }
    }
}
