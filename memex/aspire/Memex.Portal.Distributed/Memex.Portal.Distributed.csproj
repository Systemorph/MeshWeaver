<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <ProjectGuid>{d4e5f6a7-b8c9-0123-def4-567890123456}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishProfile>DefaultContainer</PublishProfile>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- The API-surface manifest (#1660 WS3): the portal's framework build identity resolves
         from it — equal to the CI bake host's for unchanged surfaces, which is what lets the
         published bake seed at boot across internal-only merges (see Directory.Build.props). -->
    <MeshWeaverSurfaceManifest>true</MeshWeaverSurfaceManifest>
    <!-- Multi-arch container publish: declare the RID set HERE (project-local), NOT as a global
         `-p:RuntimeIdentifiers=` on the CLI. The container publish (`-t:PublishContainer
         -p:ContainerRuntimeIdentifiers=linux-x64;linux-arm64`) requires RuntimeIdentifiers to be
         declared so the SDK drives a per-RID inner build and assembles an OCI image index. A global
         `-p:RuntimeIdentifiers` would propagate to every ProjectReference and make the libraries fail
         `NETSDK1083: RuntimeIdentifier 'linux-x64;linux-arm64' is not recognized`; a project-local
         property does not propagate, so the libraries are built per-RID with a single valid RID. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MeshWeaver.Connection.Orleans\MeshWeaver.Connection.Orleans.csproj" />
    <ProjectReference Include="..\..\..\src\MeshWeaver.Hosting.Blazor\MeshWeaver.Hosting.Blazor.csproj" />
    <ProjectReference Include="..\..\..\src\MeshWeaver.Hosting.Orleans\MeshWeaver.Hosting.Orleans.csproj" />
    <ProjectReference Include="..\..\..\src\MeshWeaver.ServiceProvider\MeshWeaver.ServiceProvider.csproj" />
    <ProjectReference Include="..\..\Memex.Portal.Shared\Memex.Portal.Shared.csproj" />
    <ProjectReference Include="..\Memex.Portal.ServiceDefaults\Memex.Portal.ServiceDefaults.csproj" />
    <!-- Shared "latest DB version" constant — linked source, NOT a ProjectReference: the
         migration project is a container of its own and must not ride in the portal image.
         The migration runner pins this constant to its registry at startup, so DbVersionGate
         and the migrations cannot drift apart (the gate sat at 32 while migrations ran to V52). -->
    <Compile Include="..\Memex.Database.Migration\DbVersion.cs" Link="DbVersion.cs" />
    <ProjectReference Include="..\..\..\src\MeshWeaver.Hosting.PostgreSql\MeshWeaver.Hosting.PostgreSql.csproj" />
    <ProjectReference Include="..\..\..\src\MeshWeaver.NuGet.AzureBlob\MeshWeaver.NuGet.AzureBlob.csproj" />
    <!-- 🚨 MeshWeaver.Import is deliberately NOT referenced (#1644 step 2), and the reason it was
         referenced before is preserved rather than dropped. It was here for IN-MESH compiles, never
         for this project's own code: NodeType sources compile against TRUSTED_PLATFORM_ASSEMBLIES,
         so an assembly this portal does not reference is invisible to them — which is how
         Cornerstone/Pricing's Excel sample loader once failed on memex-cloud with `CS0234: the type
         or namespace name 'Import' does not exist in the namespace 'MeshWeaver'`.
         The module lane carries that surface now: MeshBuilder.InstallAssemblies registers an
         InstalledModuleAssembly per listed DLL and CompileReferences.ComposeWithModules adds each
         one to the reference set, so `MeshWeaver.Import.dll` in Modules:Assemblies IS the
         declaration. It is listed FIRST there — the reference set is composed from the installed
         modules, so it must precede anything that compiles against it. The bits ship via the
         modules/<Name>/ closure layout in MeshModulesPublish.targets. -->
  </ItemGroup>

  <!-- Ship nuget.config into the image so the runtime `#r "nuget:..."` resolver can
       resolve third-party packages a Code node references. Business rules / scopes are NOT
       part of the platform — they ship as a PLUGIN (MeshWeaver.Plugins/BusinessRules) that
       carries the scope generator source and injects it into node/script/markdown compilation.
       The platform (and the Doc partition) starts with zero business-rules dependency. -->
  <ItemGroup>
    <Content Include="..\..\..\nuget.config" Link="nuget.config" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- CI-baked prebuilt NodeType assemblies (#1660 WS1): when the invoking build passes
       -p:PrebuiltBakeDir=<dir> (the bake-output directory mw-plugin-test writes over the image's
       own shipped content), the bundle zips are laid into prebuilt/ beside the app, where
       ShippedPrebuiltBundles seeds them at boot BEFORE the dynamic-type sweep — pending=0 for
       shipped content, zero Roslyn on the pod. Inert when the property is unset (the default and
       every local build): the image simply ships no bundles and boot compiles as today.
       🚨 The bundles are only adoptable when they were produced by the SAME compilation that
       produced this publish's MeshWeaver.Graph.dll (the seeder's MVID gate) — bake in the same
       job, with the same version inputs, or the bundles are dead weight that declines wholesale. -->
  <ItemGroup Condition="'$(PrebuiltBakeDir)' != '' AND Exists('$(PrebuiltBakeDir)')">
    <Content Include="$(PrebuiltBakeDir)/**/*.zip"
             Link="prebuilt/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The run-numbered platform version ($(Version), e.g. 3.0.0-rc3.ci.3961) rides the container
       IMAGE CONFIG, never a compiled attribute: CI compile inputs are commit-deterministic
       (#1660 WS3 — the framework identity that lets CI-baked NodeType assemblies seed at boot
       must be equal between the Build-and-Test bake and this image build), so the run number
       cannot be baked into the assemblies. The runtime reads this variable first
       (PlatformBuildInfo / ShippedReleaseSeed.InstalledPlatformVersion) — the self-updater's
       tag comparison and the Admin/PlatformVersion node depend on the run number being visible. -->
  <ItemGroup Condition="'$(CIRun)' == 'true'">
    <ContainerEnvironmentVariable Include="MESHWEAVER_PLATFORM_VERSION" Value="$(Version)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Npgsql" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Azure.Data.Tables" />
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
  </ItemGroup>

  <Import Project="..\..\MeshModulesPublish.targets" />
</Project>
