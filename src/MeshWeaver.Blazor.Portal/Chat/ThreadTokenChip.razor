@* Wire into ThreadChatView's progress area (e.g. inside `.thread-exec-bar` or the
   `.thread-chat-status-row`) with:  <ThreadTokenChip ThreadPath="@threadPath" />
   — the context variable is the `threadPath` field on ThreadChatView. Renders as an
   inline metadata item (its own leading "·" separator) so it shares the status row
   with the harness · agent · model chips rather than dropping to a second line. *@
@namespace MeshWeaver.Blazor.Portal.Chat
@inject AccessService Access

@if (HasData)
{
    <span class="thread-token-chip">
        <span class="thread-token-chip-head">
            <span class="thread-token-chip-sep">·</span>
            <span class="thread-token-chip-label"
                  role="button"
                  tabindex="0"
                  title="@Access.Localize("chat.tokenUsageTooltip")"
                  @onclick="ToggleExpanded"
                  @onkeydown="OnLabelKeyDown">@ChipLabel</span>
        </span>

        @if (_expanded)
        {
            <span class="thread-token-chip-breakdown">
                @foreach (var row in _rows)
                {
                    <span class="thread-token-chip-row">
                        <span class="thread-token-chip-model" title="@row.Model">@row.Model</span>
                        <span title="@Access.Localize("chat.inputTokens")">↑@FormatCompact(row.Input)</span>
                        <span title="@Access.Localize("chat.outputTokens")">↓@FormatCompact(row.Output)</span>
                        @if (row.CacheRead > 0 || row.CacheWrite > 0)
                        {
                            <span title="@Access.Localize("chat.cachedTokens")">⚡@FormatCompact(row.CacheRead + row.CacheWrite)</span>
                        }
                    </span>
                }
            </span>
        }
    </span>
}
