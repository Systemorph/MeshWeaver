@using System.Text.Json
@using MeshWeaver.Mesh
@using MeshWeaver.Mesh.Security
@using MeshWeaver.Messaging
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IDisposable
@inject IMessageHub Hub
@inject AccessService AccessService
@inject IJSRuntime JSRuntime
@inject ILogger<BrowserPreferenceDetector> Logger

@* Renders nothing — a one-shot, invisible circuit-init hook that populates the signed-in
   user's browser-derived display preferences (time zone AND UI language) exactly once each
   (write-once). Mounted inside the portal shell's authenticated region so it only runs for a
   real signed-in user. Both preferences are read in a SINGLE interop call: they share a
   lifecycle, write-once semantics and trigger, so a second component would only buy a second
   round-trip. *@

@code {
    // Guards the one-shot: the browser read + write-once runs on the FIRST render only, never
    // on a hot render path.
    private bool _attempted;
    private IDisposable? _zoneSubscription;
    private IDisposable? _localeSubscription;

    /// <summary>
    /// On first render, reads the browser's IANA zone
    /// (<c>Intl.DateTimeFormat().resolvedOptions().timeZone</c>) and preferred language
    /// (<c>navigator.language</c>) and — for each, if the signed-in user's profile field is still
    /// empty — writes it once. The write-once guards (<see cref="TimeZonePreference"/>,
    /// <see cref="LocalePreference"/>) never overwrite an existing value, so a manual override or
    /// an earlier session's value is preserved.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _attempted)
            return;
        _attempted = true;

        // The resolved per-circuit identity (partition key == user node path, post-v10 root).
        // CircuitContext falls back to the persistent per-circuit value, so it survives the JS
        // await below even though the AsyncLocal doesn't flow across the interop hop.
        var ctx = AccessService.CircuitContext;
        var userPath = ctx?.ObjectId;
        if (ctx is null || ctx.IsVirtual || string.IsNullOrEmpty(userPath)
            || AccessService.LooksLikeHubPrincipal(userPath))
            return;

        string? detected;
        try
        {
            // Browser capability read — the sanctioned DOM-side async carve-out. One-shot;
            // eval is already used by the portal shell (window.dispatchEvent) so it is CSP-allowed.
            // Both values in one hop, tab-separated, so a missing one still parses positionally.
            detected = await JSRuntime.InvokeAsync<string?>(
                "eval",
                "Intl.DateTimeFormat().resolvedOptions().timeZone + '\\t' + (navigator.language || '')");
        }
        catch (Exception ex) when (ex is OperationCanceledException or JSDisconnectedException)
        {
            return; // Circuit went away mid-detection — nothing to do.
        }

        if (string.IsNullOrWhiteSpace(detected))
            return;

        var parts = detected.Split('\t');
        var detectedZone = parts.Length > 0 ? parts[0] : null;
        var detectedLocale = parts.Length > 1 ? parts[1] : null;

        // Reactive write-once against the live node stream (never await; carries the caller's
        // identity). Errors (e.g. the node not yet readable) are logged at Debug — this is a
        // best-effort default, not a hard requirement of the page render.
        _zoneSubscription = TimeZonePreference
            .PopulateOnce(Hub, userPath, detectedZone, Hub.JsonSerializerOptions)
            .Subscribe(
                _ => Logger.LogInformation(
                    "Auto-populated display time zone {Zone} for {UserPath}", detectedZone, userPath),
                ex => Logger.LogDebug(
                    ex, "Time-zone auto-detect skipped for {UserPath}", userPath));

        // An unsupported browser language deliberately writes NOTHING (LocalePreference.ShouldWrite
        // returns null), leaving the profile empty so a later-shipped translation applies
        // automatically instead of the user being pinned to a tag we would render in English anyway.
        _localeSubscription = LocalePreference
            .PopulateOnce(Hub, userPath, detectedLocale, Hub.JsonSerializerOptions)
            .Subscribe(
                _ => Logger.LogInformation(
                    "Auto-populated UI language {Locale} for {UserPath}", detectedLocale, userPath),
                ex => Logger.LogDebug(
                    ex, "Language auto-detect skipped for {UserPath}", userPath));
    }

    public void Dispose()
    {
        _zoneSubscription?.Dispose();
        _localeSubscription?.Dispose();
    }
}
