@using Microsoft.Extensions.Configuration
@inject IJSRuntime JsRuntime;
@inject IConfiguration Configuration
@inject AccessService Access

@if (!IsDevelopment && !string.IsNullOrEmpty(TrackingId))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@TrackingId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', '@TrackingId');
    </script>
}

<div id="meshweaver-cookie-banner" class="@(IsVisible ? "cookie-consent-banner" : "cookie-consent-banner hidden")">
    <div class="cookie-consent-content">
        <div class="cookie-consent-text">
            <FluentStack Orientation="Orientation.Vertical">
                <FluentLabel Typo="Typography.Body">
                    @Access.Localize("cookies.message")
                </FluentLabel>
            </FluentStack>
        </div>
        <div class="cookie-consent-buttons">
            <FluentButton id="meshweaver-cookie-accept" Appearance="Appearance.Accent" @onclick="AcceptCookies">
                @Access.Localize("cookies.accept")
            </FluentButton>
            <FluentButton Appearance="Appearance.Neutral" @onclick="RejectCookies">
                @Access.Localize("cookies.rejectNonEssential")
            </FluentButton>
        </div>
    </div>
</div>

@code {
    private bool IsVisible;
    private bool IsDevelopment;
    private string? TrackingId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        IsDevelopment = Configuration.GetValue<bool>("IsDevelopment");
        TrackingId = Configuration["GoogleAnalyticsTrackingId"];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user has already made a choice
            var consent = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "cookieConsent");
            if (string.IsNullOrEmpty(consent) && !IsDevelopment)
            {
                IsVisible = true;
                StateHasChanged();
            }
        }
    }

    private async Task AcceptCookies()
    {
        await JsRuntime.InvokeVoidAsync("localStorage.setItem", "cookieConsent", "accepted");
        IsVisible = false;
        StateHasChanged();
    }

    private async Task RejectCookies()
    {
        await JsRuntime.InvokeVoidAsync("localStorage.setItem", "cookieConsent", "rejected");
        IsVisible = false;
        StateHasChanged();

        // Disable analytics when rejected
        await JsRuntime.InvokeVoidAsync("disableAnalytics");
    }
}
