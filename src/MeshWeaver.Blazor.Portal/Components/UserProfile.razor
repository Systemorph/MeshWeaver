@inject AccessService Access
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.FluentUI.AspNetCore.Components

<AuthorizeView>
    <Authorized>
        <div class="profile-menu-container">
            @* The "clearly indicated while active" half of the quick toggle: a glyph in the header
               itself, not only inside the menu, so a presenter can see at a glance that the screen
               is up. Language-neutral icon + a translated tooltip. *@
            @if (PresentationModeOn)
            {
                <span class="presentation-indicator" title="@Access.Localize("presentation.indicator")"
                      aria-label="@Access.Localize("presentation.indicator")">
                    <FluentIcon Value="@(new Icons.Filled.Size20.Glasses())" Color="Color.Accent" />
                </span>
            }
            <FluentProfileMenu Initials="@initials"
                               EMail="@username"
                               FullName="@name"
                               ButtonSize="@ButtonSize"
                               FooterLink="">
                <HeaderTemplate>
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel>@Access.Localize("auth.loggedInAs")</FluentLabel>
                        <FluentSpacer />
                        <FluentButton Appearance="Appearance.Stealth" OnClick="Logout">@Access.Localize("common.signOut")</FluentButton>
                    </FluentStack>
                </HeaderTemplate>
                <ChildContent>
                    <FluentStack class="inner-persona-container" @onclick="NavigateToUserNode" Style="cursor: pointer;">
                        <FluentPersona Initials="@initials" ImageSize="@ImageSize" Class="inner-persona">
                            <div class="full-name">@name</div>
                            <div class="user-id">@username</div>
                        </FluentPersona>
                    </FluentStack>
                    @* Presentation mode (#1803): the quick toggle, right where a presenter looks
                       for it. Display-only and personal — it changes nothing for anyone else. *@
                    <FluentStack VerticalAlignment="VerticalAlignment.Center" Style="margin-top: 8px;">
                        <FluentButton Appearance="Appearance.Stealth"
                                      OnClick="TogglePresentationMode"
                                      Title="@Access.Localize("presentation.modeTooltip")"
                                      IconStart="@(new Icons.Regular.Size20.Glasses())">
                            @Access.Localize("presentation.mode") ·
                            @(PresentationModeOn ? Access.Localize("presentation.on") : Access.Localize("presentation.off"))
                        </FluentButton>
                    </FluentStack>
                    @if (showFrontendToggle)
                    {
                        <FluentStack VerticalAlignment="VerticalAlignment.Center" Style="margin-top: 8px;">
                            <FluentButton Appearance="Appearance.Stealth" OnClick="SwitchToNewFrontend">@Access.Localize("ui.tryNewFrontend")</FluentButton>
                        </FluentStack>
                    }
                    @* Platform info — What's New feed + About (exact build). *@
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="margin-top: 8px;">
                        <FluentButton Appearance="Appearance.Stealth" OnClick="NavigateToWhatsNew"
                                      IconStart="@(new Icons.Regular.Size20.Sparkle())">@Access.Localize("settings.whatsNew")</FluentButton>
                        <FluentButton Appearance="Appearance.Stealth" OnClick="NavigateToAbout"
                                      IconStart="@(new Icons.Regular.Size20.Info())">@Access.Localize("settings.about")</FluentButton>
                    </FluentStack>
                </ChildContent>
            </FluentProfileMenu>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="login-button-container">
            <FluentButton Appearance="Appearance.Stealth" OnClick="Login">@Access.Localize("common.signIn")</FluentButton>
        </div>
    </NotAuthorized>
</AuthorizeView>
