@inherits BlazorView<IContainerControl, ContainerView>

@foreach (var child in ViewModel.ResolveChildren(Area))
{
    @* 🚨 @key — a container child is identified by its AREA NAME, never by its position; see
       ViewModelExtensions.ResolveChildren for why (issue #732). *@
    <DispatchView @key="child.Key"
                  ViewModel="@(child.Area with { Area = child.ResolvedArea })"
                  Stream="@Stream"
                  Area="@child.ResolvedArea" />
}
