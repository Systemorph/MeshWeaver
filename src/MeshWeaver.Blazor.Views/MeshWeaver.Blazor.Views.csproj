<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- The components moved here from MeshWeaver.Blazor keep their ORIGINAL namespaces
         (MeshWeaver.Blazor.Components / .Components.Monaco): every typeof() in the view map, every
         consumer @using, and the react parity ratchet's type names stay valid. Only the pack's own
         entry points (ViewsExtensions / ViewsViewPackModuleAttribute) declare the
         MeshWeaver.Blazor.Views namespace explicitly. -->
    <RootNamespace>MeshWeaver.Blazor</RootNamespace>
    <StaticWebAssetBasePath>_content/MeshWeaver.Blazor.Views</StaticWebAssetBasePath>
    <Description>The default control views for MeshWeaver's Blazor shell: every framework control's standard Blazor renderer (buttons, markdown, editors, grids, navigation, file explorer, Monaco) plus the standard skin views. Ships as a module — list the DLL under Modules:Assemblies to activate; the base MeshWeaver.Blazor keeps only the base classes, the area-hosting machinery, and the escaped-HTML fallback.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshWeaver.Blazor\MeshWeaver.Blazor.csproj" />
    <!-- Direct on purpose — MeshWeaver.Application.Styles is a CANONICAL content-surface
         assembly; see the identity-fork note beside the base pack's own reference (#1814/#2021). -->
    <ProjectReference Include="..\MeshWeaver.Application.Styles\MeshWeaver.Application.Styles.csproj" />
  </ItemGroup>
</Project>
