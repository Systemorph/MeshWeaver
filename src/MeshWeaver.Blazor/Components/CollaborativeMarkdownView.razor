@using MeshWeaver.Blazor
@using MeshWeaver.Layout
@using MeshWeaver.Markdown
@using MeshWeaver.Mesh
@using MeshWeaver.Messaging
@using Microsoft.Extensions.Logging
@namespace MeshWeaver.Blazor.Components
@inherits BlazorView<CollaborativeMarkdownControl, CollaborativeMarkdownView>
@inject AccessService Access

<div class="collab-md-container @ViewModeClass" data-theme="@Mode.ToString().ToLower()" @ref="containerRef">
    @* Toolbar — comment filter. Tracked changes are already IN the document (they are projected from
       the version history), so there is nothing to "accept": the only action is Revert, per card. *@
    @if (HasCommentAnnotations)
    {
        <div class="collab-md-toolbar">
            <FluentSelect TOption="string"
                          Value="@CurrentCommentFilter"
                          ValueChanged="@OnCommentFilterChanged"
                          Label="@Access.Localize("comments.label")"
                          Style="min-width: 160px;">
                <FluentOption Value="Unresolved">@Access.Localize("ui.unresolved")</FluentOption>
                <FluentOption Value="All">@Access.Localize("comments.all")</FluentOption>
                <FluentOption Value="None">@Access.Localize("ui.noComments")</FluentOption>
            </FluentSelect>
        </div>
    }

    @* Split layout: content + annotation cards *@
    <div class="collab-md-split @(HasSideAnnotations ? "with-sidebar" : "")">
        <div class="collab-md-content markdown-annotations-container markdown-body" data-theme="@Mode.ToString().ToLower()" style="background-color: var(--neutral-layer-1);" @ref="contentRef">
            @((RenderFragment)RenderContentHtml)
        </div>

        @if (HasSideAnnotations)
        {
            <div class="collab-md-sidebar annotations-column" @onclick:stopPropagation="true">
                @foreach (var comment in SidebarComments)
                {
                    var id = comment.MarkerId!;
                    <div class="annotation-card annotation-for-@id annotation-type-comment @(comment.Status == CommentStatus.Resolved ? "resolved" : "") @(activeAnnotationId == id ? "active" : "")"
                         @onclick="() => HighlightAnnotation(id)">
                        <div class="comment-header">
                            <span class="comment-author">@comment.Author</span>
                            <span class="comment-time">@FormatTimeAgo(comment.CreatedAt, AccessService.ViewerZoneId())</span>
                            <div class="comment-actions">
                                @if (comment.Status != CommentStatus.Resolved)
                                {
                                    <button class="btn-resolve" title="@Access.Localize("ui.resolve")" @onclick="() => ResolveComment(id)" @onclick:stopPropagation="true">&#x2713;</button>
                                }
                                <button class="btn-delete" title="@Access.Localize("common.delete")" @onclick="() => DeleteComment(id)" @onclick:stopPropagation="true">&#x2715;</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(comment.HighlightedText))
                        {
                            <div class="comment-quote">"@Truncate(comment.HighlightedText, 60)"</div>
                        }
                        @if (!string.IsNullOrEmpty(comment.Text))
                        {
                            <div class="comment-text">@comment.Text</div>
                        }
                    </div>
                }

                @* Tracked-change cards — the redline computed from the version history. Each card is
                   an edit that already landed, so the one action is Revert (itself a versioned write). *@
                @foreach (var change in SidebarChanges)
                {
                    var id = change.MarkerId!;
                    <div class="annotation-card annotation-for-@id annotation-type-@change.ChangeType.ToString().ToLowerInvariant() @(activeAnnotationId == id ? "active" : "")"
                         @onclick="() => HighlightAnnotation(id)">
                        <div class="collab-md-card-header">
                            <div class="collab-md-card-meta">
                                @if (!string.IsNullOrEmpty(change.Author))
                                {
                                    <span class="collab-md-author">@change.Author</span>
                                }
                                <span class="collab-md-time">@ChangeLabel(change.ChangeType) · @FormatTimeAgo(change.CreatedAt, AccessService.ViewerZoneId())</span>
                            </div>
                            @if (BoundCanEdit)
                            {
                                <div class="collab-md-card-actions">
                                    <button class="btn-revert" title="@Access.Localize("ui.revert")" @onclick="() => OnRevertChange(id)" @onclick:stopPropagation="true">↩</button>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(change.OriginalText))
                        {
                            <div class="collab-md-quote quote-delete">"@Truncate(change.OriginalText, 60)"</div>
                        }
                        @if (!string.IsNullOrEmpty(change.NewText))
                        {
                            <div class="collab-md-quote quote-insert">"@Truncate(change.NewText, 60)"</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (string.IsNullOrWhiteSpace(_processedHtml))
    {
        <p style="color: var(--neutral-foreground-hint); font-style: italic;">@Access.Localize("ui.noContentYet")</p>
    }

    @* Comment input dialog — appears when user selects text and clicks Comment *@
    @if (_showCommentInput)
    {
        <div class="comment-input-overlay" @onclick="CancelSelectionComment">
            <div class="comment-input-dialog" @onclick:stopPropagation="true">
                <div class="comment-input-header">@Access.Localize("comments.add")</div>
                @if (!string.IsNullOrEmpty(_pendingSelectionText))
                {
                    <div class="comment-input-quote">&ldquo;@Truncate(_pendingSelectionText, 120)&rdquo;</div>
                }
                <textarea class="comment-input-textarea" @bind="_pendingCommentText" @bind:event="oninput" placeholder="Write your comment..." rows="3"></textarea>
                <div class="comment-input-actions">
                    <button class="comment-btn comment-btn-cancel" @onclick="CancelSelectionComment">@Access.Localize("common.cancel")</button>
                    <button class="comment-btn comment-btn-submit" @onclick="SubmitSelectionComment">@Access.Localize("comments.add")</button>
                </div>
            </div>
        </div>
    }

    @* Bottom page comment section — suppressed for @@ embeds (HideAnnotations) and for a version
       comparison, whose subject is what changed, not the conversation about the page. *@
    @if (!BoundHideAnnotations && !IsComparing && !string.IsNullOrEmpty(BoundNodePath))
    {
        <div class="page-comment-section">
            @if (_showPageCommentInput)
            {
                <div class="page-comment-form">
                    <textarea class="comment-input-textarea" @bind="_pageCommentText" @bind:event="oninput" placeholder="Write your comment..." rows="3"></textarea>
                    <div class="comment-input-actions">
                        <button class="comment-btn comment-btn-cancel" @onclick="CancelPageComment">@Access.Localize("common.cancel")</button>
                        <button class="comment-btn comment-btn-submit" @onclick="SubmitPageComment">@Access.Localize("comments.add")</button>
                    </div>
                </div>
            }
            else
            {
                <button class="add-page-comment-btn" @onclick="StartPageComment">+ Add Comment</button>
            }
        </div>
    }
</div>
