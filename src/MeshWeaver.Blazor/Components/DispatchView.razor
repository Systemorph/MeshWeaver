@using Microsoft.Extensions.DependencyInjection
@using static Microsoft.Extensions.Logging.LoggerExtensions;
@using MeshWeaver.Layout.Client
@using Microsoft.AspNetCore.Components
@inherits BlazorView<UiControl, DispatchView>
@inject NavigationManager NavigationManager
@inject AccessService Access

@if(ViewModel is RedirectControl redirect)
{
    @* Handle redirect immediately *@
}
else if(ViewDescriptor != null)
{
    <CascadingValue Value=@ViewModelDataContext Name="DataContext">
        @* Every UiControl is rendered through here, so this is the ONE place to contain a
           render-time exception. A control that throws inside BuildRenderTime (e.g. an enum
           property bound to an unparseable literal in DataGridView.RenderPropertyColumn) would
           otherwise escape the render, tear down the whole Blazor circuit, and hang the page
           with no feedback (atioz 2026-06-21). The ErrorBoundary catches it, SURFACES the
           message in the control's own slot, and lets the rest of the page render. *@
        <ErrorBoundary>
            <ChildContent>
                @((RenderFragment)(builder =>
                {
                    builder.OpenComponent(0, ViewDescriptor.Type);

                    // 🚨 A LayoutAreaControl is not a passive view-model: the LayoutAreaView it
                    // renders OWNS a synchronization stream whose identity is (Address, Reference),
                    // plus the dialog/progress streams reduced off it and a whole already-rendered
                    // child subtree bound to it. Without a key, changing ONLY the Reference on a
                    // control that stays in the same slot is delivered as a parameter update to the
                    // RETAINED component, which then has to hot-swap that live stream underneath
                    // itself and its subtree — the freeze of #733 (server kept advancing, DOM stayed
                    // on the previous emission). Keying on the stream identity makes a reference (or
                    // address) change what it actually is: a DIFFERENT area — the old subtree is
                    // unmounted (disposing its stream through the normal DisposeAsync path) and a
                    // fresh one mounts. An unchanged identity keeps the same instance, so nothing
                    // remounts on ordinary re-renders. No sibling can collide: this component is the
                    // only frame in this fragment.
                    // The routed page mounts LayoutAreaView DIRECTLY (ApplicationPage / AreaPage), so
                    // its deliberate keep-last-good-across-navigation behaviour is untouched.
                    if (ViewModel is LayoutAreaControl embeddedArea)
                    {
                        builder.SetKey(embeddedArea.GetStreamIdentity());
                    }

                    var index = 0;

                    foreach (var parameter in ViewDescriptor.Parameters)
                    {
                        builder.AddAttribute(++index, parameter.Key, parameter.Value);
                    }

                    builder.CloseComponent();
                }))
            </ChildContent>
            <ErrorContent Context="renderError">
                <div class="meshweaver-render-error"
                     style="padding:0.75rem;border:1px solid var(--error,#d13438);border-radius:4px;background:rgba(209,52,56,0.08);color:var(--error,#d13438);font-size:0.875rem">
                    <strong>@Access.Localize("error.viewFailed")</strong>
                    <div style="margin-top:0.25rem;white-space:pre-wrap;font-family:monospace">@renderError.Message</div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </CascadingValue>
}

@code
{
    private ViewDescriptor? ViewDescriptor { get; set; }
    private string? ViewModelDataContext { get; set; }
    public override async Task SetParametersAsync(ParameterView parameters)
    {
        await base.SetParametersAsync(parameters);
        
        // Handle redirect control directly
        if (ViewModel is RedirectControl redirectControl)
        {
            if (redirectControl.Href is string href)
            {
                Logger.LogDebug($"Redirecting from Area {Area} to {href}");
                NavigationManager.NavigateTo(href);
                return;
            }
        }
        
        var client = Hub.ServiceProvider.GetRequiredService<ILayoutClient>();
        ViewDescriptor = client.GetViewDescriptor(ViewModel, Stream, Area);
        ViewModelDataContext = ViewModel?.DataContext  != null 
            ? WorkspaceReference.Decode(ViewModel.DataContext).ToString() 
            : DataContext;
        Logger.LogDebug($"Rendering Area {Area} to View {ViewDescriptor?.Type.Name}");
    }
}