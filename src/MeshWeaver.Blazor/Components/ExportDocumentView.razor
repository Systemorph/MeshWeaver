@using System.Reactive.Linq
@using System.Reactive.Threading.Tasks
@using System.Text.Json
@using MeshWeaver.Data
@using MeshWeaver.Layout
@using MeshWeaver.Markdown.Export.Configuration
@using MeshWeaver.Markdown.Export.Messaging
@using MeshWeaver.Messaging
@using MeshWeaver.Mesh
@using MeshWeaver.Mesh.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@inherits BlazorView<ExportDocumentControl, ExportDocumentView>
@inject AccessService Access

<div class="export-document-view" style="max-width: 720px;">
    <h2 style="margin-top: 0;">Export @(_title)</h2>
    <p style="color: var(--neutral-foreground-hint); margin-bottom: 24px;">
        Export <strong>@(NodeName ?? SourcePath)</strong> as a @_formatLabel document.
    </p>

    @if (!_isExporting && string.IsNullOrEmpty(_error) && !_done)
    {
        <div style="display: flex; flex-direction: column; gap: 12px;">

            <div>
                <label><strong>@Access.Localize("export.documentTitle")</strong></label>
                <FluentTextField @bind-Value="_title" Style="width: 100%;" />
            </div>

            @* Fidelity picker — shown only when the server confirmed this deployment can do it
               (a Deck AND a headless browser present). No browser ⇒ no choice to get wrong. *@
            @if (PixelFidelityAvailable)
            {
                <div>
                    <label><strong>@Access.Localize("export.fidelity")</strong></label>
                    <FluentRadioGroup Name="export-fidelity"
                                      Value="@_fidelity"
                                      ValueChanged="@((ExportFidelity v) => _fidelity = v)"
                                      TValue="ExportFidelity"
                                      Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical">
                        <FluentRadio Value="@ExportFidelity.Content">@Access.Localize("export.fidelityContent")</FluentRadio>
                        <FluentRadio Value="@ExportFidelity.Pixel">@Access.Localize("export.fidelityPixel")</FluentRadio>
                    </FluentRadioGroup>
                    @if (_fidelity == ExportFidelity.Pixel)
                    {
                        <small style="color: var(--neutral-foreground-hint);">
                            @Access.Localize("export.fidelityPixelHint")
                        </small>
                    }
                </div>
            }

            @* A pixel-faithful export IS the slides — the browser prints the deck's own stage, so
               there is no document model to hang a cover page, a table of contents, page-break
               rules or a running header on. Hide those rather than leave controls on screen that
               would silently do nothing. *@
            @* Email-safe HTML has no pages, so every page-model option below (cover, table of
               contents, page breaks, running header/footer) would silently do nothing. Hide them
               rather than show controls that cannot take effect — same reasoning as the pixel
               branch above. Including child nodes DOES still apply and stays visible. *@
            @if (_format == ExportFormat.Html)
            {
                <small style="color: var(--neutral-foreground-hint);">
                    @Access.Localize("export.emailHint")
                </small>
            }

            @if (_isPaged)
            {
                <div>
                    <label><strong>@Access.Localize("export.corporateIdentity")</strong></label>
                    <FluentTextField @bind-Value="_brandNodePath"
                                     Placeholder="Brand/Systemorph"
                                     Style="width: 100%;" />
                    <small style="color: var(--neutral-foreground-hint);">
                        @Access.Localize("export.corporateIdentityHint")
                    </small>
                </div>

                <FluentCheckbox Value="_coverPage" ValueChanged="@((bool v) => _coverPage = v)" Label="@Access.Localize("export.brandedCover")" />
                <FluentCheckbox Value="_toc" ValueChanged="@((bool v) => _toc = v)" Label="@Access.Localize("export.tableOfContents")" />
                <FluentCheckbox Value="_pbH1" ValueChanged="@((bool v) => _pbH1 = v)" Label="@Access.Localize("export.pageBreakSection")" />
                <FluentCheckbox Value="_pbH2" ValueChanged="@((bool v) => _pbH2 = v)" Label="@Access.Localize("export.pageBreakSubsection")" />
            }

            @if (_fidelity != ExportFidelity.Pixel && HasDescendants)
            {
                <FluentCheckbox Value="_includeChildren"
                                ValueChanged="@((bool v) => _includeChildren = v)"
                                Label="@Access.Localize("export.includeChildren")" />
                @if (_includeChildren && _isPaged)
                {
                    <FluentCheckbox Value="_pbChildren"
                                    ValueChanged="@((bool v) => _pbChildren = v)"
                                    Label="@Access.Localize("export.pageBreakChildren")"
                                    Style="margin-left: 24px;" />
                }
            }

            @if (_isPaged)
            {
                <div>
                    <label><strong>@Access.Localize("export.headerText")</strong></label>
                    <FluentTextField @bind-Value="_header" Style="width: 100%;" />
                </div>

                <div>
                    <label><strong>@Access.Localize("export.footerText")</strong></label>
                    <FluentTextField @bind-Value="_footer" Style="width: 100%;" />
                </div>
            }

            <div style="margin-top: 16px;">
                <FluentButton Appearance="Microsoft.FluentUI.AspNetCore.Components.Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size16.ArrowExport())"
                              OnClick="@ExportAsync">
                    @Access.Localize("export.exportAndDownload")
                </FluentButton>
            </div>
        </div>
    }

    @if (_isExporting)
    {
        <FluentProgress Visible="true" />
        <p style="margin-top: 8px; color: var(--neutral-foreground-hint);">@Access.Localize("export.generating")</p>
    }

    @if (_done)
    {
        <FluentCard Style="padding: 16px; margin-top: 16px;">
            <h3 style="color: var(--success); margin: 0 0 12px 0;">@Access.Localize("export.complete")</h3>
            <p>@Access.Localize("export.downloaded")</p>
            <div style="margin-top: 16px; display: flex; gap: 8px;">
                <FluentButton Appearance="Microsoft.FluentUI.AspNetCore.Components.Appearance.Accent"
                              OnClick="@Reset">@Access.Localize("export.again")</FluentButton>
            </div>
        </FluentCard>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentCard Style="padding: 16px; margin-top: 16px; border-left: 4px solid var(--error);">
            <p style="color: var(--error); margin: 0;">@_error</p>
        </FluentCard>
        <div style="margin-top: 16px;">
            <FluentButton Appearance="Microsoft.FluentUI.AspNetCore.Components.Appearance.Neutral"
                          OnClick="@Reset">@Access.Localize("common.retry")</FluentButton>
        </div>
    }
</div>

@code
{
    private string? SourcePath;
    private string? NodeName;
    private bool HasDescendants;
    private bool PixelFidelityAvailable;

    private ExportFidelity _fidelity = ExportFidelity.Content;

    private string _title = "";
    private string _brandNodePath = "";
    private string _header = "";
    private string _footer = "";

    private bool _coverPage = true;
    private bool _toc = true;
    private bool _pbH1 = true;
    private bool _pbH2;
    private bool _includeChildren;
    private bool _pbChildren = true;

    private bool _isExporting;
    private bool _done;
    private string? _error;

    private ExportFormat _format = ExportFormat.Pdf;

    /// <summary>
    /// Whether the chosen output has PAGES. Only a paged format can honour a cover page, a table
    /// of contents, page-break rules or a running header/footer.
    /// </summary>
    private bool _isPaged => _fidelity != ExportFidelity.Pixel && _format != ExportFormat.Html;
    private string _formatLabel = "PDF";

    private bool _initialized;

    protected override void BindData()
    {
        base.BindData();
        SourcePath = ViewModel?.SourcePath;
        NodeName = ViewModel?.NodeName;
        HasDescendants = ViewModel?.HasDescendants ?? false;
        // Capability, not a user edit — it arrives on a LATER emission than the seed control
        // (the browser probe is async), so it is refreshed on every bind, never gated on
        // _initialized. When it turns false again the picker disappears and Content is used.
        PixelFidelityAvailable = ViewModel?.PixelFidelityAvailable ?? false;
        if (!PixelFidelityAvailable)
            _fidelity = ExportFidelity.Content;

        // Only set defaults on first bind — avoid overwriting user edits on subsequent reactive updates.
        if (!_initialized)
        {
            _title = NodeName ?? SourcePath ?? "Document";
            _format = ViewModel?.DefaultFormat?.ToLowerInvariant() switch
            {
                "docx" => ExportFormat.Docx,
                "html" => ExportFormat.Html,
                _ => ExportFormat.Pdf
            };
            _formatLabel = _format switch
            {
                ExportFormat.Docx => "DOCX",
                // Named for what it is FOR, not its extension — the point of this format is that
                // it can be pasted or sent as an email with its embedded views already rendered.
                ExportFormat.Html => "HTML",
                _ => "PDF"
            };
            _initialized = true;
        }
    }

    private void ExportAsync()
    {
        if (string.IsNullOrEmpty(SourcePath)) return;

        _isExporting = true;
        _error = null;
        _done = false;
        StateHasChanged();

        var options = new DocumentExportOptions
        {
            Format = _format,
            Fidelity = _fidelity,
            Title = string.IsNullOrWhiteSpace(_title) ? null : _title,
            BrandNodePath = string.IsNullOrWhiteSpace(_brandNodePath) ? null : _brandNodePath,
            CoverPage = _coverPage,
            TableOfContents = _toc,
            PageBreakBeforeH1 = _pbH1,
            PageBreakBeforeH2 = _pbH2,
            IncludeChildren = _includeChildren,
            PageBreakBetweenChildren = _pbChildren,
            HeaderOverride = string.IsNullOrWhiteSpace(_header) ? null : _header,
            FooterOverride = string.IsNullOrWhiteSpace(_footer) ? null : _footer
        };

        // Two-step subscription per the just-start dispatch contract:
        //   1. Observe the ExportDocumentResponse — handler returns immediately
        //      with the activity path; no wait-for-terminal in the hub handler.
        //   2. Subscribe to the activity stream, project to ActivityLog,
        //      filter on terminal status, take(1), deserialize the rendered
        //      bytes from ActivityLog.ReturnValue, trigger the browser download.
        // Pure observable composition — no `await` on hub-touching streams.
        Hub.Observe(
                new ExportDocumentRequest(SourcePath, options),
                o => o.WithTarget(new MeshWeaver.Messaging.Address(SourcePath)))
            .Take(1)
            .SelectMany(dispatch =>
            {
                var msg = dispatch.Message;
                if (!string.IsNullOrEmpty(msg.Error))
                    return Observable.Throw<ActivityLog>(new InvalidOperationException(msg.Error));
                if (string.IsNullOrEmpty(msg.ActivityPath))
                    return Observable.Throw<ActivityLog>(
                        new InvalidOperationException("Export handler returned no activity path"));

                // Subscribe to the activity node via IMeshNodeStreamCache —
                // process-wide shared handle; the export progress GUI elsewhere
                // joins the same upstream. See Doc/GUI/ItemTemplateMeshNodeStreamBinding.
                var cache = Hub.ServiceProvider.GetRequiredService<IMeshNodeStreamCache>();
                return cache.GetStream(msg.ActivityPath, Hub.JsonSerializerOptions)
                    .Select(n => n.ContentAs<ActivityLog>(Hub.JsonSerializerOptions))
                    .Where(log => log is not null && log.Status != ActivityStatus.Running)
                    .Take(1)
                    .Select(log => log!);
            })
            .Subscribe(
                terminal => _ = InvokeAsync(() => OnExportTerminalAsync(terminal)),
                ex => _ = InvokeAsync(() => OnExportErrorAsync(ex.Message)));
    }

    private async Task OnExportTerminalAsync(ActivityLog terminal)
    {
        try
        {
            if (terminal.Status == ActivityStatus.Succeeded
                && terminal.ReturnValue is { } el)
            {
                var rendered = el.Deserialize<RenderedDocument>(Hub.JsonSerializerOptions);
                if (rendered is { } r && r.Content.Length > 0)
                {
                    using var ms = new MemoryStream(r.Content);
                    using var streamRef = new DotNetStreamReference(ms);
                    await JSRuntime.InvokeVoidAsync("meshweaverDownloadFileFromStream", r.FileName, streamRef);
                    _done = true;
                }
                else
                {
                    _error = "Export script returned no content.";
                }
            }
            else
            {
                var lastError = terminal.Messages.LastOrDefault(m => m.LogLevel >= Microsoft.Extensions.Logging.LogLevel.Warning)?.Message;
                _error = lastError ?? $"Export {terminal.Status}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private void OnExportErrorAsync(string message)
    {
        _error = $"Export failed: {message}";
        _isExporting = false;
        StateHasChanged();
    }

    private void Reset()
    {
        _done = false;
        _error = null;
    }
}
