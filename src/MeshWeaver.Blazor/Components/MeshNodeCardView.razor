@using MeshWeaver.Graph
@using Microsoft.FluentUI.AspNetCore.Components
@inherits BlazorView<MeshNodeCardControl, MeshNodeCardView>

@if (DisableNavigation)
{
    @CardContent
}
else if (!string.IsNullOrEmpty(Href))
{
    @* External link-preview card (OgCard): a real anchor to the absolute URL, new tab. *@
    <a href="@Href" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit; display: block; width: 100%; box-sizing: border-box;">
        @CardContent
    </a>
}
else
{
    <a href="/@NodePath" style="text-decoration: none; color: inherit; display: block; width: 100%; box-sizing: border-box;">
        @CardContent
    </a>
}

@code {
    private string NodePath { get; set; } = "";
    private string? Title { get; set; }
    private string? Description { get; set; }
    private string? ImageUrl { get; set; }
    private string? Href { get; set; }
    private bool IsInlineSvg => ImageUrl?.TrimStart().StartsWith("<svg", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsEmoji => !string.IsNullOrEmpty(ImageUrl) && !IsInlineSvg && !ImageUrl.Contains('/') && !ImageUrl.StartsWith("data:");
    private string? ItemArea { get; set; }
    private bool DisableNavigation { get; set; }

    private string Initial => !string.IsNullOrEmpty(Title) ? Title[0].ToString().ToUpper() : "?";

    // The card IS the control's box, so the author's Class/Style land here rather than on the <a> that
    // wraps it for navigation (a transparent display:block pass-through). Composed as single
    // expressions because a COMPONENT attribute — unlike a plain HTML one — cannot mix markup and C#.
    private string CardClass => $"mesh-node-card{ClassSuffix}";
    private string CardStyle => $"cursor: pointer; width: 100%; display: block; box-sizing: border-box;{StyleSuffix}";

    /// <summary>
    /// Hard cap on the title so a very long name can never overflow the card (a backstop to the
    /// CSS single-line ellipsis, which can't kick in when a parent doesn't constrain width).
    /// </summary>
    private string TruncatedTitle => Title?.Length > 64
        ? Title[..63].TrimEnd() + "…"
        : Title ?? "";

    private string TruncatedDescription => Description?.Length > 100
        ? Description[..97] + "..."
        : Description ?? "";

    /// <summary>
    /// The embedded-area variant of the card. This branch renders NO element of its own — the area is a
    /// different control that applies Style/Class to its own container — so the card's declaration is
    /// FORWARDED to it rather than wrapped around it, the same way <c>PropertyView</c>/<c>EditFormView</c>
    /// let the terminal view apply them. Forwarded only when actually declared, so an undeclared card
    /// produces the identical control record as before.
    /// </summary>
    private LayoutAreaControl GetLayoutArea()
    {
        var area = new LayoutAreaControl(NodePath, new LayoutAreaReference(ItemArea!))
            .WithShowProgress(false);
        if (!string.IsNullOrWhiteSpace(Style))
            area = area.WithStyle(Style);
        if (!string.IsNullOrWhiteSpace(Class))
            area = area.WithClass(Class);
        return area;
    }

    private RenderFragment CardContent => __builder =>
    {
        if (!string.IsNullOrEmpty(ItemArea))
        {
            <LayoutAreaView ViewModel="@GetLayoutArea()" Stream="@Stream" Area="@($"card-{NodePath}-{ItemArea}")" />
        }
        else
        {
            <FluentCard Class="@CardClass" Style="@CardStyle">
                <div class="mesh-node-card-content">
                    @if (!string.IsNullOrEmpty(ImageUrl))
                    {
                        @if (IsInlineSvg)
                        {
                            <div class="mesh-node-card-image" style="display: flex; align-items: center; justify-content: center;">@((MarkupString)ImageUrl)</div>
                        }
                        else if (IsEmoji)
                        {
                            <div class="mesh-node-card-placeholder" style="background: transparent; font-size: 32px;">@ImageUrl</div>
                        }
                        else
                        {
                            <img src="@ImageUrl" alt="@Title" class="mesh-node-card-image" />
                        }
                    }
                    else
                    {
                        <div class="mesh-node-card-placeholder">@Initial</div>
                    }
                    <div class="mesh-node-card-text">
                        <div class="mesh-node-card-title" title="@Title">@TruncatedTitle</div>
                        @if (!string.IsNullOrEmpty(Description))
                        {
                            <div class="mesh-node-card-description">@TruncatedDescription</div>
                        }
                    </div>
                </div>
            </FluentCard>
        }
    };

    protected override void BindData()
    {
        base.BindData();
        DataBind(ViewModel.NodePath, x => x.NodePath);
        DataBind(ViewModel.Title, x => x.Title);
        DataBind(ViewModel.Description, x => x.Description);
        DataBind(ViewModel.ImageUrl, x => x.ImageUrl);
        DataBind(ViewModel.Href, x => x.Href);
        DataBind(ViewModel.ItemArea, x => x.ItemArea);
        DataBind(ViewModel.DisableNavigation, x => x.DisableNavigation);
    }
}
