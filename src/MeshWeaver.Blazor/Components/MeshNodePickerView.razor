@using MeshWeaver.Layout.Catalog
@using MeshWeaver.Mesh
@inherits FormComponentBase<MeshNodePickerControl, MeshNodePickerView, string>
@inject AccessService Access

<div class="mesh-node-picker@(IsThin ? " mesh-node-picker--thin" : "")">
    @if (Label != null)
    {
        <FluentLabel Weight="Microsoft.FluentUI.AspNetCore.Components.FontWeight.Bold" Style="margin-bottom: 4px;">@Label</FluentLabel>
    }

    @if (!string.IsNullOrEmpty(Value) && _selectedNode != null && !_isSearchOpen)
    {
        <div class="mesh-node-picker-selected" @onclick="OpenSearch">
            <div class="mesh-node-picker-selected-card">
                @{ var selInitial = GetInitial(_selectedNode); }
                @RenderAvatar(_selectedNode, selInitial)
                <div class="mesh-node-picker-info">
                    <div class="mesh-node-picker-name" title="@_selectedNode.Path">
                        @(_selectedNode.Name ?? _selectedNode.Id)
                        @{ var selEmail = GetEmail(_selectedNode); }
                        @if (!string.IsNullOrEmpty(selEmail))
                        {
                            <span class="mesh-node-picker-email">&lt;@selEmail&gt;</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_selectedNode.Category))
                {
                    <span class="mesh-node-picker-category">@_selectedNode.Category</span>
                }
            </div>
            <button type="button" class="mesh-node-picker-clear" @onclick="ClearSelection" @onclick:stopPropagation="true">
                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
            </button>
        </div>
    }
    else
    {
        <input @key="_inputKey"
               @ref="_textFieldElement"
               type="text"
               class="mesh-node-picker-input"
               @oninput="OnSearchInput"
               @onkeydown="OnKeyDown"
               @onkeydown:stopPropagation="true"
               placeholder="@(Placeholder ?? "Search...")"
               disabled="@Disabled"
               autocomplete="off"
               @onfocus="OpenSearch" />
    }

    @if (_isSearchOpen)
    {
        <div class="mesh-node-picker-overlay" @onclick="CloseSearch"></div>
        <div class="mesh-node-picker-dropdown@(OpensUp ? " mesh-node-picker-dropdown--top" : "")">
            @if (_isLoading)
            {
                <FluentProgressRing Style="margin: 16px auto; display: block;" />
            }
            else if (_results.Count == 0)
            {
                <div class="mesh-node-picker-empty">@Access.Localize("empty.noItemsFound")</div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(ViewModel?.EmptyOptionLabel))
                {
                    var isEmptySelected = string.IsNullOrEmpty(Value);
                    <div class="mesh-node-picker-item @(isEmptySelected ? "mesh-node-picker-item-selected" : "")"
                         @onclick="ClearSelection">
                        <div class="mesh-node-picker-avatar" style="background: var(--neutral-stroke-rest); color: var(--neutral-foreground-hint);">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Globe())" />
                        </div>
                        <div class="mesh-node-picker-item-info">
                            <div class="mesh-node-picker-item-name">@ViewModel.EmptyOptionLabel</div>
                            <div class="mesh-node-picker-item-type">@Access.Localize("search.noNamespace")</div>
                        </div>
                    </div>
                }
                @for (var i = 0; i < _results.Count; i++)
                {
                    var node = _results[i];
                    var isSelected = node.Path == Value;
                    var isHighlighted = i == _highlightedIndex;
                    var initial = GetInitial(node);
                    <div class="mesh-node-picker-item @(isSelected ? "mesh-node-picker-item-selected" : "") @(isHighlighted ? "mesh-node-picker-item-highlighted" : "")"
                         @onclick="() => SelectNode(node)">
                        @RenderAvatar(node, initial)
                        <div class="mesh-node-picker-item-info">
                            <div class="mesh-node-picker-item-name" title="@node.Path">
                                @(node.Name ?? node.Id)
                                @{ var itemEmail = GetEmail(node); }
                                @if (!string.IsNullOrEmpty(itemEmail))
                                {
                                    <span class="mesh-node-picker-email">&lt;@itemEmail&gt;</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(node.Category))
                        {
                            <span class="mesh-node-picker-item-category">@node.Category</span>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private static string GetInitial(MeshNode node)
    {
        var name = node.Name ?? node.Id;
        return !string.IsNullOrEmpty(name) ? name[0].ToString().ToUpper() : "?";
    }

    /// <summary>
    /// The node's email address, when it has one. Two similarly-named contacts are otherwise
    /// indistinguishable in the dropdown, and someone picking a recipient for a mail wants to see
    /// the address the mail will actually go to — so a suggestion reads "First Last &lt;a@b.com&gt;".
    /// Probed off the raw content the way the avatar is: the picker's query carries no `select:`,
    /// so content comes back whole.
    /// </summary>
    private static string? GetEmail(MeshNode node)
    {
        if (node.Content is System.Text.Json.JsonElement json
            && json.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            if (json.TryGetProperty("email", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.String)
                return e.GetString();
            if (json.TryGetProperty("Email", out var E) && E.ValueKind == System.Text.Json.JsonValueKind.String)
                return E.GetString();
        }
        return null;
    }

    private string? GetImageUrl(MeshNode node)
    {
        if (node.Content is System.Text.Json.JsonElement json)
        {
            if (json.TryGetProperty("avatar", out var a) && a.ValueKind == System.Text.Json.JsonValueKind.String) return a.GetString();
            if (json.TryGetProperty("Avatar", out var A) && A.ValueKind == System.Text.Json.JsonValueKind.String) return A.GetString();
            if (json.TryGetProperty("logo", out var l) && l.ValueKind == System.Text.Json.JsonValueKind.String) return l.GetString();
            if (json.TryGetProperty("Logo", out var L) && L.ValueKind == System.Text.Json.JsonValueKind.String) return L.GetString();
        }
        return MeshNodeImageHelper.ResolveNodeIcon(node);
    }

    private RenderFragment RenderAvatar(MeshNode node, string initial)
    {
        var imageUrl = GetImageUrl(node);
        if (!string.IsNullOrEmpty(imageUrl))
        {
            if (imageUrl.TrimStart().StartsWith("<svg", StringComparison.OrdinalIgnoreCase))
                return @<div class="mesh-node-picker-avatar" style="background: transparent; font-size: 20px; padding: 2px;">@((MarkupString)imageUrl)</div>;
            if (!imageUrl.Contains('/') && !imageUrl.StartsWith("data:"))
                return @<div class="mesh-node-picker-avatar" style="background: transparent; font-size: 24px;">@imageUrl</div>;
            if (imageUrl.EndsWith(".svg", StringComparison.OrdinalIgnoreCase))
                return @<div style="--icon-url: url('@imageUrl')" class="mesh-node-picker-avatar-icon"></div>;
            return @<img src="@imageUrl" alt="@(node.Name ?? node.Id)" class="mesh-node-picker-avatar-img" />;
        }
        return @<div class="mesh-node-picker-avatar">@initial</div>;
    }
}
