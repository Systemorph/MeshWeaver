@inherits BlazorView<NamedAreaControl, NamedAreaView>
@using MeshWeaver.Layout
@*
    🚨 This view deliberately does NOT apply its own Style/Class, and that is a decision, not the
    omission #1297 swept up elsewhere. A NamedAreaControl is a REFERENCE to an area, not a box: in the
    steady state below it renders exactly one thing — <DispatchView> on the resolved RootControl — and
    that control applies its own Style/Class to its own element. It therefore belongs with the other
    pure-indirection views (DispatchView, EditFormView, PropertyView, ContainerView), not with the
    views that own a box.

    Giving it a wrapper would be the blanket-wrapper regression #1288 refused, on the single most
    travelled path in the UI: every layout area reaches the DOM through here (LayoutAreaView), as does
    every tab and dialog content area, so one extra block box would land around all of them.

    The markup that IS emitted above the DispatchView is the not-yet-loaded placeholder (skeleton /
    spinner). Styling that instead would apply the author's declaration to a spinner and then remove it
    when the content arrives — a visible restructure mid-flight, which is exactly the failure mode the
    "gate on the declaration, not the resolved value" rule exists to avoid.

    If a real call site ever needs a styled named area, the fix is to FORWARD the declaration onto
    RootControl (as MeshNodeCardView does for its embedded area), NOT to introduce an element here.
*@
@using HorizontalAlignment = Microsoft.FluentUI.AspNetCore.Components.HorizontalAlignment
@using Orientation = Microsoft.FluentUI.AspNetCore.Components.Orientation
@using VerticalAlignment = Microsoft.FluentUI.AspNetCore.Components.VerticalAlignment

@if (Top && PageTitle is not null)
{
    <PageTitle>@PageTitle</PageTitle>
}

@if (Top && MetaAttributes is not null)
{
    <HeadContent>
        @foreach (var kvp in @MetaAttributes)
        {
            @* Open Graph is addressed by `property`, not `name` — a scraper (LinkedIn, Slack,
               iMessage, Facebook) reading og:* looks for property= and ignores name=. Twitter's
               own tags stay name=. Emitting the right attribute per key is the whole difference
               between a link that unfurls into a card and one that renders as a bare URL. *@
            @if (IsOpenGraph(kvp.Key))
            {
                <meta property="@kvp.Key" content="@AbsoluteMetaValue(kvp.Key, kvp.Value)" />
            }
            else
            {
                <meta name="@kvp.Key" content="@AbsoluteMetaValue(kvp.Key, kvp.Value)" />
            }
        }
    </HeadContent>
}

@if (ShowProgress && RootControl == null && SpinnerType != SpinnerType.None)
{
    @if (SpinnerType == SpinnerType.Skeleton)
    {
        <div class="skeleton-placeholder">
            @if (!string.IsNullOrEmpty(ProgressMessage))
            {
                <span style="font-size: 0.75rem; opacity: 0.45; letter-spacing: 0.02em;">@ProgressMessage</span>
            }
            <div class="skeleton-line" style="width: 35%;"></div>
            <div class="skeleton-line" style="width: 80%;"></div>
            <div class="skeleton-line" style="width: 55%;"></div>
        </div>
    }
    else
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center"
            Orientation="Orientation.Vertical" Style="@(Top ? "min-height: 100vh; min-height: 100dvh;" : "padding: 12px 0;")">
            @if (!string.IsNullOrEmpty(ProgressMessage))
            {
                <span style="@(Top ? "font-size: 1.17em; font-weight: bold;" : "font-size: 0.85em; color: var(--neutral-foreground-hint, #666);")">@ProgressMessage</span>
            }
            @if (SpinnerType == SpinnerType.Dots)
            {
                <div class="dots-spinner">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>
            }
            else
            {
                <FluentProgressRing style="width: 40px; height: 40px;" />
            }
        </FluentStack>
    }
}
@if (@RootControl != null)
{
    <DispatchView ViewModel="@RootControl" Stream="@Stream" Area="@Area" />

    @* Signal for thumbnail generator when LayoutAreas catalog has loaded *@
    @if (Area?.ToString() == "LayoutAreas")
    {
        <script>
            // Signal that the LayoutAreas catalog has finished loading
            document.body.setAttribute('data-catalog-loaded', 'true');
            console.log('LayoutAreas catalog content loaded via SignalR');
        </script>
    }
}
