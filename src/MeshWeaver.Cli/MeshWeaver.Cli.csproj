<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>MeshWeaver.Cli</RootNamespace>
    <AssemblyName>memex</AssemblyName>

    <!-- 🚨 A NuGet TOOL AGAIN, following `3-latest` (maintainer, 2026-10-15: "publish with the correct
         version" / "and 3latest?" — Doc/Architecture/NuGetPackageRetirement §"The CLI follows
         3-latest"). Retired 2026-09-07; restored because a customer's dedicated build server needs
         `dotnet tool install -g MeshWeaver.Cli` without a MeshWeaver checkout. Every time main-cd's
         `arm` arms a set it dispatches publish-packages.yml with packages=cli, the ARMED version
         (3.<minor>.<run>) and the armed core commit, so nuget.org's highest stable MeshWeaver.Cli is
         the CLI of the build `3-latest` names. Lanes still run the verbs through the mw-plugin-test
         image; this package is for people and build servers outside the fleet. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>memex</ToolCommandName>
    <PackageId>MeshWeaver.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Command-line interface for MeshWeaver / Memex — operates the mesh over the REST API and builds plugins against a platform image (memex build plugin).</Description>
    <PackageProjectUrl>https://github.com/Systemorph/MeshWeaver</PackageProjectUrl>
    <PackageTags>meshweaver;memex;cli;mesh</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <!-- 🚨 THE gate-host composition rules, embedded from the ONE file that holds them. The reusable
         lanes fetch this same path from the platform at their pinned ref; `memex build plugin`
         extracts it and runs it. A second copy of the rules in C# is exactly the drift trap this
         repository has paid for repeatedly, so the CLI links the script rather than reimplementing
         it, and GateHostCompositionTest pins the two to the same bytes. -->
    <EmbeddedResource Include="..\..\.github\scripts\compose-gate-host.sh" LogicalName="compose-gate-host.sh" />
  </ItemGroup>
</Project>
