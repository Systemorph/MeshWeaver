<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>MeshWeaver.Cli</RootNamespace>
    <AssemblyName>memex</AssemblyName>

    <!-- 🚨 A NuGet TOOL with its OWN VERSION (policy `cli-thin-wrapper-own-version`,
         Doc/Architecture/PolicyNotProse; Doc/Architecture/NuGetPackageRetirement §1a). Like `gh`, the
         CLI is a thin client — REST for the mesh verbs, the platform IMAGE for build and test — so
         it is released rarely and NOT with every platform build: bump <Version> when the CLI itself
         changes (<CliVersion> below), then dispatch publish-packages.yml with packages=cli. A customer's dedicated build
         server installs it with `dotnet tool install -g MeshWeaver.Cli` and needs no checkout. -->
    <CliVersion>3.0.0</CliVersion>
    <Version>$(CliVersion)</Version>
    <!-- the CLI's version option reads InformationalVersion, which Directory.Build.props sets BEFORE this
         file runs — to $(PlatformVersion) under CIRun, to the inherited $(Version) otherwise — so
         without this line a standalone build of CLI 3.0.0 reports the PLATFORM's version. It names
         $(CliVersion), not $(Version), so a global -p:Version (CD passes one) cannot reach this
         compiled attribute either. CliInformationalVersionGuard pins it. -->
    <InformationalVersion>$(CliVersion)</InformationalVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>memex</ToolCommandName>
    <PackageId>MeshWeaver.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Command-line interface for MeshWeaver / Memex — operates the mesh over the REST API and builds plugins against a platform image (memex build plugin).</Description>
    <PackageProjectUrl>https://github.com/Systemorph/MeshWeaver</PackageProjectUrl>
    <PackageTags>meshweaver;memex;cli;mesh</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <!-- 🚨 THE gate-host composition rules, embedded from the ONE file that holds them. The reusable
         lanes fetch this same path from the platform at their pinned ref; `memex build plugin`
         extracts it and runs it. A second copy of the rules in C# is exactly the drift trap this
         repository has paid for repeatedly, so the CLI links the script rather than reimplementing
         it, and GateHostCompositionTest pins the two to the same bytes. -->
    <EmbeddedResource Include="..\..\.github\scripts\compose-gate-host.sh" LogicalName="compose-gate-host.sh" />
  </ItemGroup>
</Project>
