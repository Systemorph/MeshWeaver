<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>MeshWeaver.Cli</RootNamespace>
    <AssemblyName>memex</AssemblyName>

    <!-- 🚨 NOT a NuGet tool any more (2026-09-07 — Doc/Architecture/NuGetPackageRetirement). The
         `memex` verbs reach CI through the mw-plugin-test IMAGE, never through `dotnet tool
         install`: node-repo-module-pack.yml runs the mw-plugin-test entrypoint in the pinned image
         directly and says so ("the `memex` half is only the trip into the container"), and no lane
         in this repo or any satellite installs MeshWeaver.Cli. Developers run it from source with
         `dotnet run` against src/MeshWeaver.Cli. Restoring the package means restoring the
         PackAsTool/ToolCommandName/PackageId/IsPackable properties AND adding the project to
         .github/workflows/publish-packages.yml: IsPackable alone would only spare the id from the
         retirement sweep in scripts/orphaned-nuget-packages.py, not publish anything. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <!-- 🚨 THE gate-host composition rules, embedded from the ONE file that holds them. The reusable
         lanes fetch this same path from the platform at their pinned ref; `memex build plugin`
         extracts it and runs it. A second copy of the rules in C# is exactly the drift trap this
         repository has paid for repeatedly, so the CLI links the script rather than reimplementing
         it, and GateHostCompositionTest pins the two to the same bytes. -->
    <EmbeddedResource Include="..\..\.github\scripts\compose-gate-host.sh" LogicalName="compose-gate-host.sh" />
  </ItemGroup>
</Project>
