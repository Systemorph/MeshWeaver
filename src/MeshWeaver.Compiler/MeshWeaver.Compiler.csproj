<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The MeshWeaver NodeType compile toolchain: skeleton generation, source-query resolution, @@-include and #r shaping, Roslyn compilation/emit, and the framework build identity. Everything that shapes a dynamic NodeType compile's input lives here, so the full-MVID framework-identity rule pins THIS small assembly instead of MeshWeaver.Graph (issue #1707).</Description>
    <RootNamespace>MeshWeaver.Compiler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The mesh actor half of the compile pipeline (MeshNodeCompilationService,
         NodeTypeCompilationHelpers) stays in MeshWeaver.Graph and orchestrates the
         internal toolchain members here. -->
    <!-- The mesh-actor half of the pipeline moved OUT of MeshWeaver.Graph into
         MeshWeaver.Compiler.Pipeline; it is the caller that orchestrates this toolchain, so
         the grant follows it. Kept for MeshWeaver.Graph as well: the graph half still
         composes the toolchain in AddGraph. -->
    <InternalsVisibleTo Include="MeshWeaver.Graph" />
    <InternalsVisibleTo Include="MeshWeaver.Compiler.Pipeline" />
    <InternalsVisibleTo Include="MeshWeaver.Compiler.Pipeline.Test" />
    <!-- NodeTypeBatchBake / the pre-warmer drive the same toolchain (ApplyQueryChange,
         EmitCanaryDataKey). -->
    <InternalsVisibleTo Include="MeshWeaver.Hosting" />
    <!-- The build-time packer calls DynamicMeshNodeAttributeGenerator directly (grant moved
         here from MeshWeaver.Graph with the generator): a prebuilt assembly MUST carry the
         same generated skeleton the runtime compiles, or it does not register as a node
         provider at all. -->
    <InternalsVisibleTo Include="MeshWeaver.Plugin.Build" />
    <!-- `mw-plugin-test build-project` compiles a .csproj against the container's own assemblies
         (no SDK, no NuGet) and shares the EMIT rather than writing a second one:
         EmitPipeline.EmitCompilationToDirectory + EmittedArtifact are the verified write, and a
         builder that re-implemented them would re-acquire the #1412 failure this assembly exists
         to prevent. 🚨 It does NOT use CreateCompilationOptions — those feed
         GeneratedInputIdentity.OptionsFingerprint, and a project's settings must never reach the
         key every cached NodeType assembly is filed under. -->
    <!-- 🚨 The ASSEMBLY name, not the project name: tools/MeshWeaver.PluginTester emits
         mw-plugin-test.dll, and an IVT naming the project grants nothing at all. -->
    <InternalsVisibleTo Include="mw-plugin-test" />
    <InternalsVisibleTo Include="MeshWeaver.Graph.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Query.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Monolith.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshWeaver.ContentCollections\MeshWeaver.ContentCollections.csproj" />
    <ProjectReference Include="..\MeshWeaver.Mesh.Contract\MeshWeaver.Mesh.Contract.csproj" />
    <!-- 🚨 #3934 — NuGetVersionComparer, the ONE version fold in the repo. A module entry of a
         dependency record is a FLOOR (min:<version>), so the toolchain has to ORDER versions, and
         re-implementing that ordering here is the failure check-module-platform-floor.py's own
         header warns about ("two call sites computing the same fold differently either never
         converge or never fire, and both are silent"). MeshWeaver.Plugin.Packaging is a leaf with
         no project references of its own, so this closes no cycle; the consequence — it joins
         FrameworkBuildIdentity.FullMvidAssemblies, so a body change to the comparer rebakes
         content — is CORRECT, because the comparer now decides which builds are adopted. -->
    <ProjectReference Include="..\MeshWeaver.Plugin.Packaging\MeshWeaver.Plugin.Packaging.csproj" />
    <ProjectReference Include="..\MeshWeaver.NuGet\MeshWeaver.NuGet.csproj" />
  </ItemGroup>

</Project>
