<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Course delivery for MeshWeaver: the entitlement-gated course-asset endpoint that resolves media from a Space's synced GitHub repository and redirects to a short-lived tokenized URL. Ships as a module — list the DLL under Modules:Assemblies to activate.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- GitSync: the Space's GitHubSyncConfig and the GitHub App installation token the asset
         resolver authenticates with. Hosting.AspNetCore: the endpoint-contribution hook.
         MeshWeaver.Blazor: PortalApplication, the per-circuit hub whose AccessService carries the
         viewer identity UserContextMiddleware stamped for this request. -->
    <ProjectReference Include="..\MeshWeaver.GitSync\MeshWeaver.GitSync.csproj" />
    <ProjectReference Include="..\MeshWeaver.Hosting.AspNetCore\MeshWeaver.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="..\MeshWeaver.Blazor\MeshWeaver.Blazor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The gate's pure decision functions and the resolver's cache behaviour are pinned by
         CourseAssetGateTest / CourseAssetServiceTest, which live with the portal's test suite. -->
    <InternalsVisibleTo Include="Memex.Portal.Shared.Test" />
  </ItemGroup>
</Project>
