<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeshWeaver.Graph.Test" />
    <!-- OverlaySelfHealWatcherTest moved to the pipeline suite with its subject
         (OverlayHealBudget), but the self-heal it exercises is ARMED by
         NodeTypeEnrichmentHelpers, which stays here with the hub enrichment. -->
    <InternalsVisibleTo Include="MeshWeaver.Compiler.Pipeline.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Query.Test" />
    <!-- The build/bake pipeline drives NodeType compilation (MeshNodeCompilationService,
         NodeTypeCompilationHelpers, TryCreateReleaseNode) — a live internal coupling,
         tracked for retirement separately from the (removed) Approvals grant. -->
    <InternalsVisibleTo Include="MeshWeaver.Hosting" />
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Monolith.Test" />
    <!-- OrleansCompileActivityAccessTest seeds a NodeType whose compile state is deliberately
         "settled and nothing due", which means stamping FailedBuildInputs with the token the
         framework itself computes (NodeTypeCompilationHelpers.BuildInputsToken). Re-deriving that
         fold in the test is the one thing its own contract forbids — two call sites computing the
         token differently either never converge or never fire, and both are silent. -->
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Orleans.Test" />
    <!-- The build-time packer calls DynamicMeshNodeAttributeGenerator directly. A prebuilt
         assembly MUST carry the same generated skeleton the runtime compiles (the
         MeshNodeProviderAttribute subclass + ConfigureHub wrapping the `configuration` lambda),
         or it does not register as a node provider at all. Reproducing that generation in the
         tool would be a second implementation free to drift from the one that matters. -->
    <InternalsVisibleTo Include="MeshWeaver.Plugin.Build" />
    <!-- 🚨 THIS ONE LIVES IN ANOTHER REPO. MeshWeaver.OgCard and its tests moved to
         MeshWeaver.Plugins/src when the module left the platform; OpenGraphPreviewService did
         NOT, because GraphConfigurationExtensions registers it and Memex.Portal.Shared's
         OgCardRenderer consumes it. So the test still needs the internal seam constructor — the
         one that takes `allowLoopback: true`, without which it cannot point the service at its
         own local listener, because the production SSRF guard refuses loopback by design.
         Dropping this grant does not fail here: it fails in the OTHER repo, as CS1729 "does not
         contain a constructor that takes 3 arguments", which reads as a signature change rather
         than as lost visibility. That is exactly how it reddened MeshWeaver.Plugins' main on
         2026-08-21 — the test moved out and the grant did not follow it. The
         `landed-modules-gate` job now compiles that repo's projects against this one, so the
         coupling is checked here rather than discovered there. -->
    <InternalsVisibleTo Include="MeshWeaver.OgCard.Test" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\**\*.*" />
    <!-- Built-in import script templates seeded as Code MeshNodes via
         GraphImportTemplates. Embed as resources so the .csx text travels
         inside the assembly with no file-system lookup at runtime. -->
    <EmbeddedResource Include="Templates\NodeCopy.csx" />
    <EmbeddedResource Include="Templates\Mirror.csx" />
  </ItemGroup>

  <ItemGroup>
    <!-- DateTime.Humanize() in CodeLayoutAreas. Declared explicitly: it used to ride in as a
         transitive of JsonPointer.Net (removed in #1231). -->
    <PackageReference Include="Humanizer.Core" />
    <!-- IHostedService consumers (AccessGrantNotifier, EventSubscriptionRunner,
         StartupErrorNotifier) reached this via a TRANSITIVE ref that left with the Azure
         shed — declared explicitly, as a direct use always should be. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- IHttpClientFactory for the OgCard Open Graph fetcher (OpenGraphPreviewService). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The NodeType compile toolchain (skeleton generation, source-query resolution, emit,
         framework identity) lives in MeshWeaver.Compiler (#1707), namespace MeshWeaver.Compiler;
         this project keeps the mesh-actor half (discovery, impersonation, status write-backs). -->
    <ProjectReference Include="..\MeshWeaver.Compiler\MeshWeaver.Compiler.csproj" />
    <ProjectReference Include="..\MeshWeaver.Compiler.Pipeline\MeshWeaver.Compiler.Pipeline.csproj" />
    <ProjectReference Include="..\MeshWeaver.Graph.Contract\MeshWeaver.Graph.Contract.csproj" />
    <ProjectReference Include="..\MeshWeaver.ContentCollections\MeshWeaver.ContentCollections.csproj" />
    <ProjectReference Include="..\MeshWeaver.Data\MeshWeaver.Data.csproj" />
    <ProjectReference Include="..\MeshWeaver.Kernel\MeshWeaver.Kernel.csproj" />
    <ProjectReference Include="..\MeshWeaver.Kernel.Hub\MeshWeaver.Kernel.Hub.csproj" />
    <ProjectReference Include="..\MeshWeaver.Layout\MeshWeaver.Layout.csproj" />
    <ProjectReference Include="..\MeshWeaver.Markdown\MeshWeaver.Markdown.csproj" />
    <ProjectReference Include="..\MeshWeaver.Mesh.Contract\MeshWeaver.Mesh.Contract.csproj" />

    <ProjectReference Include="..\MeshWeaver.Messaging.Hub\MeshWeaver.Messaging.Hub.csproj" />
    <ProjectReference Include="..\MeshWeaver.NuGet\MeshWeaver.NuGet.csproj" />
  </ItemGroup>

  <!-- The BusinessRules scope generator and runtime are NOT part of the platform. Business rules /
       scopes ship as a PLUGIN (MeshWeaver.Plugins/BusinessRules), which carries the generator source
       and injects it into node/script/markdown compilation. The Doc partition and the portal start
       with zero business-rules dependency. -->

</Project>
