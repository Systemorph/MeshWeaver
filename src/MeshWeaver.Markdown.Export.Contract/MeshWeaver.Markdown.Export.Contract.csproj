  <ItemGroup>
    <!-- Deliberately NO package references at all. This assembly holds only the wire shapes an
         export CALLER needs; the rendering engine and its package dependencies stay in
         MeshWeaver.Markdown.Export. That split is what keeps the renderer — and the
         headless-browser-driven PDF path — out of MeshWeaver.Blazor's project graph. If you find
         yourself adding a package reference here, the type you are adding almost certainly
         belongs in the engine instead. -->
    <ProjectReference Include="..\MeshWeaver.Domain\MeshWeaver.Domain.csproj" />
    <ProjectReference Include="..\MeshWeaver.Messaging.Contract\MeshWeaver.Messaging.Contract.csproj" />
    <!-- For ExportDocumentControl, which AddMarkdownExportTypes registers. The control itself
         correctly lives in MeshWeaver.Layout — Layout is the control vocabulary every renderer
         (Blazor, React, React Native, MAUI) agrees on, so a UiControl belongs there by
         construction. Only the non-control types moved here. -->
    <ProjectReference Include="..\MeshWeaver.Layout\MeshWeaver.Layout.csproj" />
  </ItemGroup>
</Project>
