<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{c1d2e3f4-0a1b-4c5d-8e7f-9a8b7c6d5e4f}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Email export walks the rendered markdown DOM to substitute layout-area placeholders and
         to strip what mail clients cannot render. Same parser the Blazor MarkdownHtmlRenderer
         uses for the identical walk, so the two agree on what a placeholder div is. -->
    <PackageReference Include="HtmlAgilityPack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in export script templates seeded as Code MeshNodes via
         MarkdownExportNodeProvider. Embed as resources so the .csx text travels
         inside the assembly with no file-system lookup at runtime. -->
    <EmbeddedResource Include="Templates\ExportPdf.csx" />
    <EmbeddedResource Include="Templates\ExportDocx.csx" />
    <EmbeddedResource Include="Templates\ExportHtml.csx" />

    <!-- Pixel-faithful print templates. Markup and stylesheet stay real .html/.css files
         (never interpolated strings in C#) and travel inside the assembly. -->
    <EmbeddedResource Include="Pixel\SlidePrint.html" />
    <EmbeddedResource Include="Pixel\SlidePrint.css" />
    <EmbeddedResource Include="Pixel\SlidePrintSection.html" />

    <!-- Content-faithful PDF print templates. Same convention: the page furniture (cover, TOC,
         running header/footer, page-break rules) is CSS Paged Media in a real stylesheet. -->
    <EmbeddedResource Include="Pdf\DocumentPrint.html" />
    <EmbeddedResource Include="Pdf\DocumentPrint.css" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire contract (request/response, options, RenderedDocument, CorporateIdentity). Split
         out so MeshWeaver.Blazor can drive an export without pulling this engine into its project
         graph. -->

    <ProjectReference Include="..\MeshWeaver.Markdown.Export.Contract\MeshWeaver.Markdown.Export.Contract.csproj" />
    <ProjectReference Include="..\MeshWeaver.Data.Contract\MeshWeaver.Data.Contract.csproj" />
    <ProjectReference Include="..\MeshWeaver.Markdown\MeshWeaver.Markdown.csproj" />
    <ProjectReference Include="..\MeshWeaver.Layout\MeshWeaver.Layout.csproj" />
    <ProjectReference Include="..\MeshWeaver.Graph\MeshWeaver.Graph.csproj" />
    <ProjectReference Include="..\MeshWeaver.Mesh.Contract\MeshWeaver.Mesh.Contract.csproj" />
    <ProjectReference Include="..\MeshWeaver.Messaging.Hub\MeshWeaver.Messaging.Hub.csproj" />
    <ProjectReference Include="..\MeshWeaver.ContentCollections\MeshWeaver.ContentCollections.csproj" />
    <ProjectReference Include="..\MeshWeaver.Kernel.Hub\MeshWeaver.Kernel.Hub.csproj" />
  </ItemGroup>
</Project>
