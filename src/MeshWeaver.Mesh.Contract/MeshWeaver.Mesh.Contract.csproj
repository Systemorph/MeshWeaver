<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{f2a037e0-a84e-40c2-9a75-93dc566b8b4a}</ProjectGuid>
    <RootNamespace>MeshWeaver.Mesh</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- ConfigurationFeatureFlags reads the deployment's Features:Flags section (abstractions only —
         the providers come from the host). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- IHostedService only: module-contributed hosted services are isolated at ACTIVATION
         (#2449, IsolatedModuleHostedService). Abstractions only — no host, no runtime. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- PresentationScreenExtensions.LastKnownOnFault is observable-in / observable-out precisely so
         the faulting-profile leg (which a live mesh cannot arrange on demand) is directly testable. -->
    <InternalsVisibleTo Include="MeshWeaver.Graph.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshWeaver.Data.Contract\MeshWeaver.Data.Contract.csproj" />
    <ProjectReference Include="..\MeshWeaver.Layout\MeshWeaver.Layout.csproj" />
    <ProjectReference Include="..\MeshWeaver.Messaging.Contract\MeshWeaver.Messaging.Contract.csproj" />
    <ProjectReference Include="..\MeshWeaver.Messaging.Hub\MeshWeaver.Messaging.Hub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gRPC wire contract of the mesh (meshweaver.v1.Mesh). It lives with the platform contract,
         not with the server that implements it: MeshWeaver.Hosting.Grpc compiles it from here, the
         python client (clients/python/scripts/gen_proto.sh) and the JS clients in MeshWeaver.Plugins
         generate from here, so there is ONE contract and no copies. Packed so a NuGet consumer gets
         it too. -->
    <None Include="Protos/mesh.proto" Pack="true" PackagePath="protos/" />
  </ItemGroup>
</Project>
