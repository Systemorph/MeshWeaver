<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The AKS/ACR mechanics behind MeshWeaver's platform self-update and instance provisioning: reads image tags from an Azure Container Registry, patches Kubernetes Deployments, and provisions per-instance workloads. Ships as a module — the self-update poller itself stays in the platform.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Azure.Identity: the AAD→ACR token exchange the registry reader performs. Both stay in the
         app closure anyway (Hosting.AzureBlob, the AzureFoundry pack) — this module removes CODE
         from the host, not megabytes. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeshWeaver.Blazor\MeshWeaver.Blazor.csproj" />
    <ProjectReference Include="..\MeshWeaver.Hosting\MeshWeaver.Hosting.csproj" />
    <ProjectReference Include="..\MeshWeaver.Hosting.AspNetCore\MeshWeaver.Hosting.AspNetCore.csproj" />
  </ItemGroup>
</Project>
