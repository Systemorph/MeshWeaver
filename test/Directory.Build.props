<Project>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Doc-COMPLETENESS suppression for the test tree. The root Directory.Build.props carries this
         NoWarn for src/, but this test-tree props does NOT import the root, so without it every test
         project that turns on GenerateDocumentationFile must remember to add CS1591 itself (some did,
         some didn't → AI.Test surfaced 58 CS1591 under -warnaserror). Mirrors the central src policy:
         missing member/param/typeparam docs on test types are not filled wholesale. Doc-QUALITY
         warnings (broken/ambiguous crefs, malformed XML) are NOT here — those are real bugs, fixed. -->
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken to async calls) is an established
         team decision to suppress in the test tree — 14 test csprojs already carried
         `<NoWarn>$(NoWarn);xUnit1051</NoWarn>` individually; centralising it here removes the
         per-project duplication and applies it uniformly (the remaining projects only ever lacked
         it by omission). Tests use explicit `TestContext.Current.CancellationToken` + `.Timeout(...)`
         where cancellation matters. NOT a code-quality suppression: xUnit1031 (blocking task ops →
         deadlock risk) is deliberately NOT here and is fixed at the source instead. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1712;xUnit1051</NoWarn>
    <!-- NuGet transitive-dependency ADVISORY warnings (NU1901-NU1904) must not fail the test build
         under -warnaserror. The ROOT Directory.Build.props already carries exactly this policy for src/,
         but this test-tree props does NOT import the root (see the doc-completeness note above), so a
         newly-published advisory on a transitive package (e.g. AngleSharp GHSA-pgww-w46g-26qg → NU1902)
         turned green test builds RED for every test project at once while src/ stayed a warning. Mirror
         the central src policy here so the test tree tracks it uniformly. Vulnerability handling
         (bump/replace) is a deliberate dependency decision, not a per-build -warnaserror gate. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Security override, not a dependency we use: Testcontainers (any published version, incl.
         4.13.0) floats SSH.NET at [2025.1.0, ), and <= 2025.1.0 carries GHSA-q939-rpr3-3284 (High,
         ScpClient arbitrary file write). A bare <PackageVersion> pin is INERT for a transitive-only
         package, so this direct reference lifts the graph to the patched version. PrivateAssets=all
         per the root props' override convention. Remove when Testcontainers' floor reaches
         2026.0.0. -->
    <PackageReference Include="SSH.NET" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Required so the global <Using> items below (incl. MeshWeaver.Reactive.Assertions)
         are actually emitted. With ImplicitUsings disabled, <Using> is silently ignored,
         and Should()/Seconds() fail to resolve across every test file. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Always emit a TRX so every `dotnet test` invocation leaves a parseable
         result file in TestResults/ — required for hang diagnosis (the only
         place the per-test StdOut + outcome is recorded once the host crashes
         or the runner is killed). Without this, local runs leave nothing
         behind to inspect. CI passes `-l:trx` explicitly; this matches that
         behavior for local. Path = `<project>/TestResults/_<machine>_<utc>.trx`. -->
    <VSTestLogger>trx</VSTestLogger>
    <!-- xUnit v3 → trx StdOut: anything written via ITestOutputHelper.WriteLine
         (which the per-test ILogger redirects to at Information+ via xunit.runner.json
         + appsettings.json's MeshWeaver=Information) flows into the trx's
         <StdOut> element on the failing test result. No extra config needed
         beyond keeping diagnosticMessages false (default) and writing logs
         through the standard pipeline. -->
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit.ITestOutputHelper" Alias="ITestOutputHelper" />
    <!-- In-house assertion library (replaced FluentAssertions). One global using
         covers Should()/asserts + the Seconds()/Milliseconds()/… time helpers, so
         test files need no per-file assertion import. -->
    <Using Include="MeshWeaver.Reactive.Assertions" />
    <!-- ObservableAwait.Await — the ONE sanctioned observable→Task bridge — moved from
         MeshWeaver.Fixture (a TEST assembly) into MeshWeaver.Messaging.Hub, because the bridges
         that actually deadlock a hub are in PRODUCT code: an SDK boundary we must implement
         (a Microsoft.Agent.Framework ...Async override, IHostedService, ASP.NET middleware) cannot
         reference the test fixture, so those had nowhere to go and stayed on Rx's .ToTask().
         Imported globally here so the ~330 existing call sites need no churn, and so exactly ONE
         implementation exists — a forward in the old namespace made every .Await(ct) ambiguous
         (CS0121) in the files that import both. -->
    <!-- Excluded: the three test projects with no messaging dependency at all (they assert JSON,
         image packing and browser E2E). A global using cannot resolve a namespace the project does
         not reference, so naming them is honest; adding a ProjectReference just to satisfy a using
         would be the wrong direction. -->
    <Using Include="MeshWeaver.Messaging"
           Condition="'$(MSBuildProjectName)' != 'MeshWeaver.Cli.Test'
                  and '$(MSBuildProjectName)' != 'MeshWeaver.Json.Test'
                  and '$(MSBuildProjectName)' != 'MeshWeaver.PluginImage.Test'
                  and '$(MSBuildProjectName)' != 'MeshWeaver.Portal.E2E.Test'
                  and '$(MSBuildProjectName)' != 'MeshWeaver.Testing.Xunit'
                  and '$(MSBuildProjectName)' != 'MeshWeaver.Testing.Xunit.Test'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Global project reference: every test project gets the assertion library. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\MeshWeaver.Reactive.Assertions\MeshWeaver.Reactive.Assertions.csproj" />
    <!-- The three test-SUPPORT libraries (MeshWeaver.Fixture and the two TestBase assemblies) moved
         here from src/ on 2026-08-30 so they are never packed or published again. They are
         LIBRARIES: no test SDK, no xunit runner, no generated entry point — a generated
         XunitAutoGeneratedEntryPoint in a library duplicates the consumer's (CS0436) and turns
         every referenced base into a second test host. They opt out with
         MeshWeaverTestSupportLibrary=true; everything else under test/ is a test project. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Condition="'$(MeshWeaverTestSupportLibrary)' != 'true'" />
    <PackageReference Include="xunit.v3" Condition="'$(MeshWeaverTestSupportLibrary)' != 'true'" />
    <PackageReference Include="xunit.runner.visualstudio" Condition="'$(MeshWeaverTestSupportLibrary)' != 'true'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.runner.console" Condition="'$(MeshWeaverTestSupportLibrary)' != 'true'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    </ItemGroup>
  <!-- xunit.runner.json — the shared single-threaded default, UNLESS a project ships its own
       next to its .csproj.

       A per-project file is how a project opts INTO intra-project parallelism
       (parallelizeTestCollections + maxParallelThreads > 1) once it has been measured
       green that way. It is deliberately opt-in per project rather than a global flip:
       parallel safety is a property of the tests, not of the runner, and the suite has
       classes that share a Testcontainers instance ([Collection("PostgreSql")]) or assert
       on process-global state.

       The two includes are mutually exclusive on purpose. Two Content items both landing
       `xunit.runner.json` in the same output directory is a duplicate-copy conflict whose winner
       MSBuild picks without guaranteeing which — i.e. a project could silently get the shared
       default back and quietly lose its parallelism, or worse, get parallelism it never opted into.

       🚨 Both are `Content`, and the local one must NOT be written as `None Update`. This file is
       imported by Microsoft.Common.props, which runs BEFORE the SDK's default item globs are
       defined — so an `Update` here matches nothing and silently no-ops. The failure is not a
       missing optimisation: with no xunit.runner.json in the output at all, xUnit falls back to
       ITS OWN defaults, where parallelizeTestCollections is true and the thread count is the core
       count. A silent no-op therefore hands the project unbounded parallelism nobody opted into.
       `Content Include` works because the SDK's default None glob excludes @(Content), so the file
       is not double-copied. -->
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)/xunit.runner.json')">
    <Content Include="$(MSBuildThisFileDirectory)\xunit.runner.json">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/xunit.runner.json')">
    <Content Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- appsettings.json — EXACTLY the same two-mutually-exclusive-branches shape as
       xunit.runner.json above, and for the same reason.

       🚨 This used to be a single UNCONDITIONAL include of the shared file, linked to
       `appsettings.json` in the output. Eleven test projects also ship their own
       appsettings.json next to their .csproj, nine of which declared their own
       `<Content Include="appsettings.json">`. Two Content items landing the same file name in
       the same output directory is a duplicate-copy conflict whose winner MSBuild picks without
       guaranteeing which — so those projects' logging configuration was decided by build order.

       The cost was not hypothetical. test/MeshWeaver.Query.Test/appsettings.json raises
       MeshWeaver.Graph / Hosting.Persistence / MeshNodeStreamCache to Debug specifically to
       diagnose the ActivityTrackingHubTest.TrackActivity_InitiatedFromConnectionHub_LandsNode
       flake (#993). Locally the project-local file wins and the channels are live; on CI run
       31301311379 the failing test's captured Output was EMPTY for its full 15 s budget and the
       whole run contained zero lines from any of those channels. The diagnostic added for that
       flake had therefore never produced a single byte of evidence on the only platform where
       the flake occurs.

       Owning both branches here (rather than leaving the local copy to each .csproj) is what
       makes them mutually exclusive; the per-project `<Content Include="appsettings.json">`
       declarations were removed in the same change. The `VerifyXunitRunnerConfigCopied` target
       AT THE BOTTOM OF THIS FILE guards BOTH files — despite its name it errors if either
       xunit.runner.json or appsettings.json fails to reach $(TargetDir), which is what stops
       either two-branch selection from silently picking neither. (It used to live in
       Directory.Build.targets; see the comment on the target itself for why that made it
       unreachable for every satellite and why it must stay in THIS file.) -->
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)/appsettings.json')">
    <Content Include="$(MSBuildThisFileDirectory)\appsettings.json">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/appsettings.json')">
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ================= The guard for the four Content includes above =================

       🚨 THIS TARGET LIVES HERE, IN THE SAME FILE AS THE PLUMBING IT VALIDATES, AND MUST STAY
       HERE. It used to sit in test/Directory.Build.targets, and that separation is what made it
       unreachable for every repository in the fleet.

       MSBuild auto-imports Directory.Build.props and Directory.Build.targets independently, so a
       consumer can take one without the other — and every satellite that consumes this plumbing
       does exactly that. MeshWeaver.Plugins (78 *.Test projects) and MeshWeaver.SocialMedia (1)
       each import THIS file explicitly from their own src/Directory.Build.props:

           <Import Project="$(MeshWeaverRoot)/test/Directory.Build.props"
                   Condition="$(MSBuildProjectName.EndsWith('.Test')) AND Exists(...)" />

       and NEITHER imports test/Directory.Build.targets — nor do the other satellite checkouts
       (.Education, .Reinsurance, .Manufacturing, which import neither file). Measured 2026-09-01:
       ZERO of five checkouts reference `test/Directory.Build.targets`. So every repository that
       took the two-branch Content selection took it WITHOUT the assertion that it selected
       anything — 79 satellite test projects, against core's ~15 that had the guard.

       What the guard is for: the four includes above pick ONE of two branches on an Exists()
       condition. If a branch is renamed, a condition is reworked, or the `None Update` trap in the
       comment above is re-introduced, the includes select NEITHER, the build still succeeds, and
       the tests still run — under xUnit's OWN defaults. That is not "a lost setting":

         * parallelizeTestCollections becomes TRUE and maxParallelThreads becomes the core count,
           on suites that are single-threaded precisely because parts of them are not parallel-safe;
         * methodTimeout (30 s) disappears entirely.

       The second one is why this guard belongs to the hang investigation (#2865). With
       methodTimeout in force a wedged test is killed at 30 s and its transcript is WRITTEN — the
       "strictly better witness" #2865 identifies. Without it, nothing bounds the test, the shard
       runs to its wall-clock cap, the host is killed (exit=124 / HOST_CRASHED) and the in-flight
       test's transcript is DESTROYED — which is the structural obstacle that issue records as the
       reason the family cannot be diagnosed from CI artifacts at all. Whether a hang is
       investigable therefore depends on this file's includes having worked, and until now nothing
       outside core checked that they had.

       AGENTS.md states the rule this restores: a gate must never be separable from the input it
       validates, because a gate that never runs is indistinguishable from a gate that passed.

       Keeping the target in a .props is ordinary MSBuild: AfterTargets is resolved when targets
       execute, long after this file is imported, and $(TargetDir) is fully evaluated by then.
       DirectoryBuildGuardTravelsWithItsSubjectTest pins the co-location. -->
  <Target Name="VerifyXunitRunnerConfigCopied"
          AfterTargets="Build"
          Condition="'$(TargetDir)' != '' AND '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetDir)xunit.runner.json')"
           Text="No xunit.runner.json reached $(TargetDir). The Content includes in test/Directory.Build.props selected neither the shared default nor a project-local override, so this assembly would run under xUnit's built-in defaults (parallelizeTestCollections=true, threads=core count, NO methodTimeout) instead of the suite's configured settings. A missing methodTimeout is why a wedged test kills the whole host at the wall-clock cap and destroys its own transcript (#2865). Fix the includes in test/Directory.Build.props — do not suppress this error." />

    <!-- appsettings.json rides the identical two-branch plumbing, so it needs the identical
         guard. Its silent failure is quieter than the runner config's but cost more: the
         project-local files are where a test project raises specific channels to Debug to
         diagnose a CI-only flake, and a build that lands the shared Warning-only file instead
         produces a green-looking run with no diagnostic output at all. That is exactly how the
         #993 instrumentation in test/MeshWeaver.Query.Test/appsettings.json ran for over a week
         emitting nothing on CI while working locally. -->
    <Error Condition="!Exists('$(TargetDir)appsettings.json')"
           Text="No appsettings.json reached $(TargetDir). The Content includes in test/Directory.Build.props selected neither the shared default nor the project-local file, so this assembly would run with no logging configuration — any per-project diagnostic channels would silently emit nothing. Fix the includes in test/Directory.Build.props — do not suppress this error." />
  </Target>

</Project>