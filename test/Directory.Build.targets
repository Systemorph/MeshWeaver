<Project>

  <!-- Guard the xunit.runner.json plumbing in Directory.Build.props.

       That plumbing picks ONE of two Content includes (shared default vs project-local opt-in)
       on an Exists() condition. If it ever picks neither — a renamed file, a reworked condition,
       or the `None Update` trap documented in Directory.Build.props — the build still succeeds
       and the tests still run. They just run under xUnit's OWN defaults, where
       parallelizeTestCollections is TRUE and the thread count is the machine's core count.

       So the silent failure is not "we lost a setting", it is "every test project silently
       switched to unbounded parallelism", on a suite that is single-threaded precisely because
       parts of it are not parallel-safe. That would surface as unattributable flakes in CI, far
       from the change that caused it.

       Fail the build instead. This target is why a future edit to the props cannot regress
       quietly. -->
  <Target Name="VerifyXunitRunnerConfigCopied"
          AfterTargets="Build"
          Condition="'$(TargetDir)' != '' AND '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetDir)xunit.runner.json')"
           Text="No xunit.runner.json reached $(TargetDir). The Content includes in test/Directory.Build.props selected neither the shared default nor a project-local override, so this assembly would run under xUnit's built-in defaults (parallelizeTestCollections=true, threads=core count) instead of the suite's configured settings. Fix the includes in test/Directory.Build.props — do not suppress this error." />
  </Target>

</Project>
