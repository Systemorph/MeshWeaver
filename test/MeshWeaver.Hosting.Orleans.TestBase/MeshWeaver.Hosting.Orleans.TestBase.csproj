<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The test-tree props default to Exe (xunit v3 entry point); this is a LIBRARY test-support
         assembly, moved here from src/ on 2026-08-30 so it is never packed or published again. -->
    <OutputType>Library</OutputType>
    <MeshWeaverTestSupportLibrary>true</MeshWeaverTestSupportLibrary>
    <!-- The root props (which src/ inherited and the test tree does not) tolerate CA2255: these
         libraries carry the [ModuleInitializer] hooks that arm test-process-wide teardown capture
         (TeardownStragglerCapturer, the exception suppressors) — application-side code by design,
         loaded only into test hosts. -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
    <ProjectGuid>{7a3e1c2d-4b5f-4e6a-9c8d-2f1e0b3a4c5d}</ProjectGuid>
    <!-- The machinery keeps the namespace it always had: it moved out of the Orleans test project
         so that test projects in OTHER repositories (MeshWeaver.Plugins holds the storage and
         transport tests that run over an Orleans cluster) can build on it, and a hundred test files
         did not have to change a using for that. -->
    <RootNamespace>MeshWeaver.Hosting.Orleans.Test</RootNamespace>
    <Description>Test infrastructure for MeshWeaver over an Orleans cluster: OrleansMeshTestBase, the test cluster + backing store, disposal drain, grain-directory sizing. The Orleans counterpart of MeshWeaver.Hosting.Monolith.TestBase.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MeshWeaver.Connection.Orleans\MeshWeaver.Connection.Orleans.csproj" />
    <ProjectReference Include="..\MeshWeaver.Fixture\MeshWeaver.Fixture.csproj" />
    <!-- The IMeshBootstrap seam. It lives in the MONOLITH test base and must stay there: that
         project must never reference Orleans (23 in-process suites would drag a cluster's worth of
         packages), so the pure fluent API is defined there and the applicator that needs Orleans is
         registered from here — see OrleansBootstrapRegistration. The dependency only points this
         way; MeshWeaver.Hosting.Monolith.TestBase references Fixture, Graph and Hosting.Monolith. -->
    <ProjectReference Include="..\MeshWeaver.Hosting.Monolith.TestBase\MeshWeaver.Hosting.Monolith.TestBase.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Graph\MeshWeaver.Graph.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Documentation\MeshWeaver.Documentation.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Hosting\MeshWeaver.Hosting.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Hosting.Orleans\MeshWeaver.Hosting.Orleans.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Layout\MeshWeaver.Layout.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests that build on this machinery, here and in MeshWeaver.Plugins (the storage and
         transport suites that run over an Orleans cluster). -->
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Orleans.Test" />
    <InternalsVisibleTo Include="MeshWeaver.AI.Orleans.Test" />
    <InternalsVisibleTo Include="MeshWeaver.AI.Orleans.TestBase" />
    <!-- The collaboration module's Orleans suite, in MeshWeaver.Plugins — same shape as the AI
         entries above: the rig stays here, the suite that drives it travels with its feature. -->
    <InternalsVisibleTo Include="MeshWeaver.Markdown.Collaboration.Orleans.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Hosting.PostgreSql.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Grpc.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Cosmos.Test" />
    <InternalsVisibleTo Include="MeshWeaver.Hosting.Snowflake.Test" />
  </ItemGroup>
</Project>
