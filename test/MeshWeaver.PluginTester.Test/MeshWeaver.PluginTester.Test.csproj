<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\tools\MeshWeaver.PluginTester\MeshWeaver.PluginTester.csproj" />
    <ProjectReference Include="..\MeshWeaver.Fixture\MeshWeaver.Fixture.csproj" />
    <!-- The combo gate's production seam (DockerImageGate) lives in the sibling tool and had NO
         test and NO caller of any kind (#2274) — its docker argv is pinned by
         DockerImageGateArgsTest here rather than in a new project, next to
         GateRunReportContractTest which already owns the other half of the same wire contract.
         🚨 This does NOT touch tools/MeshWeaver.PluginTester's own reference closure, which IS the
         framework build identity — this is the TEST project. -->
    <ProjectReference Include="..\..\tools\MeshWeaver.ComboVerifier\MeshWeaver.ComboVerifier.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RazorBuildTest LOADS the Blazor component it just compiled and reads the generated
         BuildRenderTree override off it — which resolves ComponentBase, so this host has to be able
         to bind Microsoft.AspNetCore.App. Without it the assertion cannot run at all, and "the
         compiler returned" would be the only evidence a component exists, which is exactly the
         CS0115 blind spot the suite is about. Same reason MeshWeaver.Auth.Test carries it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- StagedGeneratorsTest COMPILES a project that authors an Orleans-serializable type and then
         LOADS the emitted assembly to look for the generated serializer — so Orleans' own assemblies
         have to be in this host's reference set (ContainerReferenceSet reads the process's TPA). A
         missing Orleans code generator produces NO compile error at all, so reflection over the
         emitted assembly is the only way to tell it ran; without this reference the assertion cannot
         run. 🚨 This is the TEST project — tools/MeshWeaver.PluginTester's own reference closure IS
         the framework build identity and is untouched. -->
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>

  <!-- The gate boots in-process here, and the gate requires the AI engine MODULE beside the
       binary (#2276) — modules/ is laid by the closure lane, not copied by a ProjectReference, so
       this TEST bin needs its own lane run with the same tester-local single row. Same pattern as
       the old StorageModuleLayoutTest: reuse the real worker, never a hand-copied publish. -->
  <!-- 🚨 No module lane here any more (#2276). This used to run the closure worker for a
       tester-local MeshWeaver.AI row so the test bin mirrored the gate's modules/ layout — but the
       AI engine has left this repo, and the image itself now ships no module. The module-composition
       guard therefore COMPILES its own throwaway probe assembly instead of binding a real module,
       which is stronger: it cannot rot when the next module moves out. -->
</Project>
