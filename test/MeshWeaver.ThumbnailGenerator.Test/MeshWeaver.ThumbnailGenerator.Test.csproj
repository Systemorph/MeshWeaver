<Project Sdk="Microsoft.NET.Sdk">
  <!-- The thumbnail generator's image half (ThumbnailResizer): a captured 2x screenshot is fitted
       into the thumbnail box and scaled down to a PNG of exactly that size. The browser half needs
       a running portal and Playwright binaries, so it is not exercised here. -->
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\MeshWeaver.ThumbnailGenerator\MeshWeaver.ThumbnailGenerator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- An 800x450 capture: the 2x intermediate the generator screenshots for a 400x225 thumbnail. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
