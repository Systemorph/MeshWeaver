<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mw-log-watcher</AssemblyName>
    <RootNamespace>MeshWeaver.LogWatcher</RootNamespace>
    <IsPackable>false</IsPackable>
    <UserSecretsId>meshweaver-log-watcher</UserSecretsId>
    <!-- Multi-arch container publish (same pair as memex-portal-ai / mw-plugin-test);
         Directory.Build.props' ProduceReferenceAssembly gate handles the RID-leg race. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRepository>memex-log-watcher</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ONLY framework references: the shared report/fingerprint contract, and the I/O pool so
         every HTTP leaf runs off the scheduler and bounded, exactly as it does in the portal
         (Doc/Architecture/ControlledIoPooling.md). -->
    <ProjectReference Include="..\..\src\MeshWeaver.Observability.Contract\MeshWeaver.Observability.Contract.csproj" />
    <ProjectReference Include="..\..\src\MeshWeaver.Mesh.Contract\MeshWeaver.Mesh.Contract.csproj" />
  </ItemGroup>

</Project>
