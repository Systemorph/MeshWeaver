<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU5111</NoWarn>

    <!-- 🚨 NOT a dotnet tool any more (2026-09-07 — Doc/Architecture/NuGetPackageRetirement).
         Nothing in this repository or any satellite installs or invokes it; it is run from source
         when a thumbnail needs regenerating. -->
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Microsoft.Playwright" />
      <!-- Image scaling: SkiaSharp (MIT), the stack the portal already ships for share cards and
           favicons. Replaced SixLabors.ImageSharp — every version up to 4.1.1 carries high-severity
           advisories and the patched line is pay-to-use. The Linux natives let the tool (and its
           test) run on a Linux runner; macOS and Windows natives come with SkiaSharp itself. -->
      <PackageReference Include="SkiaSharp" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
      <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
