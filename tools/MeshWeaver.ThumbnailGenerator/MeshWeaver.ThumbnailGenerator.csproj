<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU5111</NoWarn>

    <!-- 🚨 NOT a dotnet tool any more (2026-09-07 — Doc/Architecture/NuGetPackageRetirement).
         Nothing in this repository or any satellite installs or invokes it; it is run from source
         when a thumbnail needs regenerating. -->
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Microsoft.Playwright" />
      <PackageReference Include="SixLabors.ImageSharp" />
      <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
